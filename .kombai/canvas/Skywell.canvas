t==='generating'?icon('loader-circle'):'▶'} ${state.report==='generating'?'Assembling evidence…':'Generate report'}</button><button class=\"btn\" data-action=\"toast\" data-message=\"PDF export queued securely\">${icon('download')} Export PDF</button><button class=\"btn\" data-action=\"toast\" data-message=\"Secure-share confirmation opened for MP-2026-014\">${icon('share-2')} Share securely</button><div class=\"security-cue\">${icon('shield-check')} Evidence protected · authorized access. Potential detections are included for review; only operator-verified matches are represented as verified evidence.</div></div></aside></div>`}\nfunction network(){return header('Operations / camera network','Camera network','Monitor camera coverage, source availability, and the route context for the active investigation.',`<button class=\"btn\" data-view=\"live\">${icon('video')} Live cameras</button>`)+`<div class=\"network-grid\"><div class=\"panel network-map\"><div class=\"panel-header\"><div><div class=\"panel-title\">Transit perimeter coverage</div><div class=\"panel-kicker\">128 online · 4 unavailable · 12 case-linked cameras</div></div><button class=\"btn btn-quiet btn-sm\" data-action=\"toast\" data-message=\"Camera coverage refreshed\">${icon('refresh-cw')} Refresh</button></div><div class=\"map-surface\"><span class=\"map-label bus\">Central bus station</span><span class=\"map-label parking\">Parking area</span><span class=\"map-label gate\">Main gate</span><span class=\"map-label market\">Market road</span><svg class=\"map-route\" viewBox=\"0 0 900 340\" preserveAspectRatio=\"none\"><path d=\"M100 215 C210 184 273 245 377 150 S542 102 626 185 S744 220 835 120\" fill=\"none\" stroke=\"#36b8d9\" stroke-width=\"2\" stroke-dasharray=\"5 5\"/><circle cx=\"100\" cy=\"215\" r=\"5\" fill=\"#58b783\"/><circle cx=\"377\" cy=\"150\" r=\"5\" fill=\"#d5a64a\"/><circle cx=\"626\" cy=\"185\" r=\"5\" fill=\"#58b783\"/><circle cx=\"835\" cy=\"120\" r=\"5\" fill=\"#d5a64a\"/></svg><butt