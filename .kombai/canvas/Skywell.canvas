px;font-size:10px}.report-meta{display:flex;align-items:flex-start;gap:20px}.report-meta span{display:block;color:var(--subtle);font-size:9px}.report-meta strong{display:block;margin-top:3px;color:var(--text);font-family:var(--mono);font-size:10px}.report-section{padding:16px 0;border-bottom:1px solid var(--border-soft)}.report-section h3{font-size:12px}.report-section p{margin-top:6px;font-size:10px;line-height:1.55}.route-mini{position:relative;height:120px;margin-top:11px;overflow:hidden;border:1px solid var(--border-soft);border-radius:8px;background:var(--surface-3)}.route-mini svg{position:absolute;inset:0;width:100%;height:100%}.report-table{width:100%;margin-top:10px;border-collapse:collapse}.report-table th,.report-table td{padding:7px 6px;border-top:1px solid var(--border-soft);text-align:left;font-size:9px}.report-table th{color:var(--subtle);font-weight:500;text-transform:uppercase;letter-spacing:.06em}.report-actions{padding:15px}.report-actions h3{font-size:12px}.report-actions p{margin-top:4px;font-size:10px}.report-action-list{display:flex;flex-direction:column;gap:7px;margin-top:17px}.report-action-list .btn{width:100%;justify-content:flex-start}.secure-note{display:flex;gap:8px;margin-top:17px;padding:10px;border:1px solid rgba(74,167,124,.3);border-radius:7px;background:var(--green-soft);color:#9bd6b2;font-size:9px}.secure-note .ti{font-size:14px}.report-progress{margin-top:15px;padding:11px;border:1px solid var(--border-soft);border-radius:7px;background:var(--surface-3);color:var(--muted);font-size:10px}\n.network-layout{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:16px}.network-map .map-field{min-height:545px}.network-list{padding:14px}.network-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 0;border-bottom:1px solid var(--border-soft)}.network-row strong{display:block;font-family:var(--mono);font-size:10px}.network-row span{display:block;margin-top:3px;color:var(--muted);font-size:10px}.network-state{font-size:9px;color:var(--green)}.network-state.offline{color:var(--red)}.settings-layout{display:grid;grid-template-columns:220px minmax(0,680px);gap:16px}.settings-nav{padding:8px}.settings-nav button{display:block;width:100%;padding:10px;border:0;border-radius:7px;background:transparent;color:var(--muted);text-align:left;font-size:10px}.settings-nav button.active,.settings-nav button:hover{background:var(--cyan-soft);color:var(--text)}.settings-panel{padding:18px}.settings-panel h2{font-size:15px}.setting-row{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:15px 0;border-bottom:1px solid var(--border-soft)}.setting-row strong{display:block;font-size:11px}.setting-row p{margin-top:3px;font-size:10px}.toggle{width:34px;height:18px;padding:2px;border:0;border-radius:12px;background:var(--cyan)}.toggle i{display:block;width:14px;height:14px;margin-left:14px;border-radius:50%;background:#071116}\n.audit{position:fixed;right:24px;bottom:22px;z-index:50;display:flex;align-items:center;gap:9px;max-width:360px;padding:11px 13px;border:1px solid rgba(74,167,124,.4);border-radius:8px;background:#10251c;color:#b2e3c4;box-shadow:0 14px 30px rgba(0,0,0,.35);font-size:10px;opacity:0;transform:translateY(8px);pointer-events:none;transition:opacity 180ms ease,transform 180ms ease}.audit.show{opacity:1;transform:translateY(0)}.audit .ti{font-size:15px}.empty-state{display:grid;place-items:center;min-height:260px;padding:30px;color:var(--muted);text-align:center}.empty-state .ti{margin-bottom:10px;color:var(--subtle);font-size:27px}.empty-state strong{display:block;color:var(--text);font-size:13px}.empty-state p{margin-top:5px;font-size:10px}\n@media(max-width:1100px){.trace-app{grid-template-columns:205px minmax(0,1fr)}.trace-rail{padding-left:9px;padding-right:9px}.topbar{padding:0 20px}.main-content{padding:22px 20px 34px}.workspace-grid{grid-template-columns:220px minmax(0,1fr)}.workspace-grid .summary-panel{grid-column:1/-1}.dashboard-grid,.result-layout,.timeline-layout,.evidence-layout,.cases-layout,.network-layout,.alerts-layout,.report-layout,.create-layout{grid-template-columns:1fr}.alert-panel{display:block}.map-field{min-height:420px}.cases-map{order:-1}.settings-layout{grid-template-columns:1fr}}\n@media(max-width:760px){.trace-app{display:block}.trace-rail{position:relative;min-height:auto}.rail-nav{display:none}.trace-rail:focus-within .rail-nav{display:flex}.topbar{height:auto;min-height:60px;flex-wrap:wrap;padding:12px 16px}.global-search{width:100%;order:2}.top-actions{margin-left:auto}.top-time,.top-operator span{display:none}.case-strip{padding:0 16px;overflow:auto}.main-content{padding:18px 16px 30px}.readout{grid-template-columns:repeat(2,1fr)}.readout-item:nth-child(2){border-right:0}.readout-item:nth-child(-n+2){border-bottom:1px solid var(--border)}.page-header{flex-direction:column}.page-actions{flex-wrap:wrap}.workspace-grid{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr}.form-field.wide{grid-column:auto}.feed-grid{grid-template-columns:1fr}.case-row{grid-template-columns:58px minmax(0,1fr)}.match-count{grid-column:2;text-align:left}.case-ledger-head{display:none}.config-items{grid-template-columns:repeat(2,1fr)}}\n</style>\n<div class=\"trace-app\" data-kid=\"1\" id=\"traceApp\">\n    <aside class=\"trace-rail\" data-kid=\"1-1\">\n        <div class=\"brand\" data-kid=\"1-1-1\">\n            <div class=\"brand-mark\" data-kid=\"1-1-1-1\">\n                <i class=\"ti ti-radar\" data-kid=\"1-1-1-1-1\">\n                </i>\n            </div>\n            <div data-kid=\"1-1-1-2\">\n                <div class=\"brand-name\" data-kid=\"1-1-1-2-1\">\n                    TRACE\n                </div>\n                <span class=\"brand-sub\" data-kid=\"1-1-1-2-2\">\n                    Missing person intelligence\n                </span>\n            </div>\n        </div>\n        <div class=\"rail-label\" data-kid=\"1-1-2\">\n            Operations\n        </div>\n        <nav aria-label=\"Primary navigation\" class=\"rail-nav\" data-kid=\"1-1-3\">\n            <button class=\"is-active\" data-kid=\"1-1-3-1\" data-view=\"dashboard\" title=\"Command Center\">\n                <i class=\"ti ti-layout-dashboard\" data-kid=\"1-1-3-1-1\">\n                </i>\n                <span data-kid=\"1-1-3-1-2\">\n                    Dashboard\n                </span>\n            </button>\n            <button data-kid=\"1-1-3-2\" data-view=\"cases\" title=\"Missing Persons\">\n                <i class=\"ti ti-user-search\" data-kid=\"1-1-3-2-1\">\n                </i>\n                <span data-kid=\"1-1-3-2-2\">\n                    Missing Persons\n                </span>\n            </button>\n            <button data-kid=\"1-1-3-3\" data-view=\"cctv\" title=\"CCTV Search\">\n                <i class=\"ti ti-scan\" data-kid=\"1-1-3-3-1\">\n                </i>\n                <span data-kid=\"1-1-3-3-2\">\n                    CCTV Search\n                </span>\n            </button>\n            <button data-kid=\"1-1-3-4\" data-view=\"live\" title=\"Live Cameras\">\n                <i class=\"ti ti-camera\" data-kid=\"1-1-3-4-1\">\n                </i>\n                <span data-kid=\"1-1-3-4-2\">\n                    Live Cameras\n                </span>\n            </button>\n            <button data-kid=\"1-1-3-5\" data-view=\"timeline\" title=\"Movement Timeline\">\n                <i class=\"ti ti-route\" data-kid=\"1-1-3-5-1\">\n                </i>\n                <span data-kid=\"1-1-3-5-2\">\n                    Movement Timeline\n                </span>\n            </button>\n            <button data-kid=\"1-1-3-6\" data-view=\"alerts\" title=\"Alerts\">\n                <i class=\"ti ti-alert-triangle\" data-kid=\"1-1-3-6-1\">\n                </i>\n                <span data-kid=\"1-1-3-6-2\">\n                    Alerts\n                </span>\n                <span class=\"nav-badge\" data-kid=\"1-1-3-6-3\">\n                    06\n                </span>\n            </button>\n            <button data-kid=\"1-1-3-7\" data-view=\"cases\" title=\"Cases and Investigations\">\n                <i class=\"ti ti-briefcase-2\" data-kid=\"1-1-3-7-1\">\n                </i>\n                <span data-kid=\"1-1-3-7-2\">\n                    Cases & Investigations\n                </span>\n            </button>\n            <button data-kid=\"1-1-3-8\" data-view=\"reports\" title=\"Reports\">\n                <i class=\"ti ti-file-description\" data-kid=\"1-1-3-8-1\">\n                </i>\n                <span data-kid=\"1-1-3-8-2\">\n                    Reports\n                </span>\n            </button>\n            <button data-kid=\"1-1-3-9\" data-view=\"network\" title=\"Camera Network\">\n                <i class=\"ti ti-network\" data-kid=\"1-1-3-9-1\">\n                </i>\n                <span data-kid=\"1-1-3-9-2\">\n                    Camera Network\n                </span>\n            </button>\n            <button data-kid=\"1-1-3-10\" data-view=\"settings\" title=\"Settings\">\n                <i class=\"ti ti-settings\" data-kid=\"1-1-3-10-1\">\n                </i>\n                <span data-kid=\"1-1-3-10-2\">\n                    Settings\n                </span>\n            </button>\n        </nav>\n        <div class=\"rail-spacer\" data-kid=\"1-1-4\">\n        </div>\n        <div class=\"system-status\" data-kid=\"1-1-5\">\n            <span class=\"status-dot\" data-kid=\"1-1-5-1\">\n            </span>\n            <span data-kid=\"1-1-5-2\">\n                System operational\n            </span>\n        </div>\n        <div class=\"operator\" data-kid=\"1-1-6\">\n            <div class=\"avatar\" data-kid=\"1-1-6-1\">\n                OM\n            </div>\n            <div data-kid=\"1-1-6-2\">\n                <strong data-kid=\"1-1-6-2-1\">\n                    Olivia Martin\n                </strong>\n                <span data-kid=\"1-1-6-2-2\">\n                    Authorized operator\n                </span>\n            </div>\n        </div>\n    </aside>\n    <section class=\"trace-main\" data-kid=\"1-2\">\n        <header class=\"topbar\" data-kid=\"1-2-1\">\n            <label class=\"global-search\" data-kid=\"1-2-1-1\">\n                <i class=\"ti ti-search\" data-kid=\"1-2-1-1-1\">\n                </i>\n                <input aria-label=\"Global search\" data-kid=\"1-2-1-1-2\" placeholder=\"Search person, case or camera...\"/>\n            </label>\n            <div class=\"top-actions\" data-kid=\"1-2-1-2\">\n                <span class=\"top-time\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1\" data-name=\"topbar current date and time\" data-reason=\"text replaced every second by time display script\">\n                    Thu, 10 Sep 2026 · 14:34:16\n                </span>\n                <button aria-label=\"Notifications\" class=\"top-icon\" data-kid=\"1-2-1-2-2\" data-view=\"alerts\" title=\"Notifications\">\n                    <i class=\"ti ti-bell\" data-kid=\"1-2-1-2-2-1\">\n                    </i>\n                    <span class=\"badge-dot\" data-kid=\"1-2-1-2-2-2\">\n                    </span>\n                </button>\n                <div class=\"top-operator\" data-kid=\"1-2-1-2-3\">\n                    <div class=\"avatar\" data-kid=\"1-2-1-2-3-1\">\n                        OM\n                    </div>\n                    <span data-kid=\"1-2-1-2-3-2\">\n                        Olivia Martin\n                    </span>\n                </div>\n            </div>\n        </header>\n        <div class=\"case-strip\" data-dynamic=\"true\" data-kid=\"1-2-2\" data-name=\"case navigation strip\" data-reason=\"element visibility toggled by view navigation\" id=\"caseStrip\">\n            <span class=\"case-context\" data-kid=\"1-2-2-1\">\n                <b data-kid=\"1-2-2-1-1\">\n                    MP-2026-014\n                </b>\n                · Rahul Sharma\n            </span>\n            <div class=\"case-routes\" data-kid=\"1-2-2-2\">\n                <button data-kid=\"1-2-2-2-1\" data-view=\"cctv\">\n                    Workspace\n                </button>\n                <button data-kid=\"1-2-2-2-2\" data-view=\"results\">\n                    Potential matches\n                </button>\n                <button data-kid=\"1-2-2-2-3\" data-view=\"timeline\">\n                    Movement timeline\n                </button>\n                <button data-kid=\"1-2-2-2-4\" data-view=\"reports\">\n                    Report\n                </button>\n            </div>\n        </div>\n        <main class=\"main-content\" data-dynamic=\"true\" data-kid=\"1-2-3\" data-name=\"main page content container\" data-reason=\"children rendered or injected by script\" id=\"viewRoot\">\n        </main>\n    </section>\n    <div class=\"audit\" data-dynamic=\"true\" data-kid=\"1-3\" data-name=\"audit status toast\" data-reason=\"toast message content and visibility updated by script\" id=\"audit\" role=\"status\">\n        <i class=\"ti ti-shield-check\" data-kid=\"1-3-1\">\n        </i>\n        <span data-dynamic=\"true\" data-kid=\"1-3-2\" data-name=\"audit status message text\" data-reason=\"text updated by script upon system events\" id=\"auditText\">\n        </span>\n    </div>\n</div>\n<script>\n    (function(){\n  const assets={portrait:'https://images.pexels.com/photos/17009459/pexels-photo-17009459.jpeg?auto=compress&cs=tinysrgb&w=480&q=80',station:'https://images.pexels.com/photos/10640272/pexels-photo-10640272.jpeg?auto=compress&cs=tinysrgb&w=1000&q=80',gate:'https://images.pexels.com/photos/10365034/pexels-photo-10365034.jpeg?auto=compress&cs=tinysrgb&w=1000&q=80',aerial:'https://images.pexels.com/photos/19851674/pexels-photo-19851674.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80',highAngle:'https://images.pexels.com/photos/9512738/pexels-photo-9512738.jpeg?auto=compress&cs=tinysrgb&w=1000&q=80'};\n  const alt={portrait:'Fictional case portrait, Vika Glitter on Pexels',station:'Fictional CCTV station scene, El gringo photo on Pexels',gate:'Fictional black and white CCTV frame, Anastasia Latunova on Pexels',aerial:'Fictional aerial urban scene, Ahmet Kurt on Pexels',highAngle:'Fictional high-angle urban camera view, Mathias Reding on Pexels'};\n  const events=[\n    {id:'event1',time:'10:42:12',camera:'CAM-012',place:'North Entrance',score:87,img:'station'},\n    {id:'event2',time:'11:03:48',camera:'CAM-018',place:'Parking Area',score:92,img:'highAngle'},\n    {id:'event3',time:'11:17:04',camera:'CAM-034',place:'Main Gate',score:95,img:'gate'},\n    {id:'event4',time:'11:26:31',camera:'CAM-041',place:'Market Road',score:89,img:'station'}\n  ];\n  const state={view:'dashboard',selectedCamera:'CAM-034',selectedEvent:'event3',verified:new Set(),timeline:new Set(),step:1,searchRunning:false,searchComplete:false,progressIndex:-1};\n  const root=document.getElementById('viewRoot');\n  const cameraData={\n    'CAM-021':{place:'Parking Area',score:'81%',status:'Online',img:'highAngle'},\n    'CAM-034':{place:'Main Gate',score:'92%',status:'Active detection',img:'gate'},\n    'CAM-041':{place:'Market Road',score:'89%',status:'Active detection',img:'station'},\n    'CAM-052':{place:'South Exit',score:'—',status:'Offline',img:'highAngle'}\n  };\n  function icon(name){return '<i class=\"ti ti-'+name+'\"></i>'}\n  function img(key,cls){return '<img class=\"'+(cls||'')+'\" src=\"'+assets[key]+'\" alt=\"'+alt[key]+'\" loading=\"lazy\" decoding=\"async\">'}\n  function status(id){return state.verified.has(id)?'<span class=\"state verified\">Verified by operator</span>':'<span class=\"state review\">Requires verification</span>'}\n  function scoreClass(score){return score>=90?'high':score<75?'low':''}\n  function scoreBadge(score){return '<span class=\"confidence '+scoreClass(score)+'\"><i class=\"c-dot\"></i>'+score+'% probable match</span>'}\n  function showAudit(message){const el=document.getElementById('audit');document.getElementById('auditText').textContent=message;el.classList.add('show');clearTimeout(window.__traceAudit);window.__traceAudit=setTimeout(()=>el.classList.remove('show'),3200)}\n  function mapMarkup(opts){opts=opts||{};const selected=state.selectedCamera;const info=cameraData[selected]||cameraData['CAM-034'];return '<div class=\"map-field\" aria-label=\"Camera network map\"><img class=\"map-texture\" src=\"'+assets.aerial+'\" alt=\"'+alt.aerial+'\" loading=\"lazy\" decoding=\"async\"><div class=\"map-vignette\"></div><div class=\"map-grid\"></div><div class=\"road r1\"></div><div class=\"road r2\"></div><div class=\"road r3\"></div><div class=\"road r4\"></div><div class=\"road r5\"></div><div class=\"building b1\"><span>CENTRAL BUS STATION</span></div><div class=\"building b2\"><span>TRANSIT ANNEX</span></div><div class=\"building b3\"><span>COMMERCIAL BLOCK</span></div><div class=\"building b4\"><span>MARKET ROAD</span></div><div class=\"building b5\"><span>SOUTH CAMPUS</span></div><div class=\"building b6\"><span>MAIN GATE</span></div><span class=\"map-zone zone-bus\">Central Bus Station</span><span class=\"map-zone zone-park\">Parking Area</span><span class=\"map-zone zone-market\">Market Road</span><span class=\"map-zone zone-south\">South Exit</span><svg class=\"map-route\" viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\" aria-hidden=\"true\"><polyline class=\"route-line\" points=\"23,34 49,43 22,72 78,77\"></polyline><circle class=\"route-point\" cx=\"23\" cy=\"34\" r=\"1.5\"></circle><circle class=\"route-point\" cx=\"49\" cy=\"43\" r=\"1.8\"></circle><circle class=\"route-point verified\" cx=\"22\" cy=\"72\" r=\"1.8\"></circle><circle class=\"route-point\" cx=\"78\" cy=\"77\" r=\"1.5\"></circle></svg><button class=\"camera-node node-021 '+(selected==='CAM-021'?'selected':'')+'\" data-camera=\"CAM-021\" title=\"CAM-021 · Parking Area · Online\"><span>CAM-021</span><i class=\"node-dot\"></i></button><button class=\"camera-node node-034 match '+(selected==='CAM-034'?'selected':'')+'\" data-camera=\"CAM-034\" title=\"CAM-034 · Main Gate · 92% probable match\"><span>CAM-034</span><i class=\"node-dot\"></i></button><button class=\"camera-node node-041 '+(selected==='CAM-041'?'selected':'')+'\" data-camera=\"CAM-041\" title=\"CAM-041 · Market Road · Active detection\"><span>CAM-041</span><i class=\"node-dot\"></i></button><button class=\"camera-node node-052 offline '+(selected==='CAM-052'?'selected':'')+'\" data-camera=\"CAM-052\" title=\"CAM-052 · South Exit · Offline\"><span>CAM-052</span><i class=\"node-dot\"></i></button><div class=\"map-legend\"><span class=\"legend-item\"><i></i>Camera</span><span class=\"legend-item\"><i class=\"green\"></i>Verified</span><span class=\"legend-item\"><i class=\"gray\"></i>Offline</span></div>'+(opts.inspector?'<div class=\"map-inspector\"><div class=\"inspector-top\">'+img(info.img,'')+'<div class=\"inspector-copy\"><strong>'+selected+' · '+info.place+'</strong><span>'+info.status+'</span><div class=\"inspector-score\">'+info.score+' <small>similarity estimate</small></div></div></div><div class=\"inspector-actions\"><button class=\"btn btn-primary\" data-action=\"open-evidence\" title=\"Open camera evidence\">'+icon('player-play')+' Open footage</button><button class=\"btn\" data-action=\"open-case\" title=\"Open investigation workspace\">Open case</button></div></div>':'')+'</div>'}\n  function readout(){return '<div class=\"readout\"><div class=\"readout-item is-cyan\"><div class=\"readout-label\">Active cases</div><div class=\"readout-value\">12 <small>open</small></div></div><div class=\"readout-item\"><div class=\"readout-label\">AI matches today</div><div class=\"readout-value\">47 <small>potential</small></div></div><div class=\"readout-item is-green\"><div class=\"readout-label\">Cameras online</div><div class=\"readout-value\">128 <small>/ 132</small></div></div><div class=\"readout-item is-alert\"><div class=\"readout-label\">Active alerts</div><div class=\"readout-value\">06 <small>unresolved</small></div></div></div>'}\n  function alertCard(kind,copy,meta,time,cls){return '<div class=\"alert-card '+(cls||'')+'\" data-view=\"alerts\"><div class=\"alert-row\"><span class=\"alert-kind\"><i class=\"severity\"></i>'+kind+'</span><span class=\"alert-time\">'+time+'</span></div><div class=\"alert-copy\">'+copy+'</div><div class=\"alert-meta\"><span>'+meta[0]+'</span><span>'+meta[1]+'</span></div></div>'}\n  function dashboard(){return '<div class=\"page-header\"><div><div class=\"eyebrow\">Command center · Thursday 10 September 2026</div><h1>Good afternoon, Operator</h1><p>Monitor active investigations and recent AI detections.</p></div><div class=\"page-actions\"><button class=\"btn\" data-view=\"live\">'+icon('camera')+' Live cameras</button><button class=\"btn btn-primary\" data-view=\"cases\">'+icon('plus')+' New missing person</button></div></div>'+readout()+'<div class=\"dashboard-grid\"><section class=\"surface map-panel\"><div class=\"map-panel-head\"><div><strong>Camera network · Potential route</strong><span style=\"display:block;margin-top:3px\">CAM-034 selected · Main Gate · case MP-2026-014</span></div><button class=\"btn btn-quiet\" data-view=\"network\">'+icon('map-2')+' Full network</button></div>'+mapMarkup({inspector:true})+'</section><aside class=\"surface alert-panel\"><div class=\"section-title\"><h2>Priority alerts</h2><a data-view=\"alerts\">View all 06</a></div><div class=\"alert-list\">'+alertCard('HIGH CONFIDENCE MATCH','92% similarity estimate · MP-2026-014 · CAM-034 · Main Gate',['MP-2026-014','Review now'],'14:32:08','is-high')+alertCard('MEDIUM CONFIDENCE MATCH','81% similarity estimate · MP-2026-011 · CAM-021 · Parking Area',['MP-2026-011','Requires review'],'13:18:44','is-medium')+alertCard('CAMERA OFFLINE','CAM-087 unavailable · last active 11 minutes ago',['CAM-087','Camera Network'],'14:23:19','is-offline')+alertCard('INVESTIGATION UPDATE','Rahul Sharma route has 4 probable detections',['MP-2026-014','4 events'],'14:17:04','is-medium')+'</div></aside></div><section class=\"surface recent-panel\"><div class=\"section-title\"><h2>Recent AI detections</h2><a data-view=\"results\">Review potential matches →</a></div><table class=\"evidence-table\"><thead><tr><th>Frame</th><th>Confidence</th><th>Camera / location</th><th>Timestamp</th><th>Review state</th><th></th></tr></thead><tbody><tr data-action=\"open-evidence\"><td><div class=\"evidence-thumb\">'+img('gate')+'</div></td><td>'+scoreBadge(95)+'</td><td><span class=\"mono\">CAM-034</span><br><span>Main Gate</span></td><td class=\"mono\">10 Sep 2026 · 14:32:08</td><td>'+status('event3')+'</td><td>'+icon('chevron-right')+'</td></tr><tr data-action=\"open-evidence\"><td><div class=\"evidence-thumb\">'+img('highAngle')+'</div></td><td>'+scoreBadge(92)+'</td><td><span class=\"mono\">CAM-018</span><br><span>Parking Area</span></td><td class=\"mono\">10 Sep 2026 · 11:03:48</td><td>'+status('event2')+'</td><td>'+icon('chevron-right')+'</td></tr><tr data-action=\"open-evidence\"><td><div class=\"evidence-thumb\">'+img('station')+'</div></td><td>'+scoreBadge(87)+'</td><td><span class=\"mono\">CAM-012</span><br><span>North Entrance</span></td><td class=\"mono\">10 Sep 2026 · 10:42:12</td><td>'+status('event1')+'</td><td>'+icon('chevron-right')+'</td></tr></tbody></table></section></div>'}\n  function cases(){return '<div class=\"page-header\"><div><div class=\"eyebrow\">Operations · Case ledger</div><h1>Missing persons</h1><p>Manage active cases and search CCTV footage for probable sightings.</p></div><button class=\"btn btn-primary\" data-view=\"create\">'+icon('plus')+' New missing person</button></div><div class=\"toolbar\"><label class=\"input-wrap\">'+icon('search')+'<input placeholder=\"Search by name, case ID, location...\" aria-label=\"Search cases\"></label><select class=\"filter-select\" aria-label=\"Status filter\"><option>Status · All</option><option>Investigation active</option></select><select class=\"filter-select\" aria-label=\"Priority filter\"><option>Priority · All</option><option>High</option></select><select class=\"filter-select\" aria-label=\"Gender filter\"><option>Gender · All</option></select><select class=\"filter-select\" aria-label=\"Age filter\"><option>Age · All</option></select></div><div class=\"cases-layout\"><section class=\"surface case-ledger\"><div class=\"case-ledger-head\"><span>Active case records</span><span style=\"text-align:right\">Matches</span></div><div class=\"case-row is-selected\" data-action=\"open-case\"><div class=\"case-photo\">'+img('portrait')+'</div><div><div class=\"case-name\">Rahul Sharma <span class=\"case-id\">MP-2026-014</span></div><div class=\"case-age\">17 years · Male</div><div class=\"case-last\"><b>Last seen</b> · Central Bus Station<br><b>Missing since</b> · 10 Sep 2026</div><div class=\"case-flags\"><span class=\"tag high\">HIGH PRIORITY</span><span class=\"tag active\">INVESTIGATION ACTIVE</span></div></div><div class=\"match-count\"><strong>7</strong><span>matches</span></div></div><div class=\"case-row\"><div class=\"case-photo\">'+img('portrait')+'</div><div><div class=\"case-name\">Anika Patel <span class=\"case-id\">MP-2026-011</span></div><div class=\"case-age\">28 years · Female</div><div class=\"case-last\"><b>Last seen</b> · East Parking Area<br><b>Missing since</b> · 08 Sep 2026</div><div class=\"case-flags\"><span class=\"tag\">MEDIUM</span><span class=\"tag active\">SEARCHING</span></div></div><div class=\"match-count\"><strong>12</strong><span>matches</span></div></div><div class=\"case-row\"><div class=\"case-photo\">'+img('portrait')+'</div><div><div class=\"case-name\">Maya Collins <span class=\"case-id\">MP-2026-008</span></div><div class=\"case-age\">42 years · Female</div><div class=\"case-last\"><b>Last seen</b> · South Exit<br><b>Missing since</b> · 02 Sep 2026</div><div class=\"case-flags\"><span class=\"tag\">LOW</span><span class=\"tag\">REVIEW QUEUED</span></div></div><div class=\"match-count\"><strong>3</strong><span>matches</span></div></div></section><section class=\"surface cases-map\"><div class=\"map-panel-head\"><div><strong>Last-known locations</strong><span style=\"display:block;margin-top:3px\">3 active case locations</span></div><button class=\"btn btn-quiet\">'+icon('layers')+' Filters</button></div><div class=\"map-field\">'+mapMarkup({}).replace('<div class=\"map-field\"','<div style=\"display:contents\"').replace('</div>','</div>')+'<div class=\"case-map-note\"><b>MP-2026-014</b><br>Central Bus Station · selected</div></div></section></div></div>'}\n  function create(){const steps=['Person details','Last known information','Search configuration','Review case'];const content=state.step===1?'<div class=\"form-grid\"><div class=\"dropzone\" style=\"grid-column:1/-1\">'+icon('cloud-upload')+'<strong>Upload clear face photograph</strong><span>Front-facing photo preferred · JPG or PNG</span><button class=\"btn\" style=\"margin-top:10px\">Choose file</button></div><div class=\"form-field\"><label>Full name</label><input class=\"form-control\" value=\"Rahul Sharma\"></div><div class=\"form-field\"><label>Age</label><input class=\"form-control\" value=\"17\"></div><div class=\"form-field\"><label>Gender</label><select class=\"form-control\"><option>Male</option></select></div><div class=\"form-field\"><label>Height</label><input class=\"form-control\" value=\"171 cm\"></div><div class=\"form-field wide\"><label>Clothing</label><input class=\"form-control\" value=\"Blue overshirt, dark trousers, white sneakers\"></div><div class=\"form-field wide\"><label>Distinguishing features</label><textarea class=\"form-control\">Small birthmark below right eye. Black hair, slim build.</textarea></div></div>':state.step===2?'<div class=\"form-grid\"><div class=\"form-field\"><label>Last seen location</label><input class=\"form-control\" value=\"Central Bus Station\"></div><div class=\"form-field\"><label>Date</label><input class=\"form-control\" value=\"10 Sep 2026\"></div><div class=\"form-field\"><label>Time</label><input class=\"form-control\" value=\"10:35:00\"></div><div class=\"form-field\"><label>Known routes</label><input class=\"form-control\" value=\"North Entrance → Main Gate\"></div><div class=\"form-field wide\"><label>Interactive map</label><div class=\"surface-recessed\" style=\"overflow:hidden\">'+mapMarkup({})+'</div></div><div class=\"form-field wide\"><label>Description</label><textarea class=\"form-control\">Last seen leaving the central station concourse toward the north entrance.</textarea></div><div class=\"form-field wide\"><label>Additional information</label><textarea class=\"form-control\" placeholder=\"Optional notes for investigators\"></textarea></div></div>':state.step===3?'<div class=\"form-grid\"><div class=\"form-field\"><label>Search date range</label><input class=\"form-control\" value=\"10 Sep 2026 — 10 Sep 2026\"></div><div class=\"form-field\"><label>Search time range</label><input class=\"form-control\" value=\"10:00 — 16:00\"></div><div class=\"form-field wide\"><label>Camera zones</label><div class=\"toolbar\" style=\"margin:0\"><span class=\"tag active\">Transit campus</span><span class=\"tag active\">Main Gate</span><span class=\"tag active\">Market Road</span></div></div><div class=\"form-field wide\"><label>Camera groups</label><div class=\"toolbar\" style=\"margin:0\"><span class=\"tag active\">All campus cameras · 128 online</span><span class=\"tag\">4 unavailable</span></div></div><div class=\"form-field wide\"><label style=\"display:flex;align-items:center;gap:8px\"><input type=\"checkbox\" checked> Search all available cameras</label><p style=\"font-size:10px\">The search will include 128 operational cameras within the selected coverage window.</p></div><div class=\"form-field\"><label>Minimum AI confidence</label><input class=\"form-control\" value=\"75%\"></div></div>':'<div class=\"surface-recessed\" style=\"padding:15px\"><div class=\"section-title\"><h2>Review case</h2><span>Ready to create</span></div><div class=\"detail-grid\"><div><span>Person</span><strong>Rahul Sharma · 17 years</strong></div><div><span>Case ID</span><strong>MP-2026-014</strong></div><div><span>Last known location</span><strong>Central Bus Station</strong></div><div><span>Missing since</span><strong>10 Sep 2026 · 10:35</strong></div><div><span>Search coverage</span><strong>128 cameras · 10:00–16:00</strong></div><div><span>Threshold</span><strong>75% minimum similarity</strong></div></div><div class=\"route-mini\">'+mapMarkup({})+'</div><p style=\"margin-top:12px;font-size:10px\">AI similarity estimates prioritize footage for operator review. They are not identity confirmation.</p></div>';return '<div class=\"page-header\"><div><div class=\"eyebrow\">Cases &amp; investigations</div><h1>Create missing person case</h1><p>Build a defensible case record before starting a CCTV search.</p></div><button class=\"btn btn-quiet\" data-view=\"cases\">'+icon('x')+' Cancel</button></div><div class=\"stepper\">'+steps.map((s,i)=>'<div class=\"step '+(state.step===i+1?'is-active':'')+'\"><span class=\"step-number\">0'+(i+1)+(state.step>i+1?' · Complete':'')+'</span>'+s+'</div>').join('')+'</div><div class=\"create-layout\"><section class=\"surface form-panel\">'+content+'<div class=\"form-actions\">'+(state.step>1?'<button class=\"btn\" data-action=\"prev-step\">'+icon('arrow-left')+' Back</button>':'<span></span>')+(state.step<4?'<button class=\"btn btn-primary\" data-action=\"next-step\">Continue '+icon('arrow-right')+'</button>':'<button class=\"btn btn-primary\" data-action=\"create-case\">'+icon('scan')+' Create case &amp; start CCTV search</button>')+'</div></section><aside class=\"surface draft-panel\"><h3>Case draft</h3><p>MP-2026-014 · Rahul Sharma</p><div class=\"draft-list\"><div class=\"draft-item\">'+icon('check')+' Person details complete</div><div class=\"draft-item '+(state.step<2?'pending':'')+'\">'+icon(state.step<2?'clock':'check')+' Last-known information</div><div class=\"draft-item '+(state.step<3?'pending':'')+'\">'+icon(state.step<3?'clock':'check')+' Search configuration</div><div class=\"draft-item '+(state.step<4?'pending':'')+'\">'+icon(state.step<4?'clock':'check')+' Review and create</div></div><div class=\"secure-note\" style=\"margin-top:20px\">'+icon('shield-lock')+' <span>Evidence protected · authorized access</span></div></aside></div></div>'}\n  function cctv(){const progress=['Analyzing CCTV footage…','Searching 128 cameras…','Comparing detected appearances…','Building potential sightings…'];return '<div class=\"page-header\"><div><div class=\"eyebrow\">Cases &amp; investigations / MP-2026-014</div><h1>Missing person investigation</h1><p>Turn Rahul Sharma’s last-known location into a reviewable camera route.</p></div><div class=\"page-actions\"><button class=\"btn\" data-view=\"results\">'+icon('list-search')+' Potential matches</button><button class=\"btn btn-primary\" data-action=\"run-search\" '+(state.searchRunning?'disabled':'')+'>'+icon(state.searchRunning?'loader-2':'scan')+' '+(state.searchRunning?'Searching…':'Run CCTV search')+'</button></div></div><div class=\"workspace-grid\"><aside class=\"surface person-drawer\"><div class=\"person-hero\">'+img('portrait')+'<h2>Rahul Sharma</h2><p>MP-2026-014 · 17 years</p><div class=\"status-line\"><i class=\"status-dot\"></i> Active investigation</div></div><div class=\"detail-list\"><div class=\"detail-item\"><span>Missing since</span><strong>10 September 2026</strong></div><div class=\"detail-item\"><span>Last known location</span><strong>Central Bus Station</strong></div><div class=\"detail-item\"><span>Clothing</span><strong>Blue overshirt, dark trousers, white sneakers</strong></div><div class=\"detail-item\"><span>Height</span><strong>171 cm</strong></div><div class=\"detail-item\"><span>Distinguishing features</span><strong>Birthmark below right eye</strong></div></div></aside><section class=\"surface search-panel\"><div class=\"section-title\"><h2>AI CCTV search</h2><span>Map coverage</span></div><div class=\"search-config\"><div class=\"search-config-photo\">'+img('portrait')+'</div><div class=\"config-items\"><div class=\"config-item\"><span>Reference photo</span><strong>rahul_sharma.jpg</strong></div><div class=\"config-item\"><span>Date coverage</span><strong>10 Sep 2026</strong></div><div class=\"config-item\"><span>Camera coverage</span><strong>128 cameras</strong></div><div class=\"config-item\"><span>Time window</span><strong>10:00–16:00</strong></div><div class=\"config-item\"><span>Minimum confidence</span><strong>75%</strong></div><div class=\"config-item\"><span>Source state</span><strong>Protected footage</strong></div></div></div><div class=\"search-status\"><div><strong>'+(!state.searchRunning&&!state.searchComplete?'Ready to search selected coverage':state.searchComplete?'47 potential sightings found':'Search in progress')+'</strong><p>'+(!state.searchRunning&&!state.searchComplete?'AI similarity estimates require operator verification.':state.searchComplete?'47 relevant frames found across 12 cameras.':'TRACE is checking camera coverage and building probable appearances.')+'</p></div>'+(!state.searchRunning&&!state.searchComplete?'<span class=\"state review\">Reviewable evidence</span>':state.searchComplete?'<span class=\"state verified\">Search complete</span>':'<span class=\"state\">Processing</span>')+'</div>'+(state.searchRunning?'<div class=\"search-progress\">'+progress.map((p,i)=>'<div class=\"progress-line '+(i<=state.progressIndex?'done':'')+'\">'+icon(i<=state.progressIndex?'check':'loader-2')+' '+p+'</div>').join('')+'</div>':'')+(state.searchComplete?'<div class=\"result-inline\"><div><strong>47 potential sightings found</strong><span>12 cameras · 10:42–14:32 · 8 high-confidence review items</span></div><button class=\"btn btn-primary\" data-view=\"results\">Review potential matches '+icon('arrow-up-right')+'</button></div>':'')+'<div class=\"coverage-map\"><div class=\"section-title\"><h2>Camera coverage map</h2><span>Selected zones · 4 cameras unavailable</span></div>'+mapMarkup({})+'</div></section><aside class=\"surface summary-panel\"><div class=\"section-title\"><h2>Investigation summary</h2><span>MP-2026-014</span></div><div class=\"summary-list\"><div class=\"summary-row\"><span>Total matches</span><strong>47</strong></div><div class=\"summary-row\"><span>High confidence</span><strong class=\"green\">8</strong></div><div class=\"summary-row\"><span>Medium confidence</span><strong class=\"amber\">21</strong></div><div class=\"summary-row\"><span>Low confidence</span><strong>18</strong></div><div class=\"summary-row\"><span>Cameras involved</span><strong>12</strong></div><div class=\"summary-row\"><span>First seen</span><strong>10:42 AM</strong></div><div class=\"summary-row\"><span>Last seen</span><strong>2:17 PM</strong></div></div><div class=\"next-review\"><span>Next review</span><strong>95% probable match</strong><p>CAM-034 · Main Gate · 14:32:08</p><button class=\"btn btn-quiet\" style=\"padding-left:0;margin-top:5px\" data-view=\"evidence\">Open source footage '+icon('arrow-up-right')+'</button></div></aside></div></div>'}\n  function results(){return '<div class=\"page-header\"><div><div class=\"eyebrow\">MP-2026-014 / Search results</div><h1>47 potential matches</h1><p>AI similarity estimates require operator verification. Review order does not indicate identity certainty.</p></div><div class=\"page-actions\"><span class=\"state review\">Requires verification</span><button class=\"btn\" data-view=\"timeline\">'+icon('route')+' Open movement timeline</button></div></div><div class=\"toolbar\"><select class=\"filter-select\"><option>Confidence · All bands</option><option>High · 90–100%</option></select><select class=\"filter-select\"><option>Camera · All</option><option>CAM-034 · Main Gate</option></select><select class=\"filter-select\"><option>Location · All</option></select><select class=\"filter-select\"><option>Time · 10:00–16:00</option></select><select class=\"filter-select\"><option>Date · 10 Sep 2026</option></select><span class=\"legend-note\">'+icon('info-circle')+' <b>High 90–100%</b> · Medium 75–89% · Low &lt;75%</span></div><div class=\"result-layout\"><section class=\"surface result-map-panel\"><div class=\"map-panel-head\"><div><strong>Potential route map</strong><span style=\"display:block;margin-top:3px\">Select a camera node to filter the evidence dock.</span></div><span class=\"mono\">12 cameras · 47 frames</span></div>'+mapMarkup({inspector:true})+'</section><aside class=\"surface result-dock\"><div class=\"dock-head\"><h2>Chronological evidence dock</h2><span>3 of 47 shown</span></div>'+resultCard('event3',95,'gate')+resultCard('event2',92,'highAngle')+resultCard('event1',87,'station')+'</aside></div></div>'}\n  function resultCard(id,score,key){const ev=events.find(e=>e.id===id);return '<div class=\"result-card\"><div class=\"result-card-media\">'+img(key)+'<span class=\"bbox\"></span></div><div class=\"result-card-title\"><strong>'+scoreBadge(score)+'</strong>'+status(id)+'</div><div class=\"result-meta\"><span class=\"mono\">'+ev.camera+'</span><span>'+ev.place+'</span><span class=\"mono\">10 Sep 2026 · '+ev.time+'</span></div><div class=\"result-actions\"><button class=\"btn btn-primary\" data-action=\"open-evidence\" data-event-id=\"'+id+'\">View evidence</button><button class=\"btn\" data-action=\"add-timeline\" data-event-id=\"'+id+'\">Add to timeline</button><button class=\"btn btn-quiet\" data-action=\"verify\" data-event-id=\"'+id+'\">'+icon('check')+' Verify</button><button class=\"btn btn-quiet\" data-action=\"reject\" data-event-id=\"'+id+'\">Reject</button></div></div>'}\n  function timeline(){return '<div class=\"page-header\"><div><div class=\"eyebrow\">MP-2026-014 / Route reconstruction</div><h1>Person movement timeline</h1><p>Reconstructed from probable CCTV detections. Route segments remain reviewable hypotheses.</p></div><div class=\"page-actions\"><span class=\"state verified\">'+state.timeline.size+' events on timeline</span><button class=\"btn\" data-view=\"results\">'+icon('list-search')+' Potential matches</button></div></div><div class=\"timeline-layout\"><section class=\"surface timeline-map\"><div class=\"map-panel-head\"><div><strong>Potential route · Central Bus Station → Market Road</strong><span style=\"display:block;margin-top:3px\">Camera handoff path for MP-2026-014</span></div><span class=\"mono\">10:42:12 — 11:26:31</span></div>'+mapMarkup({})+'</section><section class=\"surface route-ladder\"><div class=\"section-title\"><h2>Route ladder</h2><span>4 probable detections</span></div><div class=\"ladder-list\">'+events.map((ev,i)=>'<article class=\"ladder-event '+(state.selectedEvent===ev.id?'selected ':'')+(state.verified.has(ev.id)?'verified':'')+'\" data-event-select=\"'+ev.id+'\"><div class=\"ladder-time\">'+ev.time+'</div><div><div class=\"ladder-camera\">'+ev.camera+'</div><div class=\"ladder-place\">'+ev.place+'</div></div><div><div>'+scoreBadge(ev.score)+'</div><div class=\"ladder-foot\"><div class=\"ladder-thumb\">'+img(ev.img)+'</div>'+status(ev.id)+'</div><div class=\"ladder-actions\"><button class=\"btn\" data-action=\"open-evidence\" data-event-id=\"'+ev.id+'\">Open footage</button><button class=\"btn '+(state.verified.has(ev.id)?'btn-success':'')+'\" data-action=\"verify\" data-event-id=\"'+ev.id+'\">'+icon('check')+' '+(state.verified.has(ev.id)?'Verified':'Verify match')+'</button><button class=\"btn btn-quiet\" data-action=\"note\" data-event-id=\"'+ev.id+'\">'+icon('note')+' Add note</button></div></div></article>').join('')+'</div></section></div></div>'}\n  function evidence(){const ev=events.find(e=>e.id===state.selectedEvent)||events[2];return '<div class=\"page-header\"><div><div class=\"eyebrow\">Cases &amp; investigations / MP-2026-014 / '+ev.camera+'</div><h1>Camera evidence viewer</h1><p>Inspect source footage and make a human verification decision.</p></div><div class=\"page-actions\"><button class=\"btn\" data-view=\"results\">'+icon('arrow-left')+' Back to potential matches</button><span class=\"state review\">'+(state.verified.has(ev.id)?'Verified by operator':'Requires verification')+'</span></div></div><div class=\"evidence-layout\"><section class=\"surface video-panel\"><div class=\"video-frame\">'+img(ev.img)+'<span class=\"bbox\"></span><div class=\"video-overlay\"><span>'+ev.camera+' · '+ev.place+'</span><span>10 SEP 2026 · '+ev.time+' · CH 04</span></div><div class=\"play-center\"><button title=\"Play source footage\" aria-label=\"Play source footage\">'+icon('player-play-filled')+'</button></div></div><div class=\"transport\"><button class=\"btn icon-btn\" title=\"Previous frame\">'+icon('player-skip-back')+'</button><button class=\"btn icon-btn\" title=\"Play\">'+icon('player-play')+'</button><button class=\"btn icon-btn\" title=\"Next frame\">'+icon('player-skip-forward')+'</button><span class=\"mono\">14:32:08</span><div class=\"scrub\"></div><span class=\"mono\">00:19 / 01:42</span><button class=\"btn icon-btn\" title=\"Playback speed\">1×</button><button class=\"btn icon-btn\" title=\"Snapshot\">'+icon('camera')+'</button><button class=\"btn icon-btn\" title=\"Download evidence\">'+icon('download')+'</button><button class=\"btn icon-btn\" title=\"Add bookmark\">'+icon('bookmark')+'</button></div><div class=\"frame-ribbon\"><div class=\"ribbon-frame\"><img src=\"'+assets.gate+'\" alt=\"'+alt.gate+'\" loading=\"lazy\" decoding=\"async\"><span>14:31:52 · previous</span></div><div class=\"ribbon-frame current\">'+img('gate')+'<span>14:32:08 · current</span></div><div class=\"ribbon-frame\"><img src=\"'+assets.gate+'\" alt=\"'+alt.gate+'\" loading=\"lazy\" decoding=\"async\"><span>14:32:21 · next</span></div><div class=\"ribbon-frame\"><img src=\"'+assets.station+'\" alt=\"'+alt.station+'\" loading=\"lazy\" decoding=\"async\"><span>CAM-035 · 14:33:01</span></div><div class=\"ribbon-frame\"><img src=\"'+assets.highAngle+'\" alt=\"'+alt.highAngle+'\" loading=\"lazy\" decoding=\"async\"><span>CAM-041 · 14:36:17</span></div></div></section><aside class=\"surface evidence-inspector\"><div class=\"section-title\"><h2>Detection information</h2><span class=\"mono\">'+ev.camera+'</span></div><div class=\"evidence-person\">'+img('portrait')+'<div><strong>Person detected</strong><p>Rahul Sharma · case MP-2026-014</p><div class=\"evidence-score\">'+ev.score+'% <small>matching confidence</small></div></div></div><div class=\"detail-list\"><div class=\"detail-item\"><span>Camera</span><strong>'+ev.camera+' · '+ev.place+'</strong></div><div class=\"detail-item\"><span>Timestamp</span><strong>10 September 2026 · '+ev.time+'</strong></div><div class=\"detail-item\"><span>Location</span><strong>'+ev.place+', Transit campus</strong></div><div class=\"detail-item\"><span>Evidence state</span><strong>'+status(ev.id)+'</strong></div></div><div class=\"nearby\"><h3>Nearby camera events</h3><div class=\"nearby-event\"><strong>CAM-035</strong><span>14:33:01 · 1 min later</span></div><div class=\"nearby-event\"><strong>CAM-041</strong><span>14:36:17 · 4 min later</span></div><div class=\"nearby-event\"><strong>CAM-052</strong><span>14:41:04 · 9 min later</span></div></div><div class=\"decision\"><p>Verification is an operator decision. AI similarity is not identity confirmation.</p><button class=\"btn btn-success\" data-action=\"verify\" data-event-id=\"'+ev.id+'\">'+icon('check')+' Verify match</button><button class=\"btn btn-danger\" data-action=\"reject\" data-event-id=\"'+ev.id+'\">'+icon('x')+' Reject match</button><button class=\"btn\" data-action=\"note\" data-event-id=\"'+ev.id+'\">'+icon('note')+' Add note</button></div></aside></div></div>'}\n  function live(){return '<div class=\"page-header\"><div><div class=\"eyebrow\">Operations · Camera network</div><h1>Live cameras</h1><p>Monitor source feeds and open an investigation without losing camera context.</p></div><div class=\"page-actions\"><button class=\"btn\" data-view=\"network\">'+icon('map-2')+' Camera map</button><button class=\"btn\">'+icon('layout-grid')+' 2 × 2</button></div></div><div class=\"surface camera-summary\"><div><strong>128 / 132</strong><span>Cameras online</span></div><div><strong style=\"color:var(--green)\">04</strong><span>Active detections</span></div><div><strong style=\"color:var(--red)\">04</strong><span>Unavailable</span></div><span class=\"status-dot\"></span><span>Live network status · updated 14:34:16</span></div><div class=\"feed-grid\"><div class=\"feed-card\"><div class=\"feed-media\">'+img('station')+'<div class=\"feed-overlay\"><span>CAM-034 · Main Gate</span><span class=\"live-badge\"><i></i>LIVE · 14:34:16</span></div></div><div class=\"feed-footer\"><div><strong>CAM-034</strong><span>High-confidence review queue</span></div><div class=\"feed-actions\"><button class=\"btn icon-btn\" title=\"Fullscreen\">'+icon('maximize')+'</button><button class=\"btn icon-btn\" title=\"Snapshot\">'+icon('camera')+'</button><button class=\"btn icon-btn\" data-action=\"open-evidence\" title=\"Open investigation\">'+icon('arrow-up-right')+'</button></div></div></div><div class=\"feed-card\"><div class=\"feed-media\">'+img('highAngle')+'<div class=\"feed-overlay\"><span>CAM-021 · Parking Area</span><span class=\"live-badge\"><i></i>LIVE · 14:34:16</span></div></div><div class=\"feed-footer\"><div><strong>CAM-021</strong><span>Online · no active alert</span></div><div class=\"feed-actions\"><button class=\"btn icon-btn\" title=\"Fullscreen\">'+icon('maximize')+'</button><button class=\"btn icon-btn\" title=\"Snapshot\">'+icon('camera')+'</button><button class=\"btn icon-btn\" title=\"Open investigation\">'+icon('arrow-up-right')+'</button></div></div></div><div class=\"feed-card\"><div class=\"feed-media\">'+img('gate')+'<div class=\"feed-overlay\"><span>CAM-041 · Market Road</span><span class=\"live-badge\"><i></i>LIVE · 14:34:16</span></div></div><div class=\"feed-footer\"><div><strong>CAM-041</strong><span>Active detection · 89% probable</span></div><div class=\"feed-actions\"><button class=\"btn icon-btn\" title=\"Fullscreen\">'+icon('maximize')+'</button><button class=\"btn icon-btn\" title=\"Snapshot\">'+icon('camera')+'</button><button class=\"btn icon-btn\" data-action=\"open-evidence\" title=\"Open investigation\">'+icon('arrow-up-right')+'</button></div></div></div><div class=\"feed-card\"><div class=\"feed-media offline\"><div style=\"text-align:center\">'+icon('video-off')+'<br><span>CAM-087 unavailable</span><br><small>Last active 11 minutes ago</small></div></div><div class=\"feed-footer\"><div><strong>CAM-087</strong><span style=\"color:#e98a8a\">Offline · Camera Network</span></div><div class=\"feed-actions\"><button class=\"btn\" data-view=\"network\">Investigate</button></div></div></div></div></div>'}\n  function alerts(){return '<div class=\"page-header\"><div><div class=\"eyebrow\">Operations · Review queue</div><h1>Alerts</h1><p>Review probable detections, camera interruptions, and investigation updates.</p></div><div class=\"page-actions\"><button class=\"btn\">'+icon('filter')+' All alerts</button><button class=\"btn\">'+icon('check')+' Mark all reviewed</button></div></div><div class=\"alerts-layout\"><section class=\"surface queue\"><div class=\"section-title\"><h2>Alert queue</h2><span>06 unresolved</span></div>'+queueItem('HIGH CONFIDENCE MATCH','92% similarity estimate · MP-2026-014 / CAM-034 / Main Gate','14:32:08 · Requires verification',true)+queueItem('MEDIUM CONFIDENCE MATCH','81% similarity estimate · MP-2026-011 / CAM-021 / Parking Area','13:18:44 · Requires verification')+queueItem('CAMERA OFFLINE','CAM-087 unavailable · last active 11 minutes ago','14:23:19 · Camera Network')+queueItem('INVESTIGATION UPDATE','4 probable detections added to MP-2026-014','14:17:04 · Audit trail')+'</section><section class=\"surface alert-detail\"><div class=\"detail-header\"><div><div class=\"eyebrow\">Selected alert · high confidence match</div><h2>Review CAM-034 probable detection</h2><p>Human verification is required before this frame is included as verified evidence.</p></div><span class=\"state review\">New</span></div><div class=\"detail-grid\"><div><span>Case</span><strong>MP-2026-014</strong></div><div><span>Confidence</span><strong style=\"color:var(--green)\">92% probable</strong></div><div><span>Camera</span><strong>CAM-034 · Main Gate</strong></div><div><span>Timestamp</span><strong>10 Sep 2026 · 14:32:08</strong></div></div><div class=\"map-field\">'+mapMarkup({})+'</div><div class=\"detail-actions\"><button class=\"btn btn-primary\" data-view=\"evidence\">Investigate</button><button class=\"btn btn-success\" data-action=\"verify\" data-event-id=\"event3\">'+icon('check')+' Mark reviewed</button><button class=\"btn btn-danger\" data-action=\"dismiss\">Dismiss</button></div></section></div></div>'}\n  function queueItem(title,copy,time,selected){return '<div class=\"queue-item '+(selected?'selected':'')+'\"><strong>'+title+'</strong><p>'+copy+'</p><time>'+time+'</time></div>'}\n  function reports(){return '<div class=\"page-header\"><div><div class=\"eyebrow\">Cases &amp; investigations / MP-2026-014</div><h1>Investigation report</h1><p>Evidence-first case dossier for Rahul Sharma. Potential detections remain explicitly qualified.</p></div><div class=\"page-actions\"><span class=\"state verified\">Evidence protected</span></div></div><div class=\"report-layout\"><article class=\"surface report-document\"><div class=\"report-cover\"><div><h2>Missing Person Investigation</h2><p>Case MP-2026-014 · Rahul Sharma · prepared 10 Sep 2026</p></div><div class=\"report-meta\"><div><span>Status</span><strong>ACTIVE</strong></div><div><span>Access</span><strong>AUTHORIZED</strong></div></div></div><div class=\"report-section\"><h3>Person details</h3><div class=\"detail-grid\"><div><span>Name</span><strong>Rahul Sharma · 17 years</strong></div><div><span>Missing since</span><strong>10 Sep 2026 · 10:35</strong></div><div><span>Last known location</span><strong>Central Bus Station</strong></div><div><span>Search coverage</span><strong>128 cameras · 10:00–16:00</strong></div></div></div><div class=\"report-section\"><h3>Detected camera sequence</h3><div class=\"route-mini\"><svg viewBox=\"0 0 100 50\" preserveAspectRatio=\"none\"><polyline points=\"10,36 34,18 57,29 87,12\" fill=\"none\" stroke=\"#36b8d9\" stroke-width=\"1.2\" stroke-dasharray=\"3 2\"></polyline><circle cx=\"10\" cy=\"36\" r=\"2\" fill=\"#36b8d9\"></circle><circle cx=\"34\" cy=\"18\" r=\"2\" fill=\"#36b8d9\"></circle><circle cx=\"57\" cy=\"29\" r=\"2.5\" fill=\"#4aa77c\"></circle><circle cx=\"87\" cy=\"12\" r=\"2\" fill=\"#36b8d9\"></circle></svg><span style=\"position:absolute;left:8%;bottom:8px;color:var(--muted);font-family:var(--mono);font-size:8px\">01 · CAM-012</span><span style=\"position:absolute;left:49%;bottom:8px;color:var(--muted);font-family:var(--mono);font-size:8px\">03 · CAM-034</span><span style=\"position:absolute;right:7%;top:7px;color:var(--muted);font-family:var(--mono);font-size:8px\">04 · CAM-041</span></div><table class=\"report-table\"><thead><tr><th>Time</th><th>Camera</th><th>Location</th><th>Confidence</th><th>State</th></tr></thead><tbody>'+events.map(ev=>'<tr><td class=\"mono\">'+ev.time+'</td><td class=\"mono\">'+ev.camera+'</td><td>'+ev.place+'</td><td>'+ev.score+'% probable</td><td>'+status(ev.id)+'</td></tr>').join('')+'</tbody></table></div><div class=\"report-section\"><h3>Investigator notes</h3><p>Potential detections are included for review. Only operator-verified matches are represented as verified evidence. Route sequence should be treated as a reviewable movement hypothesis until source footage is verified.</p></div></article><aside class=\"surface report-actions\"><h3>Report actions</h3><p>Assemble protected case evidence into a shareable dossier.</p><div class=\"report-action-list\"><button class=\"btn btn-primary\" data-action=\"generate-report\">'+icon('file-analytics')+' Generate report</button><button class=\"btn\" data-action=\"export-report\">'+icon('download')+' Export PDF</button><button class=\"btn\" data-action=\"share-report\">'+icon('share-2')+' Share securely</button></div><div class=\"secure-note\">'+icon('shield-lock')+' <span>Evidence protected · authorized access</span></div><div class=\"report-progress\" id=\"reportProgress\">Report not generated. Generate a report to assemble the current evidence sequence.</div></aside></div></div>'}\n  function network(){return '<div class=\"page-header\"><div><div class=\"eyebrow\">Operations · Infrastructure</div><h1>Camera network</h1><p>Monitor operational coverage and preserve access to unavailable source footage.</p></div><button class=\"btn\">'+icon('refresh')+' Sync network</button></div><div class=\"network-layout\"><section class=\"surface network-map\"><div class=\"map-panel-head\"><div><strong>Network coverage map</strong><span style=\"display:block;margin-top:3px\">132 registered camera endpoints · 4 offline</span></div><span class=\"mono\">Last sync 14:34:16</span></div>'+mapMarkup({})+'</section><section class=\"surface network-list\"><div class=\"section-title\"><h2>Camera endpoints</h2><span>4 offline</span></div>'+[['CAM-034','Main Gate','Active detection · 92% probable','Online'],['CAM-021','Parking Area','Online · no active alert','Online'],['CAM-041','Market Road','Active detection · 89% probable','Online'],['CAM-052','South Exit','Last active 14:11:03','Offline'],['CAM-087','Transit Annex','Last active 14:23:19','Offline']].map(x=>'<div class=\"network-row\"><div><strong>'+x[0]+'</strong><span>'+x[1]+' · '+x[2]+'</span></div><span class=\"network-state '+(x[3]==='Offline'?'offline':'')+'\">'+x[3]+'</span></div>').join('')+'</section></div></div>'}\n  function settings(){return '<div class=\"page-header\"><div><div class=\"eyebrow\">System administration</div><h1>Settings</h1><p>Configure operator preferences and evidence safeguards.</p></div></div><div class=\"settings-layout\"><nav class=\"surface settings-nav\"><button class=\"active\">Operator profile</button><button>Evidence access</button><button>Notifications</button><button>Search defaults</button><button>Audit trail</button></nav><section class=\"surface settings-panel\"><h2>Operator profile</h2><div class=\"setting-row\"><div><strong>Authorized access mode</strong><p>Required to open protected CCTV footage.</p></div><button class=\"toggle\" aria-label=\"Authorized access enabled\"><i></i></button></div><div class=\"setting-row\"><div><strong>New match alerts</strong><p>Notify when a high-confidence probable match is queued.</p></div><button class=\"toggle\" aria-label=\"New match alerts enabled\"><i></i></button></div><div class=\"setting-row\"><div><strong>Default confidence threshold</strong><p>Used when starting a new CCTV search.</p></div><select class=\"filter-select\"><option>75% · Review queue</option><option>90% · High confidence only</option></select></div><div class=\"setting-row\"><div><strong>Evidence retention</strong><p>Protected evidence is retained for 90 days.</p></div><span class=\"state verified\">Policy enforced</span></div></section></div></div>'}\n  const views={dashboard,cases,create,cctv,results,timeline,evidence,live,alerts,reports,network,settings};\n  function render(){root.innerHTML=(views[state.view]||dashboard)();document.querySelectorAll('[data-view]').forEach(el=>el.classList.toggle('is-active',el.getAttribute('data-view')===state.view));const context=['cctv','results','timeline','evidence','reports','live','alerts'].includes(state.view);document.getElementById('caseStrip').classList.toggle('is-visible',context);document.querySelectorAll('[data-event-select]').forEach(el=>el.classList.toggle('selected',el.getAttribute('data-event-select')===state.selectedEvent));}\n  function runSearch(){if(state.searchRunning)return;state.searchRunning=true;state.searchComplete=false;state.progressIndex=-1;render();const steps=[0,1,2,3];let i=0;const tick=()=>{if(i<steps.length){state.progressIndex=steps[i++];render();setTimeout(tick,760)}else{state.searchRunning=false;state.searchComplete=true;render();showAudit('47 potential sightings found · review queue ready')}};setTimeout(tick,500)}\n  document.addEventListener('click',function(e){const target=e.target.closest('button,[data-view],[data-action],[data-event-select]');if(!target)return;const view=target.getAttribute('data-view');if(view){state.view=view;render();return}const cam=target.getAttribute('data-camera');if(cam){state.selectedCamera=cam;render();showAudit(cam+' selected · '+cameraData[cam].place);return}const eventSelect=target.getAttribute('data-event-select');if(eventSelect){state.selectedEvent=eventSelect;render();return}const action=target.getAttribute('data-action');if(!action)return;if(action==='open-case'){state.view='cctv';render();return}if(action==='open-evidence'){state.selectedEvent=target.getAttribute('data-event-id')||'event3';state.view='evidence';render();return}if(action==='run-search'){runSearch();return}if(action==='next-step'){state.step=Math.min(4,state.step+1);render();return}if(action==='prev-step'){state.step=Math.max(1,state.step-1);render();return}if(action==='create-case'){state.view='cctv';render();showAudit('Case MP-2026-014 created · CCTV search ready');return}if(action==='verify'){const id=target.getAttribute('data-event-id')||'event3';state.verified.add(id);state.timeline.add(id);state.selectedEvent=id;render();showAudit('Match marked verified and added to the investigation record.');return}if(action==='add-timeline'){const id=target.getAttribute('data-event-id')||'event3';state.timeline.add(id);state.selectedEvent=id;render();showAudit('Probable detection added to the movement timeline.');return}if(action==='reject'){showAudit('Detection rejected after operator review.');return}if(action==='note'){showAudit('Investigation note added to the audit trail.');return}if(action==='dismiss'){showAudit('Alert dismissed with audit trail entry.');return}if(action==='generate-report'){const el=document.getElementById('reportProgress');if(el){el.textContent='Assembling person details, route evidence, verified matches, and investigator notes…';setTimeout(()=>{el.textContent='Report generated for MP-2026-014 · 4 camera events included.';showAudit('Report generated for MP-2026-014.');},1100)}return}if(action==='export-report'){showAudit('Protected report export queued as PDF.');return}if(action==='share-report'){showAudit('Secure share confirmation recorded for authorized access.');return}});\n  render();\n})();\n</script>\n",
