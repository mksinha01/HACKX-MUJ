      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n:root{--bg:#080c10;--surface:#111820;--surface-2:#161e27;--surface-3:#0d151c;--surface-4:#1b2630;--border:#263542;--border-soft:#1c2933;--text:#eef4f6;--muted:#8c9aa5;--subtle:#5f6d77;--cyan:#36b8d9;--cyan-soft:rgba(54,184,217,.14);--green:#4aa77c;--green-soft:rgba(74,167,124,.14);--amber:#d5a64a;--amber-soft:rgba(213,166,74,.14);--red:#d66060;--red-soft:rgba(214,96,96,.14);--mono:'IBM Plex Mono',ui-monospace,monospace;--sans:'Inter',system-ui,sans-serif;--radius:12px}\n.trace-app{min-height:100vh;background:var(--bg);color:var(--text);font-family:var(--sans);font-size:13px;line-height:1.45;display:grid;grid-template-columns:224px minmax(0,1fr);overflow:hidden}\n.trace-app button,.trace-app input,.trace-app select,.trace-app textarea{font:inherit;color:inherit}.trace-app button{cursor:pointer}.trace-app img{display:block;max-width:100%}.trace-app h1,.trace-app h2,.trace-app h3,.trace-app h4,.trace-app p{margin:0}.trace-app h1,.trace-app h2,.trace-app h3,.trace-app h4{font-weight:600;letter-spacing:-.025em}.trace-app p{color:var(--muted)}\n.trace-app button:focus-visible,.trace-app input:focus-visible,.trace-app select:focus-visible,.trace-app textarea:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}\n.trace-rail{display:flex;min-height:100vh;flex-direction:column;padding:22px 12px 16px;background:#0b1117;border-right:1px solid var(--border-soft)}\n.brand{display:flex;align-items:center;gap:10px;padding:0 10px 26px}.brand-mark{width:33px;height:33px;display:grid;place-items:center;border:1px solid rgba(54,184,217,.55);border-radius:9px;background:var(--cyan-soft);color:var(--cyan);font-size:19px}.brand-name{font-weight:700;letter-spacing:.09em;font-size:15px}.brand-sub{display:block;color:var(--subtle);font-size:9px;letter-spacing:.1em;text-transform:uppercase;margin-top:1px}\n.rail-label{color:var(--subtle);font-size:9px;letter-spacing:.13em;text-transform:uppercase;padding:0 10px 9px}.rail-nav{display:flex;flex-direction:column;gap:3px}.rail-nav button{display:flex;align-items:center;gap:10px;width:100%;min-height:37px;padding:8px 10px;border:1px solid transparent;border-radius:8px;background:transparent;color:var(--muted);text-align:left}.rail-nav button:hover{background:rgba(255,255,255,.035);color:var(--text)}.rail-nav button.is-active{background:var(--cyan-soft);border-color:rgba(54,184,217,.18);color:var(--text)}.rail-nav button.is-active .ti{color:var(--cyan)}.rail-nav .ti{width:17px;color:var(--subtle);font-size:17px;line-height:1}.rail-nav .nav-badge{margin-left:auto;min-width:20px;padding:2px 5px;border-radius:5px;background:var(--red-soft);color:#f0a0a0;font-family:var(--mono);font-size:9px;text-align:center}.rail-spacer{flex:1}.system-status{display:flex;align-items:center;gap:8px;padding:12px 10px;border-top:1px solid var(--border-soft);color:var(--muted);font-size:11px}.status-dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 0 3px var(--green-soft)}.operator{display:flex;align-items:center;gap:9px;padding:10px;border-radius:9px;background:rgba(255,255,255,.025)}.avatar{width:28px;height:28px;display:grid;place-items:center;flex:none;border-radius:50%;background:#2a4654;color:#d8f5fb;font-size:10px;font-weight:700}.operator strong{display:block;font-size:11px}.operator span{display:block;margin-top:2px;color:var(--subtle);font-size:9px}\n.trace-main{min-width:0;min-height:100vh;background:radial-gradient(circle at 75% -10%,rgba(30,72,88,.2),transparent 35%),#080c10}.topbar{height:60px;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:0 30px;border-bottom:1px solid var(--border-soft);background:rgba(8,12,16,.94)}.global-search{display:flex;align-items:center;gap:9px;width:min(450px,48%);height:34px;padding:0 11px;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:var(--subtle)}.global-search input{width:100%;border:0;outline:0;background:transparent;color:var(--text);font-size:12px}.global-search input::placeholder{color:var(--subtle)}.top-actions{display:flex;align-items:center;gap:18px}.top-time{color:var(--muted);font-family:var(--mono);font-size:10px;white-space:nowrap}.top-icon{position:relative;display:grid;place-items:center;width:31px;height:31px;border:1px solid transparent;border-radius:7px;background:transparent;color:var(--muted)}.top-icon:hover{border-color:var(--border);background:var(--surface);color:var(--text)}.top-icon .ti{font-size:17px}.top-icon .badge-dot{position:absolute;top:5px;right:5px;width:6px;height:6px;background:var(--red);border:1px solid var(--bg);border-radius:50%}.top-operator{display:flex;align-items:center;gap:8px;padding-left:3px}.top-operator .avatar{width:26px;height:26px}.top-operator span{color:var(--muted);font-size:11px}\n.case-strip{display:none;align-items:center;gap:15px;height:38px;padding:0 30px;border-bottom:1px solid var(--border-soft);background:#0d151c}.case-strip.is-visible{display:flex}.case-strip .case-context{color:var(--text);font-family:var(--mono);font-size:10px;white-space:nowrap}.case-strip .case-context b{color:var(--cyan)}.case-routes{display:flex;align-items:stretch;gap:2px;height:100%}.case-routes button{padding:0 12px;border:0;border-bottom:2px solid transparent;background:transparent;color:var(--muted);font-size:11px}.case-routes button:hover{color:var(--text)}.case-routes button.is-active{border-bottom-color:var(--cyan);color:var(--cyan)}\n.main-content{max-width:1500px;padding:25px 30px 40px;margin:0 auto}.page-header{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:20px}.eyebrow{color:var(--cyan);font-size:10px;letter-spacing:.13em;text-transform:uppercase}.page-header h1{margin-top:4px;font-size:26px}.page-header p{margin-top:5px;color:var(--muted);font-size:12px}.page-actions{display:flex;align-items:center;gap:8px}.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:34px;padding:7px 12px;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:var(--text);font-size:11px;font-weight:600}.btn:hover{border-color:#3a5362;background:var(--surface-2)}.btn .ti{font-size:15px}.btn-primary{border-color:var(--cyan);background:var(--cyan);color:#061016;box-shadow:0 5px 14px rgba(54,184,217,.12)}.btn-primary:hover{background:#59cae6;border-color:#59cae6;color:#061016}.btn-success{border-color:var(--green);background:var(--green);color:#08100c}.btn-success:hover{background:#5dbb8f;border-color:#5dbb8f}.btn-danger{border-color:rgba(214,96,96,.5);background:transparent;color:#e98a8a}.btn-quiet{border-color:transparent;background:transparent;color:var(--muted)}.btn-quiet:hover{border-color:var(--border);color:var(--text)}.icon-btn{width:32px;height:32px;display:grid;place-items:center;padding:0}.mono{font-family:var(--mono);font-variant-numeric:tabular-nums}.surface{border:1px solid var(--border);border-radius:var(--radius);background:var(--surface)}.surface-recessed{border:1px solid var(--border-soft);border-radius:var(--radius);background:var(--surface-3)}.section-title{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}.section-title h2{font-size:14px}.section-title span{color:var(--subtle);font-size:10px}.section-title a{color:var(--cyan);font-size:10px;cursor:pointer}\n.readout{display:grid;grid-template-columns:repeat(4,1fr);margin-bottom:18px;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface)}.readout-item{padding:14px 18px;border-right:1px solid var(--border)}.readout-item:last-child{border-right:0}.readout-label{color:var(--muted);font-size:10px}.readout-value{display:flex;align-items:baseline;gap:5px;margin-top:4px;color:var(--text);font-family:var(--mono);font-size:22px;font-weight:600;letter-spacing:-.04em}.readout-value small{color:var(--muted);font-family:var(--sans);font-size:10px;font-weight:500;letter-spacing:0}.readout-item.is-alert .readout-value{color:#ee8989}.readout-item.is-cyan .readout-value{color:var(--cyan)}.readout-item.is-green .readout-value{color:var(--green)}\n.dashboard-grid{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:18px;align-items:start}.map-panel{min-width:0;padding:0;overflow:hidden}.map-panel-head{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid var(--border-soft)}.map-panel-head strong{font-size:12px}.map-panel-head span{color:var(--muted);font-size:10px}.map-field{position:relative;min-height:382px;overflow:hidden;background:#0c171d}.map-texture{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.12;filter:grayscale(1) sepia(.2) hue-rotate(155deg) brightness(.55);pointer-events:none}.map-vignette{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,16,20,.58),rgba(9,18,23,.18) 55%,rgba(8,12,16,.36)),linear-gradient(0deg,rgba(8,12,16,.42),transparent 35%,rgba(8,12,16,.24));pointer-events:none}.map-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(128,163,175,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(128,163,175,.05) 1px,transparent 1px);background-size:38px 38px;opacity:.5}.road{position:absolute;height:9px;border-top:2px solid rgba(150,164,164,.24);border-bottom:1px solid rgba(150,164,164,.1);transform-origin:left center}.road.r1{width:95%;left:-4%;top:54%;transform:rotate(-10deg)}.road.r2{width:78%;left:18%;top:28%;transform:rotate(36deg)}.road.r3{width:62%;left:2%;top:76%;transform:rotate(21deg)}.road.r4{width:55%;left:49%;top:82%;transform:rotate(-55deg)}.road.r5{width:48%;left:36%;top:47%;transform:rotate(90deg)}.building{position:absolute;border:1px solid rgba(130,164,168,.16);background:rgba(46,75,83,.22);box-shadow:inset 0 0 0 5px rgba(8,12,16,.15)}.building span{position:absolute;left:8px;top:7px;color:rgba(192,213,216,.55);font-size:9px;letter-spacing:.03em}.b1{left:10%;top:18%;width:23%;height:18%}.b2{left:42%;top:10%;width:21%;height:21%}.b3{left:68%;top:34%;width:20%;height:18%}.b4{left:18%;top:61%;width:20%;height:17%}.b5{left:62%;top:66%;width:24%;height:16%}.b6{left:40%;top:56%;width:13%;height:16%}.map-zone{position:absolute;color:rgba(183,205,211,.48);font-size:9px;letter-spacing:.08em;text-transform:uppercase}.zone-bus{left:38%;top:37%}.zone-park{left:72%;top:56%}.zone-market{left:11%;top:82%}.zone-south{left:79%;top:87%}.map-route{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.route-line{fill:none;stroke:var(--cyan);stroke-width:2.4;stroke-dasharray:7 4;opacity:.86}.route-point{fill:var(--cyan);stroke:#0a1115;stroke-width:3}.route-point.verified{fill:var(--green)}.camera-node{position:absolute;display:flex;align-items:center;gap:5px;height:25px;padding:3px 6px;border:1px solid rgba(143,175,185,.38);border-radius:5px;background:rgba(11,18,23,.92);color:#c5d6dc;font-family:var(--mono);font-size:9px;box-shadow:0 2px 8px rgba(0,0,0,.24)}.camera-node:hover,.camera-node.selected{border-color:var(--cyan);color:#e8fbff;background:#11242c}.camera-node.match{border-color:var(--green);color:#c8efdc}.camera-node.offline{border-color:#56616b;color:#7b858b}.camera-node .node-dot{width:6px;height:6px;border-radius:50%;background:var(--cyan)}.camera-node.match .node-dot{background:var(--green);box-shadow:0 0 0 3px var(--green-soft)}.camera-node.offline .node-dot{background:#626a70}.node-021{left:23%;top:31%}.node-034{left:48%;top:39%}.node-041{left:19%;top:69%}.node-052{left:76%;top:74%}.map-legend{position:absolute;left:13px;bottom:12px;display:flex;align-items:center;gap:12px;padding:7px 9px;border:1px solid rgba(79,109,119,.35);border-radius:6px;background:rgba(8,12,16,.78);color:var(--muted);font-size:9px}.legend-item{display:flex;align-items:center;gap:5px}.legend-item i{width:6px;