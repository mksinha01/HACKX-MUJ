uppercase}.report-section{padding:17px 0;border-bottom:1px solid var(--line-soft)}.report-section h3{margin:0 0 10px;color:#dce7ea;font-size:12px}.report-person{display:flex;align-items:center;gap:11px}.report-person img{width:46px;height:55px;object-fit:cover;border-radius:6px;filter:saturate(.65)}.report-person strong{display:block;color:#e0ebee;font-size:13px}.report-person span{display:block;margin-top:3px;color:#80cfe0;font:500 10px var(--mono)}.report-route{position:relative;height:90px;border:1px solid var(--line);border-radius:7px;background:#0c171c;overflow:hidden}.report-route svg{position:absolute;inset:0;width:100%;height:100%}.report-route-node{position:absolute;top:39px;width:14px;height:14px;border:2px solid #c5f3f8;border-radius:50%;background:#17414d}.rr1{left:14%}.rr2{left:36%}.rr3{left:59%}.rr4{left:82%}.report-table{width:100%;border-collapse:collapse;font-size:10px}.report-table th{padding:7px 8px;color:#708590;font:500 9px var(--mono);text-align:left;text-transform:uppercase}.report-table td{padding:8px;border-top:1px solid var(--line-soft);color:#b9cbd1}.report-table td.mono{color:#c8e9ef}.report-actions{padding:15px}.report-actions h3{margin:0;color:#dce8eb;font-size:13px}.report-actions p{margin:5px 0 15px;color:#758a94;font-size:10px}.report-action-list{display:flex;flex-direction:column;gap:8px}.report-action-list .btn{justify-content:flex-start;width:100%}.secure-note{display:flex;gap:7px;margin-top:18px;padding:10px;border:1px solid #29503c;border-radius:7px;background:#11261d;color:#9dd6af;font-size:10px}.secure-note .ico{width:14px;height:14px;flex:none}.inline-status{position:fixed;right:22px;bottom:18px;z-index:20;display:none;align-items:center;gap:8px;padding:10px 13px;border:1px solid #356576;border-radius:8px;background:#10212a;color:#caeff5;box-shadow:0 8px 24px rgba(0,0,0,.3);font-size:11px}.inline-status.show{display:flex}.inline-status.success{border-color:#3a7358;background:#142a20;color:#b8e8ca}.inline-status.warning{border-color:#735b2e;background:#2a2214;color:#e8cd8f}.empty{padding:28px;text-align:center;color:#748791;border:1px dashed #2b414b;border-radius:9px;background:#0d161c}.empty strong{display:block;margin-bottom:5px;color:#b5c6cc;font-size:12px}@media(max-width:1200px){.case-console{grid-template-columns:220px minmax(0,1fr) 240px}.ledger-head,.ledger-row{grid-template-columns:65px minmax(160px,1.3fr) minmax(150px,1.1fr) 100px 120px 65px}.view{padding-right:22px;padding-left:22px}.topbar{padding-right:22px;padding-left:22px}.context{padding-right:22px;padding-left:22px}}\n</style>\n<div class=\"trace-app\" data-kid=\"1\">\n    <aside class=\"rail\" data-kid=\"1-1\">\n        <div class=\"brand\" data-kid=\"1-1-1\">\n            <div class=\"brand-mark\" data-kid=\"1-1-1-1\">\n                TR\n            </div>\n            <div data-kid=\"1-1-1-2\">\n                <div class=\"brand-name\" data-kid=\"1-1-1-2-1\">\n                    TRACE\n                </div>\n                <div class=\"brand-sub\" data-kid=\"1-1-1-2-2\">\n                    Missing person investigation\n                </div>\n            </div>\n        </div>\n        <div class=\"rail-label\" data-kid=\"1-1-2\">\n            Operations\n        </div>\n        <nav aria-label=\"Primary navigation\" class=\"nav\" data-kid=\"1-1-3\">\n            <button class=\"active\" data-kid=\"1-1-3-1\" data-view=\"dashboard\">\n                <i class=\"ico\" data-kid=\"1-1-3-1-1\" data-lucide=\"layout-dashboard\">\n                </i>\n                <span data-kid=\"1-1-3-1-2\">\n                    Dashboard\n                </span>\n            </button>\n            <button data-kid=\"1-1-3-2\" data-view=\"cases\">\n                <i class=\"ico\" data-kid=\"1-1-3-2-1\" data-lucide=\"scan-face\">\n                </i>\n                <span data-kid=\"1-1-3-2-2\">\n                    Missing Persons\n                </span>\n                <span class=\"nav-count\" data-dynamic=\"true\" data-kid=\"1-1-3-2-3\" data-name=\"navigated item counter\" data-reason=\"number updated by system as new matches are detected\">\n                    12\n                </span>\n            </button>\n            <button data-kid=\"1-1-3-3\" data-view=\"results\">\n                <i class=\"ico\" data-kid=\"1-1-3-3-1\" data-lucide=\"search\">\n                </i>\n                <span data-kid=\"1-1-3-3-2\">\n                    CCTV Search\n                </span>\n            </button>\n            <button data-kid=\"1-1-3-4\" data-view=\"live\">\n                <i class=\"ico\" data-kid=\"1-1-3-4-1\" data-lucide=\"video\">\n                </i>\n                <span data-kid=\"1-1-3-4-2\">\n                    Live Cameras\n                </span>\n            </button>\n            <button data-kid=\"1-1-3-5\" data-view=\"timeline\">\n                <i class=\"ico\" data-kid=\"1-1-3-5-1\" data-lucide=\"route\">\n                </i>\n                <span data-kid=\"1-1-3-5-2\">\n                    Movement Timeline\n                </span>\n            </button>\n            <button data-kid=\"1-1-3-6\" data-view=\"alerts\">\n                <i class=\"ico\" data-kid=\"1-1-3-6-1\" data-lucide=\"triangle-alert\">\n                </i>\n                <span data-kid=\"1-1-3-6-2\">\n                    Alerts\n                </span>\n                <span class=\"nav-count\" data-dynamic=\"true\" data-kid=\"1-1-3-6-3\" data-name=\"navigated alert counter\" data-reason=\"number updated by system as alerts arrive\">\n                    06\n                </span>\n            </button>\n            <button data-kid=\"1-1-3-7\" data-view=\"workspace\">\n                <i class=\"ico\" data-kid=\"1-1-3-7-1\" data-lucide=\"briefcase-business\">\n                </i>\n                <span data-kid=\"1-1-3-7-2\">\n                    Cases & Investigations\n                </span>\n            </button>\n            <button data-kid=\"1-1-3-8\" data-view=\"report\">\n                <i class=\"ico\" data-kid=\"1-1-3-8-1\" data-lucide=\"file-text\">\n                </i>\n                <span data-kid=\"1-1-3-8-2\">\n                    Reports\n                </span>\n            </button>\n            <button data-kid=\"1-1-3-9\" data-view=\"live\">\n                <i class=\"ico\" data-kid=\"1-1-3-9-1\" data-lucide=\"network\">\n                </i>\n                <span data-kid=\"1-1-3-9-2\">\n                    Camera Network\n                </span>\n            </button>\n            <button data-kid=\"1-1-3-10\" data-view=\"settings\">\n                <i class=\"ico\" data-kid=\"1-1-3-10-1\" data-lucide=\"settings-2\">\n                </i>\n                <span data-kid=\"1-1-3-10-2\">\n                    Settings\n                </span>\n            </button>\n        </nav>\n        <div class=\"rail-spacer\" data-kid=\"1-1-4\">\n        </div>\n        <div class=\"system\" data-kid=\"1-1-5\">\n            <span class=\"dot\" data-kid=\"1-1-5-1\">\n            </span>\n            <span data-kid=\"1-1-5-2\">\n                System operational\n            </span>\n        </div>\n        <div class=\"operator\" data-kid=\"1-1-6\">\n            <div class=\"avatar\" data-kid=\"1-1-6-1\">\n                OP\n            </div>\n            <div data-kid=\"1-1-6-2\">\n                <strong data-kid=\"1-1-6-2-1\">\n                    Operator\n                </strong>\n                <span data-kid=\"1-1-6-2-2\">\n                    Authorized access\n                </span>\n            </div>\n            <i class=\"ico\" data-kid=\"1-1-6-3\" data-lucide=\"chevron-up\" style=\"margin-left:auto;width:14px;color:#647782\">\n            </i>\n        </div>\n    </aside>\n    <main class=\"main\" data-kid=\"1-2\">\n        <header class=\"topbar\" data-kid=\"1-2-1\">\n            <div class=\"global-search\" data-kid=\"1-2-1-1\">\n                <i class=\"ico\" data-kid=\"1-2-1-1-1\" data-lucide=\"search\">\n                </i>\n                <input aria-label=\"Global search\" data-kid=\"1-2-1-1-2\" placeholder=\"Search person, case or camera...\"/>\n            </div>\n            <div class=\"topbar-spacer\" data-kid=\"1-2-1-2\">\n            </div>\n            <div class=\"top-meta\" data-kid=\"1-2-1-3\">\n                <span class=\"top-date mono\" data-dynamic=\"true\" data-kid=\"1-2-1-3-1\" data-name=\"header date and time clock\" data-reason=\"time updated every second by system clock\">\n                    Thu, 10 Sep 2026 · 14:34:16\n                </span>\n                <button class=\"notify\" data-kid=\"1-2-1-3-2\" data-view=\"alerts\" title=\"Notifications\">\n                    <i class=\"ico\" data-kid=\"1-2-1-3-2-1\" data-lucide=\"bell\">\n                    </i>\n                    <span class=\"notify-badge\" data-dynamic=\"true\" data-kid=\"1-2-1-3-2-2\" data-name=\"notification bell badge\" data-reason=\"count updated by system as new alerts arrive\">\n                        6\n                    </span>\n                </button>\n                <div class=\"access\" data-kid=\"1-2-1-3-3\">\n                    <span class=\"dot\" data-kid=\"1-2-1-3-3-1\">\n                    </span>\n                    <span data-kid=\"1-2-1-3-3-2\">\n                        Authorized operator\n                    </span>\n                </div>\n                <div class=\"avatar\" data-kid=\"1-2-1-3-4\">\n                    OP\n                </div>\n            </div>\n        </header>\n        <div class=\"context\" data-kid=\"1-2-2\">\n            <div class=\"context-case\" data-kid=\"1-2-2-1\">\n                <img alt=\"Rahul Sharma case portrait, photo by Vika Glitter on Pexels\" class=\"tiny-avatar\" data-kid=\"1-2-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/17009459/pexels-photo-17009459.jpeg?auto=compress&cs=tinysrgb&w=80&q=80\"/>\n                <b data-kid=\"1-2-2-1-2\">\n   