    },
    "var_1af2ec302214": {
      "type": "variant",
      "label": "TRACE — Time & Evidence Wall",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 5150,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n:root{--bg:#080c10;--surface:#111820;--surface-2:#161e27;--surface-3:#0d141b;--surface-4:#1a2530;--line:#263542;--line-strong:#344554;--text:#edf3f7;--muted:#94a5b2;--faint:#617382;--cyan:#36b8d9;--cyan-soft:rgba(54,184,217,.12);--green:#58b783;--green-soft:rgba(88,183,131,.13);--amber:#d5a64a;--amber-soft:rgba(213,166,74,.13);--red:#d66060;--red-soft:rgba(214,96,96,.13);--shadow:0 18px 50px rgba(0,0,0,.22);--mono:'IBM Plex Mono',ui-monospace,SFMono-Regular,Consolas,monospace;--sans:'IBM Plex Sans',Inter,system-ui,sans-serif}\nbody{margin:0;background:#070b0f;color:var(--text);font-family:var(--sans);font-size:13px;line-height:1.45}\n.trace-app{min-height:100vh;display:grid;grid-template-columns:224px minmax(0,1fr);background:var(--bg);letter-spacing:.005em}\n.trace-app button,.trace-app input,.trace-app select,.trace-app textarea{font:inherit}\n.trace-app button{cursor:pointer}\n.trace-app button:focus-visible,.trace-app input:focus-visible,.trace-app select:focus-visible,.trace-app textarea:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}\n.rail{display:flex;min-height:100vh;flex-direction:column;padding:22px 12px 14px;background:#0a1015;border-right:1px solid var(--line)}\n.brand{display:flex;align-items:center;gap:10px;padding:0 10px 24px;border-bottom:1px solid rgba(52,69,84,.55)}\n.brand-mark{display:grid;width:34px;height:34px;place-items:center;color:#071015;background:var(--cyan);border-radius:9px;box-shadow:0 0 0 4px rgba(54,184,217,.09)}\n.brand-mark svg{width:19px;height:19px;stroke-width:2.4}.brand-name{font-size:16px;line-height:1;font-weight:700;letter-spacing:.13em}.brand-sub{margin-top:4px;color:var(--faint);font-size:9px;letter-spacing:.1em;text-transform:uppercase}\n.rail-label{margin:22px 10px 8px;color:var(--faint);font-family:var(--mono);font-size:9px;letter-spacing:.12em;text-transform:uppercase}.nav{display:flex;flex-direction:column;gap:2px}.nav-item{display:flex;min-height:36px;align-items:center;gap:10px;padding:8px 10px;color:#8294a1;background:transparent;border:1px solid transparent;border-radius:8px;text-align:left;transition:background .18s,border-color .18s,color .18s}.nav-item svg{width:16px;height:16px;flex:none;stroke-width:1.7}.nav-item span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.nav-item:hover{color:var(--text);background:rgba(38,53,66,.52)}.nav-item.active{color:var(--text);background:#14212b;border-color:#223544}.nav-item.active svg{color:var(--cyan)}.nav-badge{margin-left:auto;min-width:18px;padding:1px 5px;color:#071015;background:var(--cyan);border-radius:10px;font-family:var(--mono);font-size:9px;font-weight:600;text-align:center}\n.rail-spacer{flex:1}.system-block{padding:13px 10px;border-top:1px solid rgba(52,69,84,.55)}.system-status{display:flex;align-items:center;gap:7px;color:var(--green);font-size:11px}.status-dot{width:7px;height:7px;flex:none;background:currentColor;border-radius:50%;box-shadow:0 0 0 3px rgba(88,183,131,.12)}.operator{display:flex;align-items:center;gap:9px;margin-top:15px}.avatar{display:grid;width:28px;height:28px;place-items:center;color:#091016;background:#263d4a;border:1px solid #385565;border-radius:50%;font-size:10px;font-weight:700}.operator-copy{min-width:0}.operator-name{color:var(--text);font-size:11px;font-weight:600}.operator-role{margin-top:2px;color:var(--faint);font-size:10px}\n.app-main{min-width:0;display:flex;min-height:100vh;flex-direction:column;background:radial-gradient(circle at 80% -30%,rgba(34,71,90,.16),transparent 35%),var(--bg)}.topbar{display:flex;height:60px;align-items:center;justify-content:space-between;gap:18px;padding:0 30px;border-bottom:1px solid var(--line);background:rgba(8,12,16,.93)}.crumbs{display:flex;min-width:220px;align-items:center;gap:8px;color:var(--faint);font-size:11px}.crumbs strong{color:var(--text);font-weight:500}.crumbs svg{width:13px;height:13px}.global-search{display:flex;width:min(420px,38vw);align-items:center;gap:9px;padding:8px 12px;color:var(--faint);background:#0d151c;border:1px solid var(--line);border-radius:7px}.global-search svg{width:15px;height:15px;flex:none}.global-search input{width:100%;padding:0;color:var(--text);background:transparent;border:0;outline:0;font-size:12px}.global-search input::placeholder{color:#637482}.top-actions{display:flex;align-items:center;gap:16px}.clock{color:#aab8c1;font-family:var(--mono);font-size:10px;white-space:nowrap}.top-action{position:relative;display:grid;width:28px;height:28px;place-items:center;color:#8fa1ae;background:transparent;border:0;border-radius:6px}.top-action:hover{color:var(--text);background:#14212b}.top-action svg{width:17px;height:17px}.notify-badge{position:absolute;top:1px;right:0;display:grid;width:13px;height:13px;place-items:center;color:#071015;background:var(--amber);border-radius:50%;font-family:var(--mono);font-size:8px;font-weight:600}.top-profile{display:flex;align-items:center;gap:8px;padding-left:5px}.top-profile .avatar{width:26px;height:26px}.top-profile span{color:#b7c4cb;font-size:11px}\n.case-strip{display:flex;height:42px;align-items:center;justify-content:space-between;gap:18px;padding:0 30px;background:#0d151c;border-bottom:1px solid var(--line)}.case-context{display:flex;align-items:center;gap:9px;min-width:0}.case-context svg{width:15px;height:15px;color:var(--cyan)}.case-id{font-family:var(--mono);font-size:11px;font-weight:600}.case-name{color:#aab9c3;font-size:11px}.case-strip-tools{display:flex;align-items:center;gap:2px}.case-tab{padding:6px 10px;color:#7f929f;background:transparent;border:0;border-bottom:2px solid transparent;font-size:11px}.case-tab:hover{color:var(--text)}.case-tab.active{color:var(--cyan);border-bottom-color:var(--cyan)}\n.view-root{width:min(100%,1320px);padding:26px 30px 50px;margin:0 auto}.view-header{display:flex;align-items:fle