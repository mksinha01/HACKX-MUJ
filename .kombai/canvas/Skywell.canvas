      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');\n\n  body {\n    margin: 0;\n    padding: 0;\n  }\n\n  .skywell-stage {\n    --surface: #fdfdfc;\n    --surface-2: #f8f8f5;\n    --surface-3: #f5f5f3;\n    --border: #e7e6e3;\n    --border-soft: #eeedea;\n    --text: #17181a;\n    --text-2: #5b5d61;\n    --text-3: #8a8d92;\n    --accent: #0e6f8a;\n    --ease: cubic-bezier(0.16, 1, 0.3, 1);\n    --r-sm: 6px;\n    --r-md: 9px;\n    --r-lg: 12px;\n    --r-xl: 18px;\n    --shadow-modal: 0 2px 6px rgba(12,24,32,.06), 0 40px 90px -30px rgba(10,28,40,.45);\n    position: relative;\n    isolation: isolate;\n    box-sizing: border-box;\n    width: 100%;\n    min-height: 1000px;\n    display: grid;\n    place-items: center;\n    overflow: hidden;\n    padding: 24px;\n    background: #7fb2e0;\n    color: var(--text);\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    font-size: 15px;\n    line-height: 1.5;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .skywell-stage a { color: inherit; text-decoration: none; }\n  .skywell-stage button { font: inherit; color: inherit; }\n  .skywell-stage svg { display: block; }\n  .skywell-stage :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }\n\n  .skywell-backdrop {\n    position: absolute;\n    inset: -4%;\n    z-index: 0;\n    background:\n      linear-gradient(180deg, rgba(255,255,255,.22) 0%, rgba(233,241,247,.55) 100%),\n      url(\"https://images.pexels.com/photos/1493759/pexels-photo-1493759.jpeg?auto=compress&cs=tinysrgb&w=1600\") center/cover no-repeat,\n      linear-gradient(180deg, #4f8fd6 0%, #7cb4e4 30%, #b9d6ee 62%, #dfe7ec 100%);\n    background-size: cover;\n    background-position: center;\n    filter: blur(14px) saturate(1.04);\n    transform: scale(1.06);\n  }\n\n  .skywell-backdrop-ui {\n    position: absolute;\n    inset: 0;\n    z-index: 1;\n    pointer-events: none;\n    filter: blur(9px);\n    opacity: .55;\n  }\n\n  .skywell-ghost { position: absolute; background: rgba(255,255,255,.62); border-radius: 8px; }\n  .skywell-ghost.dark { background: rgba(28,36,44,.22); }\n  .skywell-ghost.amber { background: rgba(242,201,76,.66); }\n  .skywell-ghost.rose { background: rgba(226,96,86,.6); }\n\n  .skywell-modal {\n    position: relative;\n    z-index: 2;\n    box-sizing: border-box;\n    width: 980px;\n    max-width: 100%;\n    height: 700px;\n    display: flex;\n    align-items: stretch;\n    overflow: hidden;\n    background: var(--surface);\n    border-radius: var(--r-xl);\n    box-shadow: var(--shadow-modal), inset 0 0 0 1px rgba(20,32,40,.055);\n  }\n\n  .skywell-side {\n    box-sizing: border-box;\n    width: 220px;\n    flex: none;\n    padding: 26px 14px;\n    background: var(--surface-2);\n    border-right: 1px solid var(--border-soft);\n  }\n\n  .skywell-side-title {\n    margin: 0 0 16px;\n    padding: 0 10px;\n    color: var(--text-3);\n    font-size: 11.5px;\n    font-weight: 600;\n    letter-spacing: .09em;\n    line-height: 1.5;\n    text-transform: uppercase;\n  }\n\n  .skywell-side-link {\n    display: flex;\n    align-items: center;\n    gap: 11px;\n    padding: 9px 10px;\n    border-radius: var(--r-md);\n    color: var(--text);\n    font-size: 15px;\n    transition: background .18s var(--ease);\n  }\n\n  .skywell-side-link + .skywell-side-link { margin-top: 4px; }\n  .skywell-side-link:hover { background: #f0efec; }\n  .skywell-side-link.is-active { background: #eceae6; font-weight: 500; }\n  .skywell-side-link .ico { width: 19px; height: 19px; flex: none; color: #3c3f44; }\n  .skywell-side-link .label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\n  .skywell-pill-new {\n    flex: none;\n    margin-left: auto;\n    padding: 2px 9px;\n    border-radius: 999px;\n    background: var(--accent);\n    color: #fff;\n    font-size: 11px;\n    font-weight: 600;\n    letter-spacing: .01em;\n    line-height: 1.5;\n  }\n\n  .skywell-body { min-width: 0; flex: 1; display: flex; flex-direction: column; }\n\n  .skywell-body-head {\n    flex: none;\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 20px;\n    padding: 24px 24px 20px;\n    border-bottom: 1px solid var(--border-soft);\n  }\n\n  .skywell-body-head h1 {\n    margin: 0 0 4px;\n    color: var(--text);\n    font-size: 20px;\n    font-weight: 600;\n    letter-spacing: -.02em;\n    line-height: 1.2;\n  }\n\n  .skywell-body-head p { margin: 0; color: var(--text-2); font-size: 14.5px; }\n\n  .skywell-close {\n    flex: none;\n    margin: -2px -4px 0 0;\n    padding: 5px;\n    border: 0;\n    border-radius: var(--r-sm);\n    background: transparent;\n    color: var(--text-2);\n    cursor: pointer;\n    transition: background .18s var(--ease), color .18s var(--ease);\n  }\n\n  .skywell-close:hover { background: var(--surface-3); color: var(--text); }\n\n  .skywell-body-scroll {\n    box-sizing: border-box;\n    min-height: 0;\n    flex: 1;\n    overflow-y: auto;\n    padding: 22px 24px 24px;\n    scrollbar-width: thin;\n    scrollbar-color: #d6d5d1 transparent;\n  }\n\n  .skywell-sec-label { margin: 0 0 10px; color: var(--text-2); font-size: 14.5px; }\n\n  .skywell-credits {\n    display: flex;\n    align-items: center;\n    margin-bottom: 26px;\n    padding: 16px 20px;\n    border: 1px solid var(--border-soft);\n    border-radius: var(--r-lg);\n    background: var(--surface-2);\n  }\n\n  .skywell-credits-total {\n    box-sizing: border-box;\n    flex: none;\n    width: 200px;\n    padding-right: 20px;\n    border-right: 1px solid var(--border);\n  }\n\n  .skywell-credits-total .k,\n  .skywell-credits-cols .k { color: var(--text-2); font-size: 14.5px; }\n  .skywell-credits-total .k { margin-bottom: 6px; }\n\n  .skywell-credits-total .v {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    color: var(--text);\n    font-size: 26px;\n    font-weight: 600;\n    letter-spacing: -.03em;\n    line-height: 1.1;\n  }\n\n  .skywell-credits-cols {\n    min-width: 0;\n    flex: 1;\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 16px;\n    padding-left: 24px;\n  }\n\n  .skywell-credits-cols .k {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    margin-bottom: 6px;\n    line-height: 1.35;\n    white-space: nowrap;\n  }\n\n  .skywell-credits-cols .k svg { flex: none; }\n\n  .skywell-credits-cols .v { color: var(--text); font-size: 16px; letter-spacing: -.01em; }\n  .skywell-coin { width: 24px; height: 24px; flex: none; }\n  .skywell-coin-sm { width: 17px; height: 17px; flex: none; }\n\n  .skywell-filters {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 12px;\n    margin-bottom: 16px;\n  }\n\n  .skywell-select {\n    box-sizing: border-box;\n    height: 38px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n    padding: 0 12px;\n    border: 1px solid var(--border);\n    border-radius: var(--r-md);\n    background: var(--surface);\n    color: var(--text);\n    font-size: 14.5px;\n    cursor: pointer;\n    transition: border-color .18s var(--ease), background .18s var(--ease);\n  }\n\n  .skywell-select:hover { border-color: #d6d5d1; background: var(--surface-2); }\n  .skywell-select .caret { flex: none; color: var(--text-2); }\n\n  .skywell-day {\n    overflow: hidden;\n    margin-bottom: 20px;\n    border: 1px solid var(--border);\n    border-radius: var(--r-lg);\n    background: var(--surface);\n  }\n\n  .skywell-day-head {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    padding: 11px 18px;\n    border-bottom: 1px solid var(--border-soft);\n    background: var(--surface-2);\n  }\n\n  .skywell-day-date {\n    font-size: 14px;\n    font-weight: 600;\n    letter-spacing: .04em;\n    text-transform: uppercase;\n  }\n\n  .skywell-day-stats {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    color: var(--text-2);\n    font-size: 14.5px;\n  }\n\n  .skywell-day-stats .grp { display: flex; align-items: center; gap: 7px; }\n  .skywell-day-stats .num { color: var(--text); font-weight: 500; font-variant-numeric: tabular-nums; }\n  .skywell-day-stats .num.bal { color: var(--accent); }\n  .skywell-stat-sep { width: 1px; height: 16px; background: var(--border); }\n\n  .skywell-entry {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    padding: 16px 18px;\n    transition: background .18s var(--ease);\n  }\n\n  .skywell-entry + .skywell-entry { border-top: 1px solid var(--border-soft); }\n  .skywell-entry:hover { background: var(--surface-2); }\n\n  .skywell-entry-ico {\n    width: 34px;\n    height: 34px;\n    flex: none;\n    display: grid;\n    place-items: center;\n    border-radius: 50%;\n    background: var(--surface-3);\n    color: #4a4d52;\n  }\n\n  .skywell-entry-main { min-width: 0; flex: 1; }\n\n  .skywell-entry-title {\n    display: flex;\n    align-items: center;\n    gap: 9px;\n    color: var(--text);\n    font-size: 15px;\n    font-weight: 500;\n    letter-spacing: -.008em;\n  }\n\n  .skywell-entry-title .divider { color: #c8c7c3; font-weight: 400; }\n  .skywell-entry-title .meta { color: var(--text-2); font-weight: 400; }\n  .skywell-entry-title .caret { color: var(--text-2); cursor: pointer; }\n  .skywell-entry-sub { margin-top: 2px; color: var(--text-2); font-size: 14px; }\n  .skywell-entry-amt { flex: none; color: var(--text); font-size: 15px; font-weight: 500; font-variant-numeric: tabular-nums; letter-spacing: -.01em; }\n\n  @media (max-width: 900px) {\n    .skywell-stage { min-height: 820px; place-items: start center; padding: 16px; }\n    .skywell-modal { height: auto; max-height: 790px; flex-direction: column; }\n    .skywell-side { width: 100%; border-right: 0; border-bottom: 1px solid var(--border-soft); }\n    .skywell-credits { flex-direction: column; align-items: flex-start; gap: 16px; }\n    .skywell-credits-total { width: 100%; padding-right: 0; border-right: 0; }\n    .skywell-credits-cols { width: 100%; padding-left: 0; }\n    .skywell-filters { grid-template-columns: 1fr; }\n  }\n</style>\n<div class=\"skywell-stage relative isolate flex min-h-[1000px] w-full items-center justify-center overflow-hidden p-6\" data-kid=\"1\" data-name=\"page layout container\">\n    <div aria-hidden=\"true\" class=\"skywell-backdrop\" data-kid=\"1-1\" data-name=\"background decoration\">\n    </div>\n    <div aria-hidden=\"true\" class=\"skywell-backdrop-ui\" data-kid=\"1-2\" data-name=\"visual background UI\">\n        <span class=\"skywell-ghost\" data-kid=\"1-2-1\" data-name=\"decorative ghost rectangle\" style=\"left:24px;top:20px;width:180px;height:26px;\">\n        </span>\n        <span class=\"skywell-ghost dark\" data-kid=\"1-2-2\" data-name=\"decorative ghost dark rectangle\" style=\"left:216px;top:22px;width:44px;height:22px;\">\n        </span>\n        <span class=\"skywell-ghost\" data-kid=\"1-2-3\" data-name=\"decorative ghost rectangle\" style=\"left:400px;top:24px;width:210px;height:18px;opacity:.5;\">\n        </span>\n        <span class=\"skywell-ghost amber\" data-kid=\"1-2-4\" data-name=\"decorative ghost pill\" style=\"right:118px;top:20px;width:150px;height:26px;border-radius:999px;\">\n        </span>\n        <span class=\"skywell-ghost\" data-kid=\"1-2-5\" data-name=\"decorative ghost pill\" style=\"right:290px;top:22px;width:52px;height:22px;border-radius:999px;\">\n        </span>\n        <span class=\"skywell-ghost rose\" data-kid=\"1-2-6\" data-name=\"decorative ghost circle\" style=\"right:78px;top:22px;width:22px;height:22px;border-radius:999px;\">\n        </span>\n        <span class=\"skywell-ghost\" data-kid=\"1-2-7\" data-name=\"decorative ghost circle\" style=\"right:44px;top:22px;width:22px;height:22px;border-radius:999px;\">\n        </span>\n        <span class=\"skywell-ghost dark\" data-kid=\"1-2-8\" data-name=\"decorative ghost dark square\" style=\"left:200px;top:700px;width:34px;height:34px;border-radius:10px;opacity:.5;\">\n        </span>\n        <span class=\"skywell-ghost\" data-kid=\"1-2-9\" data-name=\"decorative ghost line\" style=\"left:250px;top:706px;width:150px;height:22px;opacity:.45;\">\n        </span>\n        <span class=\"skywell-ghost\" data-kid=\"1-2-10\" data-name=\"decorative ghost separator line\" style=\"left:200px;top:790px;width:1040px;height:1px;opacity:.5;\">\n        </span>\n        <span class=\"skywell-ghost\" data-kid=\"1-2-11\" data-name=\"decorative ghost line\" style=\"left:200px;top:840px;width:110px;height:14px;opacity:.4;\">\n        </span>\n        <span class=\"skywell-ghost\" data-kid=\"1-2-12\" data-name=\"decorative ghost line\" style=\"left:390px;top:836px;width:210px;height:18px;opacity:.4;\">\n        </span>\n        <span class=\"skywell-ghost\" data-kid=\"1-2-13\" data-name=\"decorative ghost line\" style=\"left:390px;top:862px;width:330px;height:12px;opacity:.3;\">\n        </span>\n        <span class=\"skywell-ghost\" data-kid=\"1-2-14\" data-name=\"decorative ghost line\" style=\"left:960px;top:840px;width:100px;height:12px;opacity:.32;\">\n        </span>\n    </div>\n    <div aria-label=\"Account settings\" class=\"skywell-modal relative z-[2] flex h-[700px] w-[980px] max-w-full overflow-hidden rounded-[18px]\" data-kid=\"1-3\" data-name=\"account settings modal\" role=\"dialog\">\n        <aside class=\"skywell-side\" data-kid=\"1-3-1\" data-name=\"side navigation bar\">\n            <p class=\"skywell-side-title\" data-kid=\"1-3-1-1\" data-name=\"navigation section title\">\n                Account settings\n            </p>\n            <a class=\"skywell-side-link\" data-kid=\"1-3-1-2\" data-name=\"side navigation link\" href=\"#\">\n                <span class=\"ico\" data-kid=\"1-3-1-2-1\" data-name=\"user icon\">\n                    <svg data-kid=\"1-3-1-2-1-1\" data-name=\"user outline icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\">\n                        <circle cx=\"12\" cy=\"12\" r=\"9\">\n                        </circle>\n                        <circle cx=\"12\" cy=\"10\" r=\"2.9\">\n                        </circle>\n                        <path d=\"M6.6 19.1c.8-2.4 2.8-3.7 5.4-3.7s4.6 1.3 5.4 3.7\">\n                        </path>\n                    </svg>\n                </span>\n                <span class=\"label\" data-kid=\"1-3-1-2-2\" data-name=\"user name text\">\n                    Maya Ferreira\n                </span>\n            </a>\n            <a class=\"skywell-side-link\" data-kid=\"1-3-1-3\" data-name=\"side navigation link\" href=\"#\">\n                <span class=\"ico\" data-kid=\"1-3-1-3-1\" data-name=\"key icon\">\n                    <svg data-kid=\"1-3-1-3-1-1\" data-name=\"key outline icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\">\n                        <circle cx=\"7.5\" cy=\"12\" r=\"3.6\">\n                        </circle>\n                        <path d=\"M11.1 12H21\">\n                        </path>\n                        <path d=\"M17.6 12v3.4\">\n                        </path>\n                        <path d=\"M20.4 12v2.4\">\n                        </path>\n                    </svg>\n                </span>\n                <span class=\"label\" data-kid=\"1-3-1-3-2\" data-name=\"link label\">\n                    Master Key\n                </span>\n            </a>\n            <a class=\"skywell-side-link\" data-kid=\"1-3-1-4\" data-name=\"side navigation link\" href=\"#\">\n                <span class=\"ico\" data-kid=\"1-3-1-4-1\" data-name=\"workers icon\">\n                    <svg data-kid=\"1-3-1-4-1-1\" data-name=\"worker settings icon\" fill=\"none\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\">\n                        <rect height=\"12\" rx=\"2.6\" width=\"18\" x=\"3\" y=\"6.5\">\n                        </rect>\n                        <circle cx=\"9\" cy=\"12.5\" r=\"1.9\">\n                        </circle>\n                        <path d=\"M14 10.6h4M14 14.4h4\" stroke-linecap=\"round\">\n                        </path>\n                    </svg>\n                </span>\n                <span class=\"label\" data-kid=\"1-3-1-4-2\" data-name=\"link label\">\n                    Manage Workers\n                </span>\n            </a>\n            <a class=\"skywell-side-link\" data-kid=\"1-3-1-5\" data-name=\"side navigation link\" href=\"#\">\n                <span class=\"ico\" data-kid=\"1-3-1-5-1\" data-name=\"preferences icon\">\n                    <svg data-kid=\"1-3-1-5-1-1\" data-name=\"sliders icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\">\n                        <path d=\"M6 4v6M6 14v6M12 4v3M12 11v9M18 4v9M18 17v3\">\n                        </path>\n                        <path d=\"M4 12h4M10 9h4M16 15h4\">\n                        </path>\n                    </svg>\n                </span>\n                <span class=\"label\" data-kid=\"1-3-1-5-2\" data-name=\"link label\">\n                    Preferences\n                </span>\n            </a>\n            <a class=\"skywell-side-link\" data-kid=\"1-3-1-6\" data-name=\"side navigation link\" href=\"#\">\n                <span class=\"ico\" data-kid=\"1-3-1-6-1\" data-name=\"momentum icon\">\n                    <svg data-kid=\"1-3-1-6-1-1\" data-name=\"momentum flame icon\" fill=\"none\" viewbox=\"0 0 24 24\">\n                        <path d=\"M12.6 3.2c.4 2.7-1.4 3.6-2.3 5.4-1 2-.5 4 .9 4.9 1.2.8 2.4.1 2.6-1.1.2-1 .1-1.9-.2-2.8 2 1.3 3.4 3.4 3.4 5.7 0 3-2.7 5.4-6 5.4s-6-2.4-6-5.4c0-4.3 4.4-6.1 7.6-12.1Z\" fill=\"#d9822b\">\n                        </path>\n                    </svg>\n                </span>\n 