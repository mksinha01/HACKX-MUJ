\n                                Person photo selected\n                            </span>\n                        </div>\n                        <div class=\"draft-item done\" data-kid=\"1-2-5-3-2-3-2\">\n                            <i class=\"ico\" data-kid=\"1-2-5-3-2-3-2-1\" data-lucide=\"check-circle-2\">\n                            </i>\n                            <span data-kid=\"1-2-5-3-2-3-2-2\">\n                                Person details complete\n                            </span>\n                        </div>\n                        <div class=\"draft-item done\" data-kid=\"1-2-5-3-2-3-3\">\n                            <i class=\"ico\" data-kid=\"1-2-5-3-2-3-3-1\" data-lucide=\"check-circle-2\">\n                            </i>\n                            <span data-kid=\"1-2-5-3-2-3-3-2\">\n                                Last known moment set\n                            </span>\n                        </div>\n                        <div class=\"draft-item\" data-kid=\"1-2-5-3-2-3-4\">\n                            <i class=\"ico\" data-kid=\"1-2-5-3-2-3-4-1\" data-lucide=\"circle\">\n                            </i>\n                            <span data-kid=\"1-2-5-3-2-3-4-2\">\n                                Search coverage ready\n                            </span>\n                        </div>\n                        <div class=\"draft-item\" data-kid=\"1-2-5-3-2-3-5\">\n                            <i class=\"ico\" data-kid=\"1-2-5-3-2-3-5-1\" data-lucide=\"circle\">\n                            </i>\n                            <span data-kid=\"1-2-5-3-2-3-5-2\">\n                                Review and authorize\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"secure-note\" data-kid=\"1-2-5-3-2-4\" style=\"margin-top:22px\">\n                        <i class=\"ico\" data-kid=\"1-2-5-3-2-4-1\" data-lucide=\"shield-check\">\n                        </i>\n                        <span data-kid=\"1-2-5-3-2-4-2\">\n                            Only authorized operators can open protected evidence.\n                        </span>\n                    </div>\n                </aside>\n            </div>\n        </section>\n        <section class=\"view\" data-kid=\"1-2-6\" id=\"view-workspace\">\n            <div class=\"page-head\" data-kid=\"1-2-6-1\">\n                <div data-kid=\"1-2-6-1-1\">\n                    <div class=\"eyebrow\" data-kid=\"1-2-6-1-1-1\">\n                        Cases & investigations / MP-2026-014\n                    </div>\n                    <h1 data-kid=\"1-2-6-1-1-2\">\n                        Missing Person Investigation\n                    </h1>\n                    <p data-kid=\"1-2-6-1-1-3\">\n                        Review probable detections and convert verified evidence into a movement timeline.\n                    </p>\n                </div>\n                <div class=\"head-actions\" data-kid=\"1-2-6-1-2\">\n                    <button class=\"btn btn-quiet\" data-kid=\"1-2-6-1-2-1\" data-view=\"report\">\n                        <i class=\"ico\" data-kid=\"1-2-6-1-2-1-1\" data-lucide=\"file-text\">\n                        </i>\n                        Investigation report\n                    </button>\n                    <button class=\"btn btn-primary\" data-kid=\"1-2-6-1-2-2\" data-view=\"results\">\n                        <i class=\"ico\" data-kid=\"1-2-6-1-2-2-1\" data-lucide=\"scan-search\">\n                        </i>\n                        Review potential matches\n                    </button>\n                </div>\n            </div>\n            <div class=\"case-console\" data-kid=\"1-2-6-2\">\n                <aside class=\"panel identity\" data-kid=\"1-2-6-2-1\">\n                    <img alt=\"Rahul Sharma case portrait, photo by Vika Glitter on Pexels\" data-kid=\"1-2-6-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://ima