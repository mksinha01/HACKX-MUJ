      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap');\n:root{--bg:#080c10;--surface:#111820;--surface-2:#161e27;--surface-3:#0d151c;--line:#263542;--line-soft:#1c2934;--text:#e6edf1;--muted:#91a1ad;--faint:#657682;--cyan:#36b8d9;--cyan-soft:#143745;--green:#4aa77c;--green-soft:#17372d;--amber:#d5a64a;--amber-soft:#3b2e17;--red:#d66060;--red-soft:#3d2024;--radius:12px;--mono:'IBM Plex Mono',ui-monospace,SFMono-Regular,Consolas,monospace;--sans:'IBM Plex Sans',Inter,system-ui,sans-serif}\n*{box-sizing:border-box} body{margin:0;min-width:1180px;background:var(--bg);color:var(--text);font:14px/1.45 var(--sans);letter-spacing:.005em}button,input,select,textarea{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}.trace-app{min-height:100vh;display:grid;grid-template-columns:224px 1fr;background:var(--bg)}.rail{position:sticky;top:0;height:100vh;display:flex;flex-direction:column;padding:24px 14px 18px;background:#0b1116;border-right:1px solid var(--line)}.brand{display:flex;align-items:center;gap:10px;padding:0 10px 26px}.brand-mark{width:32px;height:32px;display:grid;place-items:center;border:1px solid #2e6678;background:#112b35;color:#8ee7fa;border-radius:9px;font:600 12px var(--mono);letter-spacing:-.08em}.brand-name{color:#f3f7f9;font-size:15px;font-weight:700;letter-spacing:.08em}.brand-sub{margin-top:2px;color:var(--faint);font-size:9px;letter-spacing:.12em;text-transform:uppercase}.rail-label{margin:0 10px 10px;color:#506471;font:500 10px var(--mono);letter-spacing:.1em;text-transform:uppercase}.nav{display:flex;flex-direction:column;gap:3px}.nav button{display:flex;align-items:center;gap:11px;width:100%;min-height:37px;padding:8px 10px;border:1px solid transparent;border-radius:9px;background:transparent;color:var(--muted);text-align:left;font-size:12px}.nav button:hover{background:#111d25;color:var(--text);border-color:#1c313d}.nav button.active{background:#12232c;color:#d5f6fc;border-color:#244654}.nav button .ico{width:16px;height:16px;color:#7c909c;flex:0 0 auto}.nav button.active .ico{color:var(--cyan)}.nav .nav-count{margin-left:auto;min-width:20px;padding:2px 5px;border-radius:20px;background:#23323d;color:#b8cbd4;font:500 10px var(--mono);text-align:center}.rail-spacer{flex:1}.system{display:flex;align-items:center;gap:8px;margin:0 10px 16px;color:#8bc9ab;font-size:11px}.dot{width:7px;height:7px;display:inline-block;border-radius:50%;background:var(--green);box-shadow:0 0 0 3px #17342a}.operator{display:flex;align-items:center;gap:9px;padding:12px 10px 0;border-top:1px solid var(--line-soft)}.avatar{width:28px;height:28px;display:grid;place-items:center;border-radius:50%;background:#294453;color:#d9f7ff;font-weight:700;font-size:11px}.operator strong{display:block;color:#c7d3d9;font-size:11px}.operator span{display:block;margin-top:1px;color:var(--faint);font-size:10px}.main{min-width:0;min-height:100vh;background:linear-gradient(180deg,#0a1015 0,#080c10 72%)}.topbar{height:60px;display:flex;align-items:center;gap:18px;padding:0 30px;border-bottom:1px solid var(--line);background:#0b1218}.global-search{position:relative;width:340px}.global-search .ico{position:absolute;top:10px;left:11px;color:#657986}.global-search input{width:100%;height:34px;padding:0 12px 0 34px;border:1px solid var(--line);border-radius:8px;background:#0e171f;color:var(--text);font-size:12px}.global-search input::placeholder{color:#637581}.topbar-spacer{flex:1}.top-meta{display:flex;align-items:center;gap:18px;color:var(--muted);font-size:11px}.mono{font-family:var(--mono);font-variant-numeric:tabular-nums}.top-date{color:#a8b8c1}.notify{position:relative;display:grid;place-items:center;width:32px;height:32px;border:1px solid transparent;border-radius:8px;background:transparent;color:#9cafba}.notify:hover{background:#14212a;border-color:var(--line)}.notify-badge{position:absolute;top:2px;right:1px;min-width:14px;height:14px;padding:1px 4px;border-radius:8px;background:var(--red);color:#fff;font:600 9px var(--mono)}.access{display:flex;align-items:center;gap:7px;padding-left:16px;border-left:1px solid var(--line);color:#84a994;font-size:10px}.access .dot{box-shadow:none}.context{height:38px;display:flex;align-items:center;gap:20px;padding:0 30px;border-bottom:1px solid var(--line-soft);background:#0c141a;color:var(--muted);font-size:11px}.context-case{display:flex;align-items:center;gap:9px;color:#d6e2e7}.context-case .tiny-avatar{width:20px;height:20px;border-radius:50%;object-fit:cover}.context-case b{font:600 11px var(--mono);color:#dcebf0}.context-links{display:flex;align-items:center;gap:4px;height:100%}.context-links button{height:100%;padding:0 10px;border:0;border-bottom:2px solid transparent;background:transparent;color:var(--muted);font-size:11px}.context-links button:hover,.context-links button.active{color:#d3f7ff;border-bottom-color:var(--cyan)}.view{display:none;padding:28px 30px 44px;max-width:1500px;margin:0 auto}.view.active{display:block}.page-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:22px}.eyebrow{color:var(--cyan);font:600 10px var(--mono);letter-spacing:.1em;text-transform:uppercase}.page-head h1{margin:4px 0 4px;color:#edf5f7;font-size:24px;line-height:1.2;letter-spacing:-.025em}.page-head p{margin:0;color:var(--muted);font-size:13px}.head-actions{display:flex;align-items:center;gap:9px}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:34px;padding:8px 13px;border:1px solid var(--line);border-radius:8px;background:#121c24;color:#c9d5da;font-size:12px;font-weight:600}.btn:hover{border-color:#386071;background:#172630}.btn-primary{border-color:#2f99b5;background:#1c7891;color:#effcff}.btn-primary:hover{background:#258ea8}.btn-quiet{border-color:transparent;background:transparent;color:var(--muted)}.btn-quiet:hover{border-color:var(--line);background:#131e26;color:var(--text)}.btn-success{border-color:#367b5c;background:#1e563e;color:#e4fff0}.btn-danger{border-color:#7c3f45;background:#3a2227;color:#ffdfe0}.btn .ico{width:15px;height:15px}.readout{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);border-radius:11px;background:#0f171e;margin-bottom:18px}.readout-item{min-height:76px;padding:15px 18px;border-right:1px solid var(--line)}.readout-item:last-child{border-right:0}.readout-label{color:var(--faint);font-size:11px}.readout-value{margin-top:6px;color:#e9f1f3;font:600 21px/1 var(--mono);letter-spacing:-.04em}.readout-value em{color:var(--cyan);font-style:normal}.readout-hint{margin-left:7px;color:#6e818c;font-size:10px;font-family:var(--sans);letter-spacing:0}.panel{border:1px solid var(--line);border-radius:var(--radius);background:var(--surface);overflow:hidden}.panel-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:15px 16px;border-bottom:1px solid var(--line)}.panel-title{color:#dce7eb;font-size:13px;font-weight:600}.panel-sub{color:var(--faint);font-size:10px}.dashboard-grid{display:grid;grid-template-columns:minmax(0,1fr) 346px;gap:16px;align-items:stretch}.map-panel{min-height:424px}.map-canvas{position:relative;height:424px;overflow:hidden;background:#0c171c}.map-canvas>img.map-texture{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.07;filter:grayscale(1) contrast(1.4);mix-blend-mode:screen}.map-gridlines{position:absolute;inset:0;background-image:linear-gradient(rgba(75,115,128,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(75,115,128,.08) 1px,transparent 1px);background-size:36px 36px;mask-image:linear-gradient(90deg,transparent 0,#000 16%,#000 84%,transparent 100%)}.road{position:absolute;height:18px;background:#24383c;border:1px solid #365055;transform:rotate(-12deg);opacity:.84}.road:after{content:'';position:absolute;inset:7px 0 auto;border-top:1px dashed #71817e;opacity:.65}.r1{width:84%;left:5%;top:46%;transform:rotate(-11deg)}.r2{width:62%;left:27%;top:24%;transform:rotate(23deg)}.r3{width:72%;left:10%;top:74%;transform:rotate(8deg)}.r4{width:42%;left:47%;top:61%;transform:rotate(-54deg)}.block{position:absolute;border:1px solid #2b4546;background:#16282b;opacity:.78}.b1{width:19%;height:22%;left:12%;top:15%}.b2{width:22%;height:18%;left:69%;top:15%}.b3{width:17%;height:24%;left:66%;top:65%}.b4{width:18%;height:16%;left:24%;top:67%}.place{position:absolute;color:#789096;font:500 10px var(--mono);letter-spacing:.03em}.place span{display:block;margin-top:2px;color:#506a71;font:400 9px var(--sans)}.p1{left:13%;top:24%}.p2{left:70%;top:24%}.p3{left:47%;top:42%}.p4{left:67%;top:73%}.p5{left:29%;top:78%}.route{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.cam-node{position:absolute;z-index:2;display:flex;align-items:center;gap:6px;padding:5px 7px;border:1px solid #3a6872;border-radius:6px;background:#12252c;color:#c9f5fd;font:600 10px var(--mono);box-shadow:0 4px 12px rgba(0,0,0,.25)}.cam-node:hover{border-color:var(--cyan);background:#173843}.cam-node:before{content:'';width:6px;height:6px;border-radius:50%;background:var(--cyan);box-shadow:0 0 0 3px rgba(54,184,217,.16)}.cam-node.match{border-color:#4c9877;background:#17332b;color:#d9f7e7}.cam-node.match:before{background:var(--green);box-shadow:0 0 0 3px rgba(74,167,124,.16)}.cam-node.offline{border-color:#38444b;background:#141b20;color:#778791}.cam-node.offline:before{background:#66727a;box-shadow:none}.c21{left:19%;top:39%}.c34{left:52%;top:45%}.c41{left:72%;top:52%}.c52{left:38%;top:79%}.map-preview{position:absolute;z-index:4;right:14px;bottom:14px;width:285px;border:1px solid #386d7a;border-radius:10px;background:#111d24;box-shadow:0 12px 30px rgba(0,0,0,.35);overflow:hidden}.map-preview-head{display:flex;align-items:center;justify-content:space-between;padding:9px 11px;border-bottom:1px solid #29434d}.map-preview-head strong{font:600 11px var(--mono);color:#d8f5fa}.map-preview-head span{color:#82bf96;font-size:10px}.map-preview img{display:block;width:100%;height:96px;object-fit:cover;filter:saturate(.65) contrast(1.2)}.map-preview-body{padding:9px 11px}.preview-meta{display:flex;align-items:center;justify-content:space-between;color:var(--muted);font-size:10px}.preview-meta b{color:#bde9f2;font:500 11px var(--mono)}.preview-actions{display:flex;gap:7px;margin-top:9px}.preview-actions .btn{min-height:28px;padding:5px 8px;font-size:10px}.alert-list{display:flex;flex-direction:column}.alert-row{padding:14px 15px;border-bottom:1px solid var(--line-soft);cursor:pointer}.alert-row:last-child{border-bottom:0}.alert-row:hover{background:#15222b}.alert-row.selected{background:#142932}.alert-top{display:flex;align-items:center;justify-content:space-between;gap:10px}.severity{display:inline-flex;align-items:center;gap:6px;color:#c9d5da;font-size:10px;font-weight:700;letter-spacing:.05em;text-transform:uppercase}.severity i{width:6px;height:6px;display:inline-block;border-radius:50%;background:var(--amber)}.severity.high i{background:var(--red)}.severity.ok i{background:var(--green)}.alert-time{color:#6f828c;font:10px var(--mono)}.alert-copy{margin-top:6px;color:#d8e4e8;font-size:12px}.alert-meta{display:flex;gap:12px;margin-top:8px;color:#82939d;font-size:10px}.alert-meta b{color:#b8cbd2;font-family:var(--mono);font-weight:500}.section-row{display:flex;align-items:center;justify-content:space-between;margin:21px 0 10px}.section-row h2{margin:0;color:#dce7eb;font-size:14px;font-weight:600}.section-row span{color:var(--faint);font-size:10px}.evidence-tape{display:flex;gap:10px;overflow:hidden}.evidence-card{position:relative;min-width:218px;border:1px solid var(--line);border-radius:10px;background:var(--surface);overflow:hidden;cursor:pointer}.evidence-card:hover{border-color:#3b7180}.evidence-img{position:relative;height:114px;overflow:hidden;background:#131e25}.evidence-img img{width:100%;height:100%;object-fit:cover;filter:saturate(.55) contrast(1.25) brightness(.75)}.bbox{position:absolute;left:47%;top:24%;width:18%;height:48%;border:1px solid var(--cyan);box-shadow:0 0 0 1px rgba(54,184,217,.17)}.bbox.green{border-color:var(--green)}.confidence{position:absolute;left:8px;top:8px;padding:4px 6px;border-radius:5px;background:#112a32;color:#a9effb;font:600 10px var(--mono)}.confidence.high{background:#17392f;color:#a4e4c0}.evidence-body{padding:9px 10px}.evidence-name{display:flex;align-items:center;justify-content:space-between;color:#d9e5e8;font-size:11px;font-weight:600}.evidence-name span{color:#91a3ad;font:500 10px var(--mono)}.evidence-foot{display:flex;gap:8px;margin-top:5px;color:#758994;font-size:10px}.evidence-foot b{color:#a6bbc4;font-family:var(--mono);font-weight:500}\n/* Cases */.toolbar{display:flex;align-items:center;gap:9px;padding:11px;border:1px solid var(--line);border-radius:10px;background:#0e171e;margin-bottom:13px}.field{height:34px;padding:0 10px;border:1px solid var(--line);border-radius:7px;background:#111b23;color:var(--text);font-size:11px}.field::placeholder{color:#687b85}.search-field{flex:1;min-width:260px}.ledger{border:1px solid var(--line);border-radius:11px;overflow:hidden;background:var(--surface)}.ledger-head,.ledger-row{display:grid;grid-template-columns:76px minmax(190px,1.45fr) minmax(180px,1.35fr) 120px 135px 74px;align-items:center;gap:12px;padding:13px 15px}.ledger-head{background:#0e171e;color:#667984;font:500 10px var(--mono);letter-spacing:.04em;text-transform:uppercase}.ledger-row{min-height:90px;border-top:1px solid var(--line-soft);cursor:pointer}.ledger-row:hover,.ledger-row.selected{background:#14232b}.person-thumb{width:56px;height:56px;border:1px solid #38535e;border-radius:8px;object-fit:cover;filter:saturate(.7)}.person-name{color:#e2edf0;font-size:13px;font-weight:600}.case-id{margin-top:3px;color:var(--cyan);font:500 10px var(--mono)}.case-meta{color:#98aab3;font-size:11px}