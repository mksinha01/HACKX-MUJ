x;background:#111920;border:1px solid var(--line);border-radius:9px}.report-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;padding-bottom:16px;border-bottom:1px solid var(--line)}.report-heading h2{margin:3px 0 0;color:var(--text);font-size:20px}.report-heading p{margin:5px 0 0;color:var(--muted);font-size:11px}.report-id{color:var(--cyan);font-family:var(--mono);font-size:10px}.report-route{position:relative;height:166px;margin:17px 0;background:#0b161d;border:1px solid var(--line);border-radius:7px}.report-section{padding:15px 0;border-top:1px solid var(--line)}.report-section:first-of-type{border-top:0}.report-section h3{margin:0 0 10px;color:#dce7eb;font-size:12px}.report-section p{margin:0;color:var(--muted);font-size:10px;line-height:1.6}.report-table{width:100%;border-collapse:collapse;font-size:9px}.report-table th{padding:7px 8px;color:var(--faint);background:#0d151c;font-family:var(--mono);font-weight:500;text-align:left}.report-table td{padding:8px;color:#c9d6dc;border-top:1px solid var(--line);font-family:var(--mono)}.report-actions{position:sticky;top:18px}.report-actions .panel-body{display:flex;flex-direction:column;gap:8px}.report-actions .btn{width:100%}.security-cue{display:flex;align-items:flex-start;gap:8px;padding:10px;margin-top:6px;color:var(--green);background:var(--green-soft);border:1px solid rgba(88,183,131,.2);border-radius:6px;font-size:9px;line-height:1.45}.security-cue svg{width:13px;height:13px;flex:none}.bar-row{display:flex;align-items:center;gap:10px;margin-top:8px}.bar-row label{width:68px;color:var(--muted);font-size:9px}.bar{height:7px;flex:1;background:#20313b;border-radius:4px;overflow:hidden}.bar i{display:block;height:100%;background:var(--green);border-radius:4px}.bar-row b{width:28px;color:var(--faint);font-family:var(--mono);font-size:9px;font-weight:500;text-align:right}\n.network-grid{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:16px}.network-map{height:430px}.network-map .map-surface{height:100%}.camera-table{overflow:hidden}.camera-table-head,.camera-table-row{display:grid;grid-template-columns:100px 1.1fr 100px 90px 80px;gap:12px;align-items:center;padding:10px 13px}.camera-table-head{color:var(--faint);background:#0d151c;font-family:var(--mono);font-size:9px;text-transform:uppercase}.camera-table-row{border-top:1px solid var(--line);font-size:10px}.camera-table-row strong{color:#d6e2e7;font-family:var(--mono);font-size:10px;font-weight:500}.camera-state{display:inline-flex;align-items:center;gap:5px;color:var(--green);font-size:9px}.camera-state.offline{color:var(--red)}.camera-state .status-dot{width:5px;height:5px;box-shadow:none}.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.setting-row{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:13px 0;border-bottom:1px solid var(--line)}.setting-row:last-child{border-bottom:0}.setting-row strong{color:#d6e2e8;font-size:11px;font-weight:500}.setting-row span{color:var(--muted);font-size:10px}.toggle{width:30px;height:17px;padding:2px;background:#25414d;border:0;border-radius:10px}.toggle i{display:block;width:13px;height:13px;background:var(--cyan);border-radius:50%;transform:translateX(11px)}\n.toast-stack{position:fixed;right:22px;bottom:18px;z-index:20;display:flex;width:310px;flex-direction:column;gap:8px}.toast{display:flex;align-items:flex-start;gap:9px;padding:11px 12px;color:#cde6eb;background:#11242c;border:1px solid #386372;border-radius:7px;box-shadow:var(--shadow);font-size:10px;animation:toast-in .2s ease}.toast svg{width:15px;height:15px;flex:none;color:var(--cyan)}@keyframes toast-in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}\n@media(max-width:1100px){.view-root{padding-right:20px;padding-left:20px}.topbar{padding:0 20px}.case-strip{padding:0 20px}.dashboard-grid,.dashboard-bottom{grid-template-columns:1fr}.workspace-grid{grid-template-columns:200px minmax(0,1fr)}.workspace-grid>.summary-panel{grid-column:1/-1}.results-layout,.viewer-grid,.report-layout,.network-grid,.alert-layout{grid-template-columns:1fr}.inspector,.report-actions{position:static}.ledger-head,.ledger-row{grid-template-columns:68px minmax(140px,1.15fr) minmax(150px,1.25fr) 90px 110px 55px 90px}.rail{width:224px}}\n</style>\n<style>\n    :root{--bg:#eee8f8;--panel:#e4dcf2;--surface:#fbf8ff;--surface-2:#f1edf9;--surface-3:#f7f3fb;--surface-4:#ffffff;--line:#d9cfe9;--line-soft:#e1d7f1;--line-strong:#c8bbdc;--text:#19161d;--ink-2:#443e50;--muted:#6f667b;--faint:#8b8095;--cyan:#0f6f63;--cyan-soft:#e5dbf6;--green:#23866f;--green-soft:#e4f2ed;--amber:#a86628;--amber-soft:#f7ebdf;--red:#b0533f;--red-soft:#f5e6e1;--shadow:0 1px 2px rgba(29,20,44,.05),0 12px 28px -20px rgba(29,20,44,.35)}\nbody{background:var(--bg);color:var(--text)}\n.trace-app{background:var(--bg);color:var(--text)}\n.rail{background:var(--bg);border-color:var(--line)}\n.brand{border-color:var(--line)}\n.brand-mark{color:var(--cyan);background:var(--surface);border:1px solid var(--line);box-shadow:0 0 0 4px rgba(15,111,99,.08)}\n.brand-sub,.rail-label,.operator-role,.faint{color:var(--faint)}\n.nav-item{color:var(--muted)}\n.nav-item:hover,.nav-item.active{color:var(--text);background:var(--panel);border-color:var(--line)}\n.nav-item.active svg{color:var(--cyan)}\n.nav-badge{color:#fff;background:var(--cyan)}\n.system-block{border-color:var(--line)}\n.app-main{background:var(--bg)}\n.topbar{background:rgba(238,232,248,.94);border-color:var(--line)}\n.crumbs{color:var(--faint)}.crumbs strong{color:var(--text)}\n.global-search{color:var(--faint);background:var(--surface);border-color:var(--line)}.global-search input{color:var(--text)}.global-search input::placeholder{color:var(--faint)}\n.case-strip{background:var(--surface-2);border-color:var(--line)}.case-name,.case-tab{color:var(--muted)}.case-tab.active{color:var(--cyan);border-bottom-color:var(--cyan)}\n.view-title,.panel-title,.person-name,.evidence-copy strong,.result-card-title strong,.detail-hero h2,.report-heading h2,.report-section h3,.setting-row strong,.camera-table-row strong,.next-review p{color:var(--text)}\n.view-subtitle,.panel-kicker,.muted,.readout-label,.readout-note,.meta-label,.form-label,.form-section-help,.search-state-sub,.alert-meta,.alert-foot,.result-meta,.detail-hero p,.detail-grid-item span,.queue-copy p,.report-heading p,.report-section p,.setting-row span{color:var(--muted)}\n.panel,.report-sheet,.feed-card,.case-ledger,.workspace-header,.upload-zone,.search-state,.results-toolbar,.cluster-header,.result-card,.inspector,.evidence-inspector,.alert-queue,.alert-detail,.camera-table,.route-summary,.recent-strip,.evidence-board,.alert-panel,.camera-map{background:var(--surface);border-color:var(--line-soft);box-shadow:var(--shadow)}\n.panel-header,.readout,.toolbar,.results-toolbar,.cluster-header,.table-label,.video-controls,.feed-meta,.detail-grid-item,.person-crop,.draft-row,.search-state{background:var(--surface-2);border-color:var(--line-soft)}\n.readout{background:var(--surface);border-color:var(--line)}.readout-cell{border-color:var(--line)}\n.btn{color:var(--ink-2);background:var(--surface);border-color:var(--line)}.btn:hover{color:var(--text);background:var(--panel);border-color:var(--line-strong)}.btn-primary{color:#fff;background:var(--cyan);border-color:var(--cyan)}.btn-primary:hover{color:#fff;background:#168273;border-color:#168273}.btn-success{color:#fff;background:var(--green);border-color:var(--green)}.btn-danger{color:var(--red);background:transparent;border-color:rgba(176,83,63,.38)}.btn-danger:hover{background:var(--red-soft);border-color:var(--red)}.btn-quiet{color:var(--muted);background:transparent;border-color:transparent}\n.select,.input,.form-control{color:var(--ink-2);background:var(--surface);border-color:var(--line)}.input::placeholder,.form-control::placeholder{color:var(--faint)}\n.map-surface,.map-mini,.route-map,.report-route{background-color:#ebe5f4;background-image:linear-gradient(132deg,transparent 0 33%,rgba(94,78,111,.12) 33.2% 33.7%,transparent 34%),linear-gradient(15deg,transparent 0 50%,rgba(94,78,111,.1) 50.3% 50.8%,transparent 51%),linear-gradient(83deg,transparent 0 66%,rgba(94,78,111,.09) 66.2% 66.7%,transparent 67%),repeating-linear-gradient(90deg,rgba(94,78,111,.08) 0 1px,transparent 1px 72px),repeating-linear-gradient(0deg,rgba(94,78,111,.06) 0 1px,transparent 1px 54px)}\n.map-surface:before,.map-surface:after{background:rgba(94,78,111,.12)}.map-label{color:#756a82}.map-legend{color:var(--muted);border-color:var(--line)}\n.camera-node{color:var(--ink-2);background:rgba(251,248,255,.92);border-color:#b9aaca}.camera-node.match{color:#1e654f;background:var(--green-soft);border-color:#82b7a6}.camera-node.active{color:#0b5a51;background:#dceee9;border-color:var(--cyan)}.camera-node.offline{color:#867b8f;background:#e8e2ee;border-color:#c6bacd}.camera-node.offline:before{background:#9c91a2}\n.track-line:before{background:#cbbfd8}.grid-lines{background:repeating-linear-gradient(90deg,transparent 0,transparent calc(20% - 1px),rgba(106,89,122,.16) calc(20% - 1px),rgba(106,89,122,.16) 20%)}.marker{color:var(--ink-2);background:var(--surface-2);border-color:#bcaecc;box-shadow:0 3px 8px rgba(85,62,110,.12)}.marker.high{color:#1d6b54;background:var(--green-soft);border-color:#82b7a6}.marker.selected{color:#0b5a51;background:#dceee9;border-color:var(--cyan);box-shadow:0 0 0 2px rgba(15,111,99,.12)}.gap-note{color:var(--faint);background:var(--surface-2)}\n.alert-item:hover,.alert-item.selected,.queue-item:hover,.queue-item.active,.evidence-row:hover,.event-tile:hover,.event-tile.selected,.ledger-row:hover,.ledger-row.selected{background:var(--panel)}\n.priority{color:var(--red);background:var(--red-soft);border-color:rgba(176,83,63,.3)}.case-chip{color:var(--amber);background:var(--amber-soft);border-color:rgba(168,102,40,.28)}\n.evidence-frame,.result-image,.inspector-image{background:#e6dfef;border-color:var(--line)}.result-card.verified .bbox,.event-tile.verified .event-tile-thumb:after{border-color:var(--green)}\n.video-frame,.feed-image{background:#151b20}.video-controls{background:var(--surface-2)}\n.security-cue{color:var(--green);background:var(--green-soft);border-color:rgba(35,134,111,.2)}\n.toast{color:var(--ink-2);background:var(--surface);border-color:var(--line);box-shadow:var(--shadow)}.toast svg{color:var(--cyan)}\n.map-route path,.route-svg path{stroke:var(--cyan)!important}.map-route circle,.route-svg circle{stroke:var(--surface)!important}\n.panel[style*=\"background:#0d151c\"]{background:var(--surface-2)!important}\n</style>\n<div class=\"trace-app\" data-kid=\"1\" id=\"traceApp\">\n    <aside class=\"rail\" data-kid=\"1-1\" data-name=\"navigation rail\">\n        <div class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand container\">\n            <div class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand mark\">\n                <i data-kid=\"1-1-1-1-1\" data-lucide=\"crosshair\" data-name=\"crosshair icon\">\n                </i>\n            </div>\n            <div data-kid=\"1-1-1-2\" data-name=\"brand text container\">\n                <div class=\"brand-name\" data-kid=\"1-1-1-2-1\" data-name=\"brand name\">\n                    TRACE\n                </div>\n                <div class=\"brand-sub\" data-kid=\"1-1-1-2-2\" data-name=\"brand subtitle\">\n                    AI investigation\n                </div>\n            </div>\n        </div>\n        <div class=\"rail-label\" data-kid=\"1-1-2\" data-name=\"operations label\">\n            Operations\n        </div>\n        <nav aria-label=\"Primary navigation\" class=\"nav\" data-kid=\"1-1-3\" data-name=\"primary navigation menu\">\n            <button class=\"nav-item active\" data-kid=\"1-1-3-1\" data-name=\"dashboard navigation item\" data-view=\"dashboard\">\n                <i data-kid=\"1-1-3-1-1\" data-lucide=\"layout-dashboard\" data-name=\"dashboard icon\">\n                </i>\n                <span data-kid=\"1-1-3-1-2\" data-name=\"dashboard label\">\n                    Dashboard\n                </span>\n            </button>\n            <button class=\"nav-item\" data-kid=\"1-1-3-2\" data-name=\"missing persons navigation item\" data-view=\"cases\">\n                <i data-kid=\"1-1-3-2-1\" data-lucide=\"user-search\" data-name=\"missing persons icon\">\n                </i>\n                <span data-kid=\"1-1-3-2-2\" data-name=\"missing persons label\">\n                    Missing Persons\n                </span>\n                <b class=\"nav-badge\" data-kid=\"1-1-3-2-3\" data-name=\"missing persons alert badge\">\n                    12\n                </b>\n            </button>\n            <button class=\"nav-item\" data-kid=\"1-1-3-3\" data-name=\"cctv search navigation item\" data-view=\"workspace\">\n                <i data-kid=\"1-1-3-3-1\" data-lucide=\"scan-search\" data-name=\"cctv search icon\">\n                </i>\n                <span data-kid=\"1-1-3-3-2\" data-name=\"cctv search label\">\n                    CCTV Search\n                </span>\n            </button>\n            <button class=\"nav-item\" data-kid=\"1-1-3-4\" data-name=\"live cameras navigation item\" data-view=\"live\">\n                <i data-kid=\"1-1-3-4-1\" data-lucide=\"video\" data-name=\"live cameras icon\">\n                </i>\n                <span data-kid=\"1-1-3-4-2\" data-name=\"live cameras label\">\n                    Live Cameras\n                </span>\n            </button>\n            <button class=\"nav-item\" data-kid=\"1-1-3-5\" data-name=\"movement timeline navigation item\" data-view=\"timeline\">\n                <i data-kid=\"1-1-3-5-1\" data-lucide=\"route\" data-name=\"movement timeline icon\">\n                </i>\n                <span data-kid=\"1-1-3-5-2\" data-name=\"movement timeline label\">\n                    Movement Timeline\n                </span>\n            </button>\n            <button class=\"nav-item\" data-kid=\"1-1-3-6\" data-name=\"alerts navigation item\" data-view=\"alerts\">\n                <i data-kid=\"1-1-3-6-1\" data-lucide=\"bell\" data-name=\"alerts icon\">\n                </i>\n                <span data-kid=\"1-1-3-6-2\" data-name=\"alerts label\">\n                    Alerts\n                </span>\n                <b class=\"nav-badge\" data-kid=\"1-1-3-6-3\" data-name=\"alerts alert badge\">\n                    06\n                </b>\n            </button>\n            <button class=\"nav-item\" data-kid=\"1-1-3-7\" data-name=\"cases and investigations navigation item\" data-view=\"workspace\">\n                <i data-kid=\"1-1-3-7-1\" data-lucide=\"briefcase-business\" data-name=\"cases and investigations icon\">\n                </i>\n                <span data-kid=\"1-1-3-7-2\" data-name=\"cases and investigations label\">\n                    Cases & Investigations\n                </span>\n            </button>\n            <button class=\"nav-item\" data-kid=\"1-1-3-8\" data-name=\"reports navigation item\" data-view=\"report\">\n                <i data-kid=\"1-1-3-8-1\" data-lucide=\"file-text\" data-name=\"reports icon\">\n                </i>\n                <span data-kid=\"1-1-3-8-2\" data-name=\"reports label\">\n                    Reports\n                </span>\n            </button>\n            <button class=\"nav-item\" data-kid=\"1-1-3-9\" data-name=\"camera network navigation item\" data-view=\"network\">\n                <i data-kid=\"1-1-3-9-1\" data-lucide=\"network\" data-name=\"camera network icon\">\n                </i>\n                <span data-kid=\"1-1-3-9-2\" data-name=\"camera network label\">\n                    Camera Network\n                </span>\n            </button>\n            <button class=\"nav-item\" data-kid=\"1-1-3-10\" data-name=\"settings navigation item\" data-view=\"settings\">\n                <i data-kid=\"1-1-3-10-1\" data-lucide=\"settings\" data-name=\"settings icon\">\n                </i>\n                <span data-kid=\"1-1-3-10-2\" data-name=\"settings label\">\n                    Settings\n                </span>\n            </button>\n        </nav>\n        <div class=\"rail-spacer\" data-kid=\"1-1-4\" data-name=\"rail spacer\">\n        </div>\n        <div class=\"system-block\" data-kid=\"1-1-5\" data-name=\"system status block\">\n            <div class=\"system-status\" data-kid=\"1-1-5-1\" data-name=\"system status indicator\">\n                <span class=\"status-dot\" data-kid=\"1-1-5-1-1\" data-name=\"status dot icon\">\n                </span>\n                System operational\n            </div>\n            <div class=\"operator\" data-kid=\"1-1-5-2\" data-name=\"operator profile block\">\n                <div class=\"avatar\" data-kid=\"1-1-5-2-1\" data-name=\"operator avatar\">\n                    OS\n                </div>\n                <div class=\"operator-copy\" data-kid=\"1-1-5-2-2\" data-name=\"operator info container\">\n                    <div class=\"operator-name\" data-kid=\"1-1-5-2-2-1\" data-name=\"operator name\">\n                        Omar Siddiqui\n                    </div>\n                    <div class=\"operator-role\" data-kid=\"1-1-5-2-2-2\" data-name=\"operator role\">\n                        Authorized operator\n                    </div>\n                </div>\n                <i data-kid=\"1-1-5-2-3\" data-lucide=\"chevron-down\" data-name=\"chevron down icon\" style=\"width:14px;height:14px;color:#627583\">\n                </i>\n            </div>\n        </div>\n    </aside>\n    <main class=\"app-main\" data-kid=\"1-2\" data-name=\"main content area\">\n        <header class=\"topbar\" data-kid=\"1-2-1\" data-name=\"topbar container\">\n            <div class=\"crumbs\" data-kid=\"1-2-1-1\" data-name=\"breadcrumbs container\">\n                <span data-kid=\"1-2-1-1-1\" data-name=\"breadcrumb root\">\n                    TRACE\n                </span>\n                <i data-kid=\"1-2-1-1-2\" data-lucide=\"chevron-right\" data-name=\"breadcrumb separator icon\">\n                </i>\n                <strong data-kid=\"1-2-1-1-3\" data-name=\"breadcrumb active page label\" id=\"crumbLabel\">\n                    Command center\n                </strong>\n            </div>\n            <label class=\"global-search\" data-kid=\"1-2-1-2\" data-name=\"global search input\">\n                <i data-kid=\"1-2-1-2-1\" data-lucide=\"search\" data-name=\"search icon\">\n                </i>\n                <input aria-label=\"Global search\" data-kid=\"1-2-1-2-2\" data-name=\"global search input field\" placeholder=\"Search person, case or camera...\"/>\n            </label>\n            <div class=\"top-actions\" data-kid=\"1-2-1-3\" data-name=\"top actions container\">\n                <span class=\"clock\" data-dynamic=\"true\" data-kid=\"1-2-1-3-1\" data-name=\"clock display\" data-reason=\"text updated every second\">\n                    Thu, 10 Sep 2026 · 14:34:16\n                </span>\n                <button class=\"top-action\" data-kid=\"1-2-1-3-2\" data-name=\"notification bell button\" data-view=\"alerts\" title=\"Notifications\">\n                    <i data-kid=\"1-2-1-3-2-1\" data-lucide=\"bell\" data-name=\"notification bell icon\">\n                    </i>\n                    <span class=\"notify-badge\" data-kid=\"1-2-1-3-2-2\" data-name=\"notification count badge\">\n                        6\n                    </span>\n                </button>\n                <div class=\"top-profile\" data-kid=\"1-2-1-3-3\" data-name=\"user profile container\">\n                    <div class=\"avatar\" data-kid=\"1-2-1-3-3-1\" data-name=\"user avatar\">\n                        OS\n                    </div>\n                    <span data-kid=\"1-2-1-3-3-2\" data-name=\"user label\">\n                        Operator\n                    </span>\n                </div>\n            </div>\n        </header>\n        <div class=\"case-strip\" data-kid=\"1-2-2\" data-name=\"case context strip\">\n            <div class=\"case-context\" data-kid=\"1-2-2-1\" data-name=\"case identification block\">\n                <i data-kid=\"1-2-2-1-1\" data-lucide=\"folder-open\" data-name=\"case folder icon\">\n                </i>\n                <span class=\"case-id\" data-kid=\"1-2-2-1-2\" data-name=\"case id text\">\n                    MP-2026-014\n                </span>\n                <span class=\"case-name\" data-kid=\"1-2-2-1-3\" data-name=\"case name text\">\n                    Rahul Sharma · Active investigation\n                </span>\n            </div>\n            <div class=\"case-strip-tools\" data-kid=\"1-2-2-2\" data-name=\"case view selector\">\n                <button class=\"case-tab active\" data-case-view=\"workspace\" data-kid=\"1-2-2-2-1\" data-name=\"workspace tab\">\n                    Workspace\n                </button>\n                <button class=\"case-tab\" data-case-view=\"results\" data-kid=\"1-2-2-2-2\" data-name=\"potential matches tab\">\n                    Potential matches\n                </button>\n                <button class=\"case-tab\" data-case-view=\"timeline\" data-kid=\"1-2-2-2-3\" data-name=\"movement timeline tab\">\n                    Movement timeline\n                </button>\n                <button class=\"case-tab\" data-case-view=\"report\" data-kid=\"1-2-2-2-4\" data-name=\"report tab\">\n                    Report\n                </button>\n            </div>\n        </div>\n        <section class=\"view-root\" data-dynamic=\"true\" data-kid=\"1-2-3\" data-name=\"main view container\" data-reason=\"content rendered based on application state\" id=\"viewRoot\">\n        </section>\n    </main>\n    <div aria-live=\"polite\" class=\"toast-stack\" data-dynamic=\"true\" data-kid=\"1-3\" data-name=\"toast notification stack\" data-reason=\"notifications appended dynamically\" id=\"toastStack\">\n    </div>\n</div>\n<script src=\"https://unpkg.com/lucide@latest/dist/umd/lucide.js\">\n</script>\n<script>\n    const ASSETS={portrait:'https://images.pexels.com/photos/17009459/pexels-photo-17009459.jpeg?auto=compress&cs=tinysrgb&w=420&q=80',cctvA:'https://images.unsplash.com/photo-1695353859100-6ea1d1e11a02?auto=format&w=900&q=80&fit=crop',cctvB:'https://images.pexels.com/photos/10640272/pexels-photo-10640272.jpeg?auto=compress&cs=tinysrgb&w=900&q=80',cctvC:'https://images.pexels.com/photos/9118047/pexels-photo-9118047.jpeg?auto=compress&cs=tinysrgb&w=900&q=80',cctvD:'https://images.pexels.com/photos/15194878/pexels-photo-15194878.jpeg?auto=compress&cs=tinysrgb&w=900&q=80',urban:'https://images.unsplash.com/photo-1537060212308-fed629cd72df?auto=format&w=1200&q=80&fit=crop'};\nconst sightings=[\n{id:'s1',confidence:95,time:'11:17:04',camera:'CAM-034',location:'Main Gate',src:ASSETS.cctvA,level:'high'},\n{id:'s2',confidence:92,time:'14:32:08',camera:'CAM-034',location:'Main Gate',src:ASSETS.cctvB,level:'high'},\n{id:'s3',confidence:89,time:'11:26:31',camera:'CAM-041',location:'Market Road',src:ASSETS.cctvC,level:'medium'},\n{id:'s4',confidence:87,time:'10:42:12',camera:'CAM-012',location:'North Entrance',src:ASSETS.cctvD,level:'medium'},\n{id:'s5',confidence:81,time:'11:03:48',camera:'CAM-018',location:'Parking Area',src:ASSETS.cctvA,level:'medium'},\n{id:'s6',confidence:68,time:'12:14:23',camera:'CAM-052',location:'South Exit',src:ASSETS.cctvC,level:'low'}\n];\nconst state={view:'dashboard',selected:'s2',search:'idle',step:1,verified:new Set(),timeline:new Set(['s1','s3']),bookmarked:false,report:'ready',note:''};\nconst root=document.getElementById('viewRoot');\nconst img=(src,alt,cls='')=>`<img class=\"${cls}\" src=\"${src}\" alt=\"${alt}\" decoding=\"async\" loading=\"lazy\" />`;\nconst icon=(name)=>`<i data-lucide=\"${name}\"></i>`;\nfunction confidenceBadge(s){return `<span class=\"confidence ${s.level==='high'?'high':s.level==='low'?'low':''}\">${s.confidence}% ${s.level==='high'?'high':s.level==='medium'?'medium':'low'}</span>`}\nfunction sight(id){return sightings.find(s=>s.id===id)||sightings[1]}\nfunction isVerified(id){return state.verified.has(id)}\nfunction statusLabel(id){return isVerified(id)?'<span class=\"case-chip\" style=\"color:var(--green);background:var(--green-soft);border-color:rgba(88,183,131,.25)\"><span class=\"status-dot\"></span>Verified by operator</span>':'<span class=\"case-chip\"><span class=\"status-dot\"></span>Requires verification</span>'}\nfunction imageFrame(s,extra=''){return `<div class=\"evidence-frame ${extra}\">${img(s.src,`Fictional CCTV frame from ${s.camera}, ${s.location}; source attribution from Unsplash or Pexels`)}<span class=\"bbox\"></span></div>`}\nfunction navTitle(view){return {dashboard:'Command center',cases:'Missing persons',create:'Create missing person case',workspace:'Investigation workspace',results:'Potential matches',timeline:'Movement timeline',evidence:'Camera evidence',live:'Live cameras',alerts:'Alerts',report:'Investigation report',network:'Camera network',settings:'Settings'}[view]||'Command center'}\nfunction render(){document.getElementById('crumbLabel').textContent=navTitle(state.view);document.querySelectorAll('.nav-item').forEach(n=>n.classList.toggle('active',n.dataset.view===state.view||((state.view==='create'||state.view==='results'||state.view==='evidence')&&n.dataset.view==='workspace')||(state.view==='report'&&n.dataset.view==='report')||(state.view==='cases'&&n.dataset.view==='cases')));document.querySelectorAll('.case-tab').forEach(n=>n.classList.toggle('active',n.dataset.caseView===state.view||(state.view==='evidence'&&n.dataset.caseView==='results')));const views={dashboard:dashboard,cases:cases,create:createCase,workspace:workspace,results:results,timeline:timeline,evidence:evidence,live:live,alerts:alerts,report:report,network:network,settings:settings};root.innerHTML=(views[state.view]||dashboard)();if(window.lucide)window.lucide.createIcons({attrs:{'stroke-width':1.8}})}\nfunction header(eyebrow,title,subtitle,actions=''){return `<div class=\"view-header\"><div><div class=\"eyebrow\">${eyebrow}</div><h1 class=\"view-title\">${title}</h1><p class=\"view-subtitle\">${subtitle}</p></div><div class=\"header-actions\">${actions}</div></div>`}\nfunction dashboard(){return header('Command center','Good afternoon, Operator','Monitor active investigations and recent AI detections.',`<span class=\"live-label\"><span class=\"status-dot\"></span>System operational</span>`)+`<div class=\"readout\"><div class=\"readout-cell\"><div class=\"readout-label\">Active missing persons</div><div class=\"readout-value\">12 <small>cases</small></div><div class=\"readout-note\">3 require review today</div></div><div class=\"readout-cell\"><div class=\"readout-label\">AI matches today</div><div class=\"readout-value\">47</div><div class=\"readout-note\">Similarity estimates · not identity confirmation</div></div><div class=\"readout-cell\"><div class=\"readout-label\">Cameras online</div><div class=\"readout-value\">128 <small>/ 132</small></div><div class=\"readout-note\"><span class=\"text-green\">+2 since 12:00</span></div></div><div class=\"readout-cell\"><div class=\"readout-label\">Active alerts</div><div class=\"readout-value text-amber\">06</div><div class=\"readout-note\">2 high priority</div></div></div><div class=\"dashboard-grid\"><div class=\"panel evidence-board\"><div class=\"panel-header\"><div><div class=\"panel-title\">Evidence timeboard</div><div class=\"panel-kicker\">Selected case · MP-2026-014 · probable detections</div></div><div class=\"board-tools\"><span class=\"live-label\"><span class=\"status-dot\"></span>Live queue</span><select class=\"select\" aria-label=\"Timeboard range\"><option>Today · 10:00–15:00</option></select></div></div><div class=\"timeboard\"><div class=\"time-axis\"><span>10:00</span><span>11:00</span><span>12:00</span><span>13:00</span><span>14:00</span><span>15:00</span></div><div class=\"tracks\"><div class=\"grid-lines\"></div><div class=\"track-row\"><div class=\"track-label\">${icon('user')} Rahul</div><div class=\"track-line\"><button class=\"marker high\" style=\"left:26%\" data-action=\"select-sighting\" data-id=\"s4\">10:42 · 87%</button><button class=\"marker high\" style=\"left:43%\" data-action=\"select-sighting\" data-id=\"s5\">11:03 · 81%</button><button class=\"marker high\" style=\"left:58%\" data-action=\"select-sighting\" data-id=\"s1\">11:17 · 95%</button><button class=\"marker selected\" style=\"left:86%\" data-action=\"select-sighting\" data-id=\"s2\">14:32 · 92%</button></div></div><div class=\"track-row\"><div class=\"track-label\">${icon('video')} CAM-034</div><div class=\"track-line\"><button class=\"marker selected\" style=\"left:86%\" data-action=\"open-evidence\" data-id=\"s2\">14:32:08</button><span class=\"gap-note\">2h 44m · no reviewed frames</span></div></div><div class=\"track-row\"><div class=\"track-label\">${icon('video')} CAM-041</div><div class=\"track-line\"><button class=\"marker high\" style=\"left:60%\" data-action=\"select-sighting\" data-id=\"s3\">11:26 · 89%</button></div></div><div class=\"track-row\"><div class=\"track-label\">${icon('video')} CAM-012</div><div class=\"track-line\"><button class=\"marker\" style=\"left:27%\" data-action=\"select-sighting\" data-id=\"s4\">10:42 · 87%</button></div></div></div></div></div><div class=\"panel alert-panel\"><div class=\"panel-header\"><div><div class=\"panel-title\">Priority alerts</div><div class=\"panel-kicker\">Review queue · 06 unresolved</div></div><button class=\"btn btn-quiet btn-sm\" data-view=\"alerts\">View all ${icon('arrow-right')}</button></div><div class=\"alert-list\"><div class=\"alert-item selected\" data-action=\"open-case\"><span class=\"severity high\"></span><div class=\"alert-copy\"><div class=\"alert-heading\">High confidence match <span class=\"alert-time\">14:32:08</span></div><div class=\"alert-meta\"><b>92% similarity estimate</b><br/>MP-2026-014 · CAM-034 · Main Gate</div><div class=\"alert-foot\"><span>Requires verification</span><span class=\"alert-link\">Investigate ${icon('arrow-up-right')}</span></div></div></div><div class=\"alert-item\"><span class=\"severity\"></span><div class=\"alert-copy\"><div class=\"alert-heading\">Medium confidence match <span class=\"alert-time\">13:18:44</span></div><div class=\"alert-meta\"><b>81% similarity estimate</b><br/>MP-2026-011 · CAM-021 · Parking Area</div><div class=\"alert-foot\"><span>Review queued</span><span class=\"alert-link\">Open case</span></div></div></div><div class=\"alert-item\" data-view=\"network\"><span class=\"severity high\"></span><div class=\"alert-copy\"><div class=\"alert-heading\">Camera offline <span class=\"alert-time\">11 min ago</span></div><div class=\"alert-meta\"><b>CAM-087</b><br/>South campus · last active 14:23:02</div><div class=\"alert-foot\"><span>Source footage may be unavailable</span><span class=\"alert-link\">Open network</span></div></div></div><div class=\"alert-item\"><span class=\"severity green\"></span><div class=\"alert-copy\"><div class=\"alert-heading\">Investigation update <span class=\"alert-time\">12:08:10</span></div><div class=\"alert-meta\"><b>3 frames added to timeline</b><br/>MP-2026-014 · Operator review</div><div class=\"alert-foot\"><span>Audit trail recorded</span><span class=\"alert-link\">View case</span></div></div></div></div></div></div><div class=\"dashboard-bottom\"><div class=\"panel camera-map\"><div class=\"panel-header\"><div><div class=\"panel-title\">Active camera network</div><div class=\"panel-kicker\">Map view · selected case route context</div></div><button class=\"btn btn-quiet btn-sm\" data-view=\"network\">Camera network ${icon('arrow-right')}</button></div><div class=\"map-surface\"><span class=\"map-label bus\">Central bus station</span><span class=\"map-label parking\">Parking area</span><span class=\"map-label gate\">Main gate</span><span class=\"map-label market\">Market road</span><svg class=\"map-route\" viewBox=\"0 0 900 180\" preserveAspectRatio=\"none\"><path d=\"M120 125 C220 100 275 130 375 87 S535 54 610 98 S760 122 820 77\" fill=\"none\" stroke=\"#36b8d9\" stroke-width=\"2\" stroke-dasharray=\"5 4\" opacity=\".9\"/><circle cx=\"120\" cy=\"125\" r=\"4\" fill=\"#58b783\"/><circle cx=\"375\" cy=\"87\" r=\"4\" fill=\"#58b783\"/><circle cx=\"610\" cy=\"98\" r=\"4\" fill=\"#36b8d9\"/><circle cx=\"820\" cy=\"77\" r=\"4\" fill=\"#d5a64a\"/></svg><button class=\"camera-node cam21\" data-action=\"select-sighting\" data-id=\"s5\">CAM-021</button><button class=\"camera-node cam34 match\" data-action=\"open-evidence\" data-id=\"s2\">CAM-034 · 92%</button><button class=\"camera-node cam41 active\" data-action=\"select-sighting\" data-id=\"s3\">CAM-041</button><button class=\"camera-node cam52 offline\" data-view=\"network\">CAM-052</button></div><div class=\"map-legend\"><span class=\"legend-item\"><i class=\"legend-dot\"></i>Online</span><span class=\"legend-item\"><i class=\"legend-dot green\"></i>Probable match</span><span class=\"legend-item\"><i class=\"legend-dot gray\"></i>Offline</span><span class=\"faint\">Click a camera node to inspect source footage</span></div></div><div class=\"panel recent-strip\"><div class=\"panel-header\"><div><div class=\"panel-title\">Recent AI detections</div><div class=\"panel-kicker\">Evidence tape · last 4 hours</div></div><button class=\"btn btn-quiet btn-sm\" data-view=\"results\">Review all ${icon('arrow-right')}</button></div><div class=\"detection-list\">${sightings.slice(0,3).map(s=>`<div class=\"detection-item\" data-action=\"open-evidence\" data-id=\"${s.id}\">${imageFrame(s,'detection-thumb')}<div class=\"detection-copy\"><div class=\"detection-title\">${s.camera} · ${s.location}</div><div class=\"detection-meta\">${s.time} · 10 Sep 2026</div></div>${confidenceBadge(s)}</div>`).join('')}</div></div></div>`}\nfunction cases(){return header('Case management','Missing persons','Manage active cases and search CCTV footage for probable sightings.',`<button class=\"btn btn-primary\" data-action=\"new-case\">${icon('plus')} New missing person</button>`)+`<div class=\"toolbar\"><div class=\"toolbar-left\"><label class=\"input-wrap\">${icon('search')}<input class=\"input\" placeholder=\"Search by name, case ID, location...\" aria-label=\"Search cases\" /></label><select class=\"select filter\"><option>Status · All</option></select><select class=\"select filter\"><option>Date missing</option></select><select class=\"select filter\"><option>Priority</option></select><select class=\"select filter\"><option>Gender</option></select><select class=\"select filter\"><option>Age</option></select></div><span class=\"faint\" style=\"font-size:9px\">12 active cases</span></div><div class=\"panel case-ledger\"><div class=\"ledger-head\"><span>Person</span><span>Identity</span><span>Last known</span><span>Missing since</span><span>Priority / status</span><span>Matches</span><span>Action</span></div><div class=\"ledger-row selected\" data-action=\"open-case\"><div class=\"person-thumb\">${img(ASSETS.portrait,'Rahul Sharma fictional case portrait; photo by Vika Glitter on Pexels')}</div><div><div class=\"person-name\">Rahul Sharma</div><div class=\"person-id\">MP-2026-014</div><div class=\"meta-value\">17 years · Male</div><div class=\"micro-strip\">${sightings.slice(0,3).map(s=>`<span class=\"micro\">${img(s.src,`CCTV micro-frame from ${s.camera}`)}</span>`).join('')}</div></div><div><div class=\"meta-label\">Last seen location</div><div class=\"meta-value\">Central Bus Station</div><div class=\"meta-label\" style=\"margin-top:6px\">Last seen</div><div class=\"meta-value mono\">10 Sep · 14:32</div></div><div><div class=\"meta-label\">Date missing</div><div class=\"meta-value mono\">10 Sep 2026</div></div><div><span class=\"priority\">HIGH</span><div class=\"status-line\" style=\"margin-top:7px\"><span class=\"status-dot\"></span>Investigation active</div></div><div><div class=\"match-count\">47<small>potential</small></div></div><div><button class=\"btn btn-sm btn-primary\" data-action=\"open-case\">Open case ${icon('arrow-right')}</button></div></div><div class=\"ledger-row\"><div class=\"person-thumb\">${img(ASSETS.portrait,'Fictional missing person portrait; photo by Vika Glitter on Pexels')}</div><div><div class=\"person-name\">Nadia Petrov</div><div class=\"person-id\">MP-2026-011</div><div class=\"meta-value\">28 years · Female</div><div class=\"micro-strip\"><span class=\"micro\">${img(ASSETS.cctvC,'CCTV micro-frame')}</span><span class=\"micro\">${img(ASSETS.cctvD,'CCTV micro-frame')}</span></div></div><div><div class=\"meta-label\">Last seen location</div><div class=\"meta-value\">East Parking Area</div><div class=\"meta-label\" style=\"margin-top:6px\">Last seen</div><div class=\"meta-value mono\">09 Sep · 13:18</div></div><div><div class=\"meta-label\">Date missing</div><div class=\"meta-value mono\">09 Sep 2026</div></div><div><span class=\"priority\" style=\"color:var(--amber);background:var(--amber-soft);border-color:rgba(213,166,74,.28)\">MEDIUM</span><div class=\"status-line\" style=\"color:var(--amber);margin-top:7px\"><span class=\"status-dot\"></span>Review queued</div></div><div><div class=\"match-count\">12<small>potential</small></div></div><div><button class=\"btn btn-sm\" data-action=\"open-case\">Open case ${icon('arrow-right')}</button></div></div><div class=\"ledger-row\"><div class=\"person-thumb\">${img(ASSETS.portrait,'Fictional missing person portrait; photo by Vika Glitter on Pexels')}</div><div><div class=\"person-name\">Eliot Morgan</div><div class=\"person-id\">MP-2026-008</div><div class=\"meta-value\">34 years · Male</div></div><div><div class=\"meta-label\">Last seen location</div><div class=\"meta-value\">North Transit Hub</div></div><div><div class=\"meta-label\">Date missing</div><div class=\"meta-value mono\">07 Sep 2026</div></div><div><span class=\"priority\" style=\"color:var(--muted);background:#172128;border-color:var(--line)\">LOW</span><div class=\"status-line\" style=\"color:var(--muted);margin-top:7px\"><span class=\"status-dot\"></span>Monitoring</div></div><div><div class=\"match-count\">04<small>potential</small></div></div><div><button class=\"btn btn-sm\" data-action=\"open-case\">Open case ${icon('arrow-right')}</button></div></div></div>`}\nfunction createCase(){const steps=[['01','Person details'],['02','Last known information'],['03','Search configuration'],['04','Review case']];let content='';if(state.step===1)content=`<div class=\"form-section-title\">Person details</div><div class=\"form-section-help\">Register the subject using a clear front-facing reference photo. All fields are protected by the investigation audit trail.</div><div class=\"upload-zone\">${icon('upload-cloud')}<strong>Upload clear face photograph</strong><span>Front-facing photo preferred · JPG or PNG · Max 10 MB</span><button class=\"btn btn-sm\">Choose image</button></div><div class=\"form-grid\"><label class=\"form-group\"><span class=\"form-label\">Full name <em>*</em></span><input class=\"form-control\" value=\"Rahul Sharma\" /></label><label class=\"form-group\"><span class=\"form-label\">Age <em>*</em></span><input class=\"form-control\" value=\"17\" /></label><label class=\"form-group\"><span class=\"form-label\">Gender</span><select class=\"form-control\"><option>Male</option></select></label><label class=\"form-group\"><span class=\"form-label\">Height</span><input class=\"form-control\" value=\"172 cm\" /></label><label class=\"form-group wide\"><span class=\"form-label\">Clothing at last sighting</span><input class=\"form-control\" value=\"Navy hoodie, charcoal trousers, white sneakers\" /></label><label class=\"form-group wide\"><span class=\"form-label\">Distinguishing features</span><textarea class=\"form-control\">Small scar above right eyebrow. Black hair. Slim build.</textarea></label></div>`;if(state.step===2)content=`<div class=\"form-section-title\">Last known information</div><div class=\"form-section-help\">Anchor the search to the last verified moment and location. Route details guide camera coverage but do not imply a confirmed movement path.</div><div class=\"form-grid\"><label class=\"form-group\"><span class=\"form-label\">Last seen location <em>*</em></span><input class=\"form-control\" value=\"Central Bus Station\" /></label><label class=\"form-group\"><span class=\"form-label\">Date <em>*</em></span><input class=\"form-control\" value=\"10 Sep 2026\" /></label><label class=\"form-group\"><span class=\"form-label\">Time <em>*</em></span><input class=\"form-control\" value=\"10:36\" /></label><label class=\"form-group\"><span class=\"form-label\">Search radius</span><select class=\"form-control\"><option>2 km around location</option></select></label><div class=\"form-group wide\"><span class=\"form-label\">Last-known area</span><div class=\"map-mini\"><span class=\"map-label bus\">Central Bus Station</span><span class=\"map-label parking\">Parking Area</span><span class=\"map-label gate\">Main Gate</span><span class=\"pin\"></span><button class=\"camera-node cam21\">CAM-021</button><button class=\"camera-node cam34 match\">CAM-034</button></div></div><label class=\"form-group wide\"><span class=\"form-label\">Known routes</span><input class=\"form-control\" value=\"North entrance → bus station → Main Gate\" /></label><label class=\"form-group wide\"><span class=\"form-label\">Additional information</span><textarea class=\"form-control\" placeholder=\"Add context for investigators\"></textarea></label></div>`;if(state.step===3)content=`<div class=\"form-section-title\">Search configuration</div><div class=\"form-section-help\">Define the footage window and camera coverage for this search. Similarity is a probabilistic review signal, not identity confirmation.</div><div class=\"form-grid\"><label class=\"form-group\"><span class=\"form-label\">Search date range</span><input class=\"form-control\" value=\"10 Sep 2026 — 10 Sep 2026\" /></label><label class=\"form-group\"><span class=\"form-label\">Search time range</span><input class=\"form-control\" value=\"10:00 — 15:00\" /></label><label class=\"form-group\"><span class=\"form-label\">Minimum AI confidence</span><select class=\"form-control\"><option>75% · Requires verification</option></select></label><label class=\"form-group\"><span class=\"form-label\">Camera groups</span><select class=\"form-control\"><option>Transit perimeter · 12 cameras</option></select></label><label class=\"form-group wide\"><span class=\"form-label\">Camera zones</span><div style=\"display:grid;grid-template-columns:repeat(2,1fr);gap:7px\"><button class=\"btn\" style=\"justify-content:flex-start\">${icon('check-circle-2')} North entrance · 4</button><button class=\"btn\" style=\"justify-content:flex-start\">${icon('check-circle-2')} Transit core · 5</button><button class=\"btn\" style=\"justify-content:flex-start\">${icon('check-circle-2')} South exit · 3</button><button class=\"btn btn-quiet\" style=\"justify-content:flex-start\">${icon('circle')} Other zones</button></div></label><label class=\"form-group wide\" style=\"flex-direction:row;align-items:center;gap:8px\"><input type=\"checkbox\" checked /><span class=\"form-label\" style=\"color:#d3e0e5\">Search all available cameras <small style=\"display:block;color:var(--faint);font-weight:400\">Includes 128 online cameras within the selected time range.</small></span></label></div>`;if(state.step===4)content=`<div class=\"form-section-title\">Review case</div><div class=\"form-section-help\">Review the case record and search scope before creating the investigation. The first search can be refined later.</div><div class=\"panel\" style=\"background:#0d151c\"><div class=\"draft-row\"><span>Person</span><strong>Rahul Sharma · 17 years</strong></div><div class=\"draft-row\"><span>Reference image</span><strong class=\"complete\">Selected · front-facing photo</strong></div><div class=\"draft-row\"><span>Last known moment</span><strong>Central Bus Station · 10 Sep · 10:36</strong></div><div class=\"draft-row\"><span>Search scope</span><strong>10 Sep · 10:00–15:00 · 128 cameras</strong></div><div class=\"draft-row\"><span>Review threshold</span><strong>75% minimum confidence</strong></div></div><div class=\"security-cue\" style=\"margin-top:14px\">${icon('shield-check')} Potential detections will be recorded as reviewable evidence. Only operator-verified matches will appear as verified evidence.</div>`;return header('New investigation','Create missing person case','Build a defensible case record before TRACE generates a review queue.',`<span class=\"case-chip\"><span class=\"status-dot\"></span>Draft case</span>`)+`<div class=\"stepper\">${steps.map((s,i)=>`<button class=\"step ${state.step===i+1?'active':''} ${state.step>i+1?'done':''}\" data-step=\"${i+1}\"><span class=\"step-number\">${state.step>i+1?'✓':s[0]}</span><span class=\"step-copy\"><strong>${s[1]}</strong><span>${state.step>i+1?'Complete':state.step===i+1?'Current step':'Not started'}</span></span></button>`).join('')}</div><div class=\"create-grid\"><div class=\"panel form-panel\">${content}<div class=\"form-footer\">${state.step>1?'<button class=\"btn\" data-action=\"prev-step\">Back</button>':''}${state.step<4?'<button class=\"btn btn-primary\" data-action=\"next-step\">Continue '+icon('arrow-right')+'</button>':'<button class=\"btn btn-primary\" data-action=\"create-case\">Create case &amp; start CCTV search '+icon('arrow-right')+'</button>'}</div></div><aside class=\"panel draft\"><div class=\"panel-header\"><div><div class=\"panel-title\">Case draft</div><div class=\"panel-kicker\">MP-2026-014 · working record</div></div>${icon('clipboard-check')}</div><div class=\"draft-list\"><div class=\"draft-row\"><span>Person photo</span><strong class=\"complete\">Ready</strong></div><div class=\"draft-row\"><span>Person details</span><strong class=\"complete\">Complete</strong></div><div class=\"draft-row\"><span>Last-known moment</span><strong class=\"${state.step>=2?'complete':''}\">${state.step>=2?'Complete':'Pending'}</strong></div><div class=\"draft-row\"><span>Camera coverage</span><strong class=\"${state.step>=3?'complete':''}\">${state.step>=3?'128 cameras':'Pending'}</strong></div><div class=\"draft-row\"><span>Review threshold</span><strong class=\"${state.step>=3?'complete':''}\">${state.step>=3?'75%':'Pending'}</strong></div></div><div style=\"padding:14px\"><div class=\"panel-kicker\" style=\"margin-bottom:7px\">Last-known area preview</div><div class=\"map-mini\"><span class=\"map-label bus\">Central Bus Station</span><span class=\"map-label gate\">Main Gate</span><span class=\"pin\"></span></div><div class=\"security-cue\">${icon('lock-keyhole')} Authorized access · evidence protected</div></div></aside></div>`}\nfunction workspace(){const s=sight(state.selected);const loading=state.search==='loading';const complete=state.search==='complete';return header('Cases & investigations / MP-2026-014','Missing person investigation','Review a defined search, inspect probable detections, and convert verified frames into a movement timeline.',`<button class=\"btn\" data-view=\"results\">Review potential matches ${icon('arrow-right')}</button>`)+`<div class=\"workspace-header\"><div class=\"workspace-portrait\">${img(ASSETS.portrait,'Rahul Sharma fictional case portrait; photo by Vika Glitter on Pexels')}</div><div class=\"workspace-person\"><h2>Rahul Sharma</h2><p>MP-2026-014 · 17 years · <span class=\"text-green\">Active investigation</span></p></div><div class=\"workspace-meta\"><div><span>Missing since</span><strong>10 Sep 2026</strong></div><div><span>Last known location</span><strong>Central Bus Station</strong></div><div><span>Reference image</span><strong>Front-facing · selected</strong></div></div><div class=\"workspace-actions\"><button class=\"btn btn-primary\" data-action=\"run-search\" ${loading?'disabled':''}>${loading?icon('loader-circle'):'▶'} ${loading?'Searching…':'Run CCTV search'}</button></div></div><div class=\"workspace-grid\"><div class=\"panel\"><div class=\"panel-header\"><div><div class=\"panel-title\">Search configuration</div><div class=\"panel-kicker\">Current coverage</div></div>${icon('sliders-horizontal')}</div><div class=\"config-list\"><div class=\"config-row\"><span>Matching photo</span><strong>Rahul Sharma</strong></div><div class=\"config-row\"><span>Date range</span><strong>10 Sep 2026</strong></div><div class=\"config-row\"><span>Time range</span><strong>10:00 — 15:00</strong></div><div class=\"config-row\"><span>Camera coverage</span><strong>128 / 132 online</strong></div><div class=\"config-row\"><span>Minimum threshold</span><strong>75% confidence</strong></div></div><div style=\"padding:13px\"><div class=\"verification-copy\">Similarity estimates prioritize review order. They are not identity confirmation.</div></div></div><div class=\"panel\"><div class=\"panel-header\"><div><div class=\"panel-title\">AI CCTV search</div><div class=\"panel-kicker\">Evidence sequence · source frames remain reviewable</div></div><span class=\"case-chip\"><span class=\"status-dot\"></span>${complete?'Search complete':'Ready to search'}</span></div><div class=\"panel-body\"><div class=\"search-state\"><div class=\"search-state-copy\"><div class=\"search-state-title\">${loading?({analyzing:'Analyzing CCTV footage…',searching:'Searching 128 cameras…',comparing:'Comparing detected appearances…',building:'Building potential sightings…'}[state.searchStage]||'Processing…'):complete?'47 potential sightings found':'Search selected camera coverage'}</div><div class=\"search-state-sub\">${loading?'TRACE is checking source coverage truthfully; no identity is confirmed automatically.':complete?'47 relevant frames found across 12 cameras · Requires verification':'Run a scoped search across the current date, time, and camera configuration.'}</div></div>${loading?`<span class=\"text-cyan\">${icon('loader-circle')}</span>`:`<span class=\"mono faint\" style=\"font-size:9px\">${complete?'14:32:08 latest':'10 Sep · 10:00–15:00'}</span>`}</div>${complete?`<div class=\"table-label\">Top potential detections · chronological review queue</div><div class=\"evidence-table\">${sightings.slice(0,5).map((x)=>`<div class=\"evidence-row ${state.selected===x.id?'selected':''}\" data-action=\"select-sighting\" data-id=\"${x.id}\">${imageFrame(x)}<div class=\"evidence-copy\"><strong>${x.camera} · ${x.location}</strong><span>${x.time} · 10 Sep 2026</span></div><div class=\"evidence-row-meta\">${x.confidence}%<br/><span class=\"faint\">${x.level}</span></div><div>${statusLabel(x.id)}</div><button class=\"btn btn-quiet btn-sm\" data-action=\"open-evidence\" data-id=\"${x.id}\" title=\"Open source footage\">${icon('external-link')}</button></div>`).join('')}</div>`:`<div style=\"padding:28px 6px 16px;color:var(--faint);text-align:center;font-size:11px\">Search coverage includes CAM-012, CAM-018, CAM-021, CAM-034, CAM-041, CAM-052 and 122 additional cameras.</div>`}</div></div><div class=\"panel summary-panel\"><div class=\"panel-header\"><div><div class=\"panel-title\">Investigation summary</div><div class=\"panel-kicker\">MP-2026-014 · live record</div></div>${icon('activity')}</div><div class=\"summary-list\"><div class=\"summary-row\"><span>Total matches</span><strong>47</strong></div><div class=\"summary-row\"><span>High confidence</span><strong class=\"text-green\">08</strong></div><div class=\"summary-row\"><span>Medium confidence</span><strong class=\"text-amber\">21</strong></div><div class=\"summary-row\"><span>Low confidence</span><strong>18</strong></div><div class=\"summary-row\"><span>Cameras involved</span><strong>12</strong></div><div class=\"summary-row\"><span>First seen</span><strong>10:42</strong></div><div class=\"summary-row\"><span>Last seen</span><strong>14:32</strong></div></div><div class=\"next-review\"><div class=\"next-review-head\">${icon('circle-alert')} Next review</div><p><strong class=\"text-green\">95% probable match</strong> at CAM-034 · Main Gate · 11:17:04.</p><button class=\"btn btn-sm\" data-action=\"open-evidence\" data-id=\"s1\">Open evidence ${icon('arrow-right')}</button></div></div></div>`}\nfunction results(){const s=sight(state.selected);return header('CCTV search / MP-2026-014','47 potential matches','AI similarity estimates require operator verification. Review source frames in chronological camera clusters.',`<button class=\"btn\" data-view=\"workspace\">${icon('arrow-left')} Search workspace</button>`)+`<div class=\"results-layout\"><div><div class=\"results-toolbar\"><select class=\"select\"><option>Confidence · All bands</option></select><select class=\"select\"><option>Camera · All</option></select><select class=\"select\"><option>Location · All</option></select><select class=\"select\"><option>Time · 10:00–15:00</option></select><select class=\"select\"><option>Date · 10 Sep</option></select><span class=\"results-note\">12 of 47 shown · <span class=\"text-amber\">Review order only</span></span></div><div class=\"cluster\"><div class=\"cluster-header\"><span><strong>10:00–12:00</strong> · 4 cameras</span><span>5 potential frames</span></div><div class=\"result-grid\">${sightings.slice(0,3).map(resultCard).join('')}</div></div><div class=\"cluster\"><div class=\"cluster-header\"><span><strong>14:00–15:00</strong> · 3 cameras</span><span>7 potential frames</span></div><div class=\"result-grid\">${sightings.slice(1,5).map(resultCard).join('')}</div></div></div><aside class=\"panel inspector\"><div class=\"panel-header\"><div><div class=\"panel-title\">Evidence inspector</div><div class=\"panel-kicker\">Selected source frame</div></div>${icon('scan-search')}</div>${imageFrame(s,'inspector-image')}<div class=\"inspector-body\"><div class=\"inspector-heading\"><div><h3>${s.camera} · ${s.location}</h3><div class=\"inspector-sub\">${s.time} · 10 Sep 2026</div></div>${confidenceBadge(s)}</div><div class=\"inspector-details\"><div class=\"detail-row\">${icon('camera')}<div><span>Camera source</span><strong>${s.camera} · ${s.location}</strong></div></div><div class=\"detail-row\">${icon('clock-3')}<div><span>Timestamp</span><strong>${s.time} · 10 Sep 2026</strong></div></div><div class=\"detail-row\">${icon('user-search')}<div><span>Person crop</span><strong>Rahul Sharma · reference image</strong></div></div></div>${statusLabel(s.id)}<div class=\"verification-copy\" style=\"margin-top:9px\">Matching confidence is a probabilistic AI signal and not a final identity confirmation.</div><div class=\"inspector-actions\"><button class=\"btn btn-primary btn-sm\" data-action=\"open-evidence\" data-id=\"${s.id}\">View evidence</button><button class=\"btn btn-sm\" data-action=\"add-timeline\" data-id=\"${s.id}\">Add to timeline</button><button class=\"btn btn-success btn-sm\" data-action=\"verify\" data-id=\"${s.id}\">${isVerified(s.id)?icon('check'):'✓'} ${isVerified(s.id)?'Verified':'Mark verified'}</button><button class=\"btn btn-danger btn-sm\" data-action=\"reject\" data-id=\"${s.id}\">Reject</button></div>${isVerified(s.id)?'<div class=\"audit-message\">Match marked verified and added to the investigation record.</div>':''}</div></aside></div>`}\nfunction resultCard(x){return `<article class=\"result-card ${state.selected===x.id?'selected':''} ${isVerified(x.id)?'verified':''}\" data-action=\"select-sighting\" data-id=\"${x.id}\"><div class=\"result-image\">${img(x.src,`Fictional CCTV source frame from ${x.camera}, ${x.location}`)}<span class=\"bbox\"></span><span class=\"result-tag\">${x.confidence}% probable match</span></div><div class=\"result-card-body\"><div class=\"result-card-title\"><strong>${x.camera}</strong>${confidenceBadge(x)}</div><div class=\"result-meta\">${x.location}<span>${x.time} · 10 Sep 2026</span></div><div class=\"result-actions\"><button class=\"btn btn-primary btn-sm\" data-action=\"open-evidence\" data-id=\"${x.id}\">Evidence</button><button class=\"btn btn-sm\" data-action=\"add-timeline\" data-id=\"${x.id}\">Timeline</button></div></div></article>`}\nfunction timeline(){const eventIds=['s4','s5','s1','s3'];return header('Case evidence / MP-2026-014','Person movement timeline','Reconstructed from probable CCTV detections. Route segments remain reviewable hypotheses until an operator verifies each frame.',`<button class=\"btn\" data-view=\"results\">${icon('scan-search')} Potential matches</button>`)+`<div class=\"panel\"><div class=\"panel-header\"><div><div class=\"panel-title\">Evidence time ruler</div><div class=\"panel-kicker\">10:42 — 11:27 · selected events carry through to the investigation report</div></div><span class=\"case-chip\">${state.timeline.size} events on timeline</span></div><div class=\"timeline-ruler\"><div class=\"ruler-labels\"><span>10:40</span><span>10:50</span><span>11:00</span><span>11:10</span><span>11:20</span><span>11:30</span></div><div class=\"ruler-line\"><button class=\"ruler-event ${isVerified('s4')?'verified':''} ${state.selected==='s4'?'selected':''}\" style=\"left:8%\" data-action=\"select-sighting\" data-id=\"s4\"><span class=\"ruler-event-dot\"></span></button><button class=\"ruler-event ${isVerified('s5')?'verified':''} ${state.selected==='s5'?'selected':''}\" style=\"left:39%\" data-action=\"select-sighting\" data-id=\"s5\"><span class=\"ruler-event-dot\"></span></button><button class=\"ruler-event ${isVerified('s1')?'verified':''} ${state.selected==='s1'?'selected':''}\" style=\"left:63%\" data-action=\"select-sighting\" data-id=\"s1\"><span class=\"ruler-event-dot\"></span></button><button class=\"ruler-event ${isVerified('s3')?'verified':''} ${state.selected==='s3'?'selected':''}\" style=\"left:91%\" data-action=\"select-sighting\" data-id=\"s3\"><span class=\"ruler-event-dot\"></span></button></div><div class=\"faint\" style=\"text-align:center;font-size:9px;font-family:var(--mono)\">21 min 36 sec — no verified detections between Parking Area and Main Gate</div></div></div><div class=\"movement-grid\"><div><div class=\"panel route-map\"><svg class=\"route-svg\" viewBox=\"0 0 900 205\" preserveAspectRatio=\"none\"><path d=\"M105 55 C225 70 258 143 383 123 S535 39 617 89 S754 157 825 111\" fill=\"none\" stroke=\"#36b8d9\" stroke-width=\"2.5\" stroke-dasharray=\"5 5\"/><circle cx=\"105\" cy=\"55\" r=\"6\" fill=\"#58b783\"/><circle cx=\"383\" cy=\"123\" r=\"6\" fill=\"#d5a64a\"/><circle cx=\"617\" cy=\"89\" r=\"6\" fill=\"#58b783\"/><circle cx=\"825\" cy=\"111\" r=\"6\" fill=\"#d5a64a\"/></svg><span class=\"route-label one\">01 · CAM-012</span><span class=\"route-label two\">02 · CAM-018</span><span class=\"route-label three\">03 · CAM-034</span><span class=\"route-label four\">04 · CAM-041</span><span class=\"map-label bus\">North Entrance</span><span class=\"map-label parking\">Parking Area</span><span class=\"map-label gate\">Main Gate</span><span class=\"map-label market\">Market Road</span></div><div class=\"event-list\" style=\"margin-top:10px\">${eventIds.map(eventTile).join('')}</div></div><aside class=\"panel route-summary\"><div class=\"panel-header\"><div><div class=\"panel-title\">Route hypothesis</div><div class=\"panel-kicker\">Spatial handoffs</div></div>${icon('route')}</div><div class=\"panel-body\"><h3>Potential camera sequence</h3><p>Each stop links to source footage and an operator decision. Probability does not establish identity.</p>${[['01','CAM-012','North Entrance','10:42:12'],['02','CAM-018','Parking Area','11:03:48'],['03','CAM-034','Main Gate','11:17:04'],['04','CAM-041','Market Road','11:26:31']].map(x=>`<div class=\"route-step\"><span class=\"route-step-num\">${x[0]}</span><div><strong>${x[1]} · ${x[3]}</strong><span>${x[2]} · ${x[0]==='03'?'95':'87'}% probable match</span></div></div>`).join('')}<button class=\"btn btn-primary\" style=\"width:100%;margin-top:12px\" data-view=\"report\">Open investigation report ${icon('arrow-right')}</button></div></aside></div>`}\nfunction eventTile(id){const x=sight(id);return `<article class=\"event-tile ${isVerified(id)?'verified':''} ${state.selected===id?'selected':''}\" data-action=\"select-sighting\" data-id=\"${id}\"><div class=\"event-tile-thumb\">${img(x.src,`CCTV evidence thumbnail from ${x.camera}, ${x.location}`)}</div><div class=\"event-time\">${x.time}</div><div class=\"event-camera\">${x.camera}</div><div class=\"event-location\">${x.location} · ${x.confidence}% probable</div><div class=\"event-footer\"><button class=\"btn btn-quiet\" data-action=\"open-evidence\" data-id=\"${id}\">Open footage</button><button class=\"btn btn-quiet\" data-action=\"verify\" data-id=\"${id}\" title=\"Verify match\">${isVerified(id)?icon('check-circle-2'):icon('circle-check')}</button></div></article>`}\nfunction evidence(){const s=sight(state.selected);return header('Potential matches / CAM-034 / '+s.time,'Camera evidence viewer','Inspect source footage, nearby camera events, and the operator decision for this potential sighting.',`<button class=\"btn\" data-view=\"results\">${icon('arrow-left')} Back to matches</button>`)+`<div class=\"viewer-grid\"><div><div class=\"panel\"><div class=\"panel-header\"><div><div class=\"panel-title\">Source footage · ${s.camera}</div><div class=\"panel-kicker\">Main Gate · fixed camera · source frame available</div></div><span class=\"live-label\"><span class=\"status-dot\" style=\"background:var(--amber)\"></span>Paused at ${s.time}</span></div><div class=\"panel-body\" style=\"padding:13px 13px 0\"><div class=\"video-frame\">${img(s.src,`Fictional CCTV source footage from ${s.camera}, ${s.location}; attribution from stock provider`)}<div class=\"video-overlay\"></div><span class=\"video-corner\">${s.camera} · ${s.location}</span><span class=\"video-corner right\">10 SEP 2026 · ${s.time}</span><span class=\"video-box\"></span></div><div class=\"video-controls\"><div class=\"transport\"><button title=\"Play\" data-action=\"toast\" data-message=\"Playback started at 14:32:08\">${icon('