ss=\"person-crop\">${img(ASSETS.portrait,'Rahul Sharma fictional person crop; photo by Vika Glitter on Pexels')}<div><strong>Person detected</strong><span>${s.confidence}% matching confidence</span></div></div><div class=\"inspector-details\"><div class=\"detail-row\">${icon('camera')}<div><span>Camera</span><strong>${s.camera}</strong></div></div><div class=\"detail-row\">${icon('map-pin')}<div><span>Location</span><strong>${s.location}</strong></div></div><div class=\"detail-row\">${icon('clock-3')}<div><span>Timestamp</span><strong>${s.time}</strong></div></div><div class=\"detail-row\">${icon('folder-open')}<div><span>Case</span><strong>MP-2026-014 · Rahul Sharma</strong></div></div></div>${statusLabel(s.id)}<div class=\"verification-copy\" style=\"margin-top:10px\">This frame is a probable match and requires operator verification before it is treated as case evidence.</div><div class=\"nearby\"><div class=\"nearby-title\">Nearby camera events</div><div class=\"nearby-row\"><strong>CAM-035</strong><span>14:33:01</span></div><div class=\"nearby-row\"><strong>CAM-041</strong><span>14:36:17</span></div><div class=\"nearby-row\"><strong>CAM-052</strong><span>14:41:04 · offline</span></div></div><div class=\"inspector-actions\"><button class=\"btn btn-success\" data-action=\"verify\" data-id=\"${s.id}\">${isVerified(s.id)?icon('check-circle-2'):'✓'} ${isVerified(s.id)?'Verified by operator':'Verify match'}</button><button class=\"btn btn-danger\" data-action=\"reject\" data-id=\"${s.id}\">Reject match</button><button class=\"btn\" data-action=\"add-note\">${icon('sticky-note')} Add note</button></div>${isVerified(s.id)?'<div class=\"audit-message\">Match marked verified and added to the investigation record.</div>':''}</div></aside></div>`}\nfunction live(){return header('Operations / camera network','Live cameras','Monitor source feeds across the investigation perimeter. Offline states preserve the audit trail and never imply missing footage is available.',`<button class=\"btn\" data-view=\"network\">${icon('map')} Camera map</button><button class=\"btn btn-primary\">${icon('grid-2x2')} 2 × 2</button>`)+`<div class=\"live-summary\"><div class=\"live-summary-item\"><span class=\"status-dot\" style=\"color:var(--green)\"></span><strong>128</strong> online</div><div class=\"live-summary-item\"><span class=\"status-dot\" style=\"color:var(--red);box-shadow:none\"></span><strong>4</strong> unavailable</div><div class=\"live-summary-item\"><strong>12</strong> route cameras selected</div><div class=\"live-summary-item\" style=\"margin-left:auto;color:var(--cyan)\">${icon('lock-keyhole')} Authorized access</div></div><div class=\"feed-grid\">${[['CAM-012','North Entrance',ASSETS.cctvD,'10:42:12'],['CAM-034','Main Gate',ASSETS.cctvB,'14:32:08'],['CAM-041','Market Road',ASSETS.cctvC,'14:36:17']].map(x=>`<article class=\"feed-card\"><div class=\"feed-image\">${img(x[2],`Fictional live CCTV feed from ${x[0]}, ${x[1]}`)}<div class=\"feed-overlay\"></div><div class=\"feed-top\"><span>${x[0]} · ${x[1]}</span><span class=\"live-status\"><span class=\"status-dot\"></span>LIVE</span></div><div class=\"feed-bottom\"><span>${x[3]} · 10 SEP 2026</span><div class=\"feed-actions\"><button title=\"Fullscreen\" data-action=\"toast\" data-message=\"${x[0]} opened in fullscreen\">${icon('maximize-2')}</button><button title=\"Mute\" data-action=\"toast\" data-message=\"Audio muted for ${x[0]}\">${icon('volume-2')}</button><button title=\"Snapshot\" data-action=\"toast\" data-message=\"Snapshot added for ${x[0]}\">${icon('camera')}</button><button title=\"Open investigation\" data-action=\"open-evidence\" data-id=\"s2\">${icon('arrow-up-right')}</button></div></div></div><div class=\"feed-meta\"><span>Case-linked feed · protected source</span><span class=\"text-cyan\">Open investigation</span></div></article>`).join('')}<article class=\"feed-card offline\"><div class=\"feed-image\">${icon('video-off')}<strong>CAM-087 unavailable</strong><span>Last active 11 minutes ago · 14:23:02</span></div><div class=\"feed-meta\"><span class=\"text-red\">Source footage unavailable</span><button class=\"btn btn-quiet btn-sm\" data-view=\"network\">Open camera network</button></div></article></div>`}\nfunction alerts(){return header('Operations / review queue','Alerts','Review time-ordered match, camera, system, and investigation updates without losing case context.',`<button class=\"btn\" data-action=\"toast\" data-message=\"Alert queue marked reviewed\">${icon('check-circle-2')} Mark all reviewed</button>`)+`<div class=\"alert-layout\"><div class=\"panel alert-queue\"><div class=\"panel-header\"><div><div class=\"panel-title\">Alert queue</div><div class=\"panel-kicker\">06 unresolved · audit trail retained</div></div><select class=\"select\"><option>All categories</option></select></div><div class=\"queue-item active\"><span class=\"severity high\"></span><div class=\"queue-copy\"><div class=\"queue-title\">High confidence match requires review</div><p>92% similarity estimate · MP-2026-014 / CAM-034 / Main Gate</p><div class=\"queue-time\">10 Sep 2026 · 14:32:08</div></div></div><div class=\"queue-item\"><span class=\"severity\"></span><div class=\"queue-copy\"><div class=\"queue-title\">Possible match</div><p>81% similarity estimate · MP-2026-011 / CAM-021 / Parking Area</p><div class=\"queue-time\">10 Sep 2026 · 13:18:44</div></div></div><div class=\"queue-item\"><span class=\"severity high\"></span><div class=\"queue-copy\"><div class=\"queue-title\">Camera offline</div><p>CAM-087 unavailable · last active 11 minutes ago</p><div class=\"queue-time\">10 Sep 2026 · 14:23:02</div></div></div><div class=\"queue-item\"><span class=\"severity green\"></span><div class=\"queue-copy\"><div class=\"queue-title\">Investigation update</div><p>3 frames added to movement timeline by operator</p><div class=\"queue-time\">10 Sep 2026 · 12:08:10</div></div></div><div class=\"queue-item\"><span class=\"severity\"></span><div class=\"queue-copy\"><div class=\"queue-title\">System alert</div><p>Camera sync completed across Transit core</p><div class=\"queue-time\">10 Sep 2026 · 11:50:28</div></div></div></div><div class=\"panel alert-detail\"><div class=\"detail-hero\"><div><div class=\"detail-severity\"><span class=\"severity high\"></span>HIGH CONFIDENCE MATCH</div><h2>92% similarity estimate</h2><p>Probable match · requires verification before becoming case evidence.</p></div><span class=\"case-chip\">Unreviewed</span></div><div class=\"detail-grid\"><div class=\"detail-grid-item\"><span>Case</span><strong>MP-2026-014</strong></div><div class=\"detail-grid-item\"><span>Camera</span><strong>CAM-034</strong></div><div class=\"detail-grid-item\"><span>Location</span><strong>Main Gate</strong></div><div class=\"detail-grid-item\"><span>Timestamp</span><strong>14:32:08</strong></div><div class=\"detail-grid-item\"><span>Confidence band</span><strong class=\"text-green\">High · 90–100%</strong></div><div class=\"detail-grid-item\"><span>Evidence status</span><strong>Requires verification</strong></div></div><div class=\"detail-evidence\"><div class=\"evidence-frame\">${img(ASSETS.cctvB,'Fictional CCTV evidence frame from CAM-034 at Main Gate; photo by El gringo photo on Pexels')}<span class=\"bbox\"></span></div></div><div class=\"detail-actions\"><button class=\"btn btn-primary\" data-action=\"open-evidence\" data-id=\"s2\">Investigate ${icon('arrow-right')}</button><button class=\"btn\" data-action=\"toast\" data-message=\"Alert marked reviewed; evidence remains unverified\">Mark reviewed</button><button class=\"btn btn-danger\" data-action=\"toast\" data-message=\"Dismiss reason recorded in audit trail\">Dismiss</button></div></div></div>`}\nfunction report(){return header('Cases & investigations / MP-2026-014','Investigation report','Evidence-first brief for Rahul Sharma. Verified, potential, and rejected frames remain explicitly separated.',`<button class=\"btn\" data-action=\"generate-report\">${icon('file-output')} Generate report</button><button class=\"btn btn-primary\" data-action=\"toast\" data-message=\"PDF export queued securely\">${icon('download')} Export PDF</button>`)+`<div class=\"report-layout\"><article class=\"report-sheet\"><div class=\"report-heading\"><div><div class=\"eyebrow\">Protected case evidence</div><h2>Rahul Sharma · Missing person investigation</h2><p>Case MP-2026-014 · Missing since 10 Sep 2026 · Central Bus Station</p></div><div class=\"report-id\">TRACE / 014 / ${state.report==='generated'?'GENERATED':'DRAFT'}</div></div><div class=\"report-route\"><svg class=\"route-svg\" viewBox=\"0 0 900 166\" preserveAspectRatio=\"none\"><path d=\"M90 50 C207 42 270 132 382 100 S520 35 614 82 S745 136 830 89\" fill=\"none\" stroke=\"#36b8d9\" stroke-width=\"2\" stroke-dasharray=\"5 5\"/><circle cx=\"90\" cy=\"50\" r=\"7\" fill=\"#58b783\"/><circle cx=\"382\" cy=\"100\" r=\"7\" fill=\"#d5a64a\"/><circle cx=\"614\" cy=\"82\" r=\"7\" fill=\"#58b783\"/><circle cx=\"830\" cy=\"89\" r=\"7\" fill=\"#d5a64a\"/></svg><span class=\"route-label one\">01 · CAM-012</span><span class=\"route-label two\">02 · CAM-018</span><span class=\"route-label three\">03 · CAM-034</span><span class=\"route-label four\">04 · CAM-041</span></div><div class=\"report-section\"><h3>Person details</h3><p>Rahul Sharma, 17 years old. Reference image: front-facing portrait. Clothing at last sighting: navy hoodie, charcoal trousers, white sneakers. Distinguishing feature: small scar above right eyebrow.</p></div><div class=\"report-section\"><h3>Case timeline</h3><table class=\"report-table\"><thead><tr><th>Time</th><th>Camera</th><th>Location</th><th>Confidence</th><th>Verification</th></tr></thead><tbody><tr><td>10:42:12</td><td>CAM-012</td><td>North Entrance</td><td class=\"text-amber\">87%</td><td>${isVerified('s4')?'Verified by operator':'Requires verification'}</td></tr><tr><td>11:03:48</td><td>CAM-018</td><td>Parking Area</td><td class=\"text-amber\">92%</td><td>${isVerified