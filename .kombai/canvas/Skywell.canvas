e=\"color:#d4ae65\">\n                                        Requires verification\n                                    </td>\n                                </tr>\n                            </tbody>\n                        </table>\n                    </div>\n                    <div class=\"report-section\" data-kid=\"1-2-12-2-1-5\">\n                        <h3 data-kid=\"1-2-12-2-1-5-1\">\n                            Investigator notes\n                        </h3>\n                        <p data-kid=\"1-2-12-2-1-5-2\" style=\"margin:0;color:#9babb3;font-size:11px;line-height:1.6\">\n                            Potential detections are included for review. Only operator-verified matches are represented as verified evidence. AI similarity scores remain probabilistic signals and do not confirm identity.\n                        </p>\n                    </div>\n                </article>\n                <aside class=\"panel report-actions\" data-kid=\"1-2-12-2-2\">\n                    <h3 data-kid=\"1-2-12-2-2-1\">\n                        Report actions\n                    </h3>\n                    <p data-kid=\"1-2-12-2-2-2\">\n                        Assemble the current evidence record into a secure investigation dossier.\n                    </p>\n                    <div class=\"report-action-list\" data-kid=\"1-2-12-2-2-3\">\n                        <button class=\"btn btn-primary\" data-action=\"generate-report\" data-kid=\"1-2-12-2-2-3-1\">\n                            <i class=\"ico\" data-kid=\"1-2-12-2-2-3-1-1\" data-lucide=\"file-output\">\n                            </i>\n                            Generate report\n                        </button>\n                        <button class=\"btn\" data-action=\"export\" data-kid=\"1-2-12-2-2-3-2\">\n                            <i class=\"ico\" data-kid=\"1-2-12-2-2-3-2-1\" data-lucide=\"download\">\n                            </i>\n                            Export PDF\n                        </button>\n                        <button class=\"btn\" data-action=\"share\" data-kid=\"1-2-12-2-2-3-3\">\n                            <i class=\"ico\" data-kid=\"1-2-12-2-2-3-3-1\" data-lucide=\"share-2\">\n                            </i>\n                            Share securely\n                        </button>\n                    </div>\n                    <div class=\"secure-note\" data-kid=\"1-2-12-2-2-4\">\n                        <i class=\"ico\" data-kid=\"1-2-12-2-2-4-1\" data-lucide=\"shield-check\">\n                        </i>\n                        <span data-kid=\"1-2-12-2-2-4-2\">\n                            Evidence protected · secure sharing records the authorized operator and case ID.\n                        </span>\n                    </div>\n                    <div class=\"detail-block\" data-kid=\"1-2-12-2-2-5\" style=\"margin-top:19px\">\n                        <h3 data-kid=\"1-2-12-2-2-5-1\">\n                            Report contents\n                        </h3>\n                        <div class=\"draft-list\" data-kid=\"1-2-12-2-2-5-2\">\n                            <div class=\"draft-item done\" data-kid=\"1-2-12-2-2-5-2-1\">\n                                <i class=\"ico\" data-kid=\"1-2-12-2-2-5-2-1-1\" data-lucide=\"check\">\n                                </i>\n                                <span data-kid=\"1-2-12-2-2-5-2-1-2\">\n                                    Person details\n                                </span>\n                            </div>\n                            <div class=\"draft-item done\" data-kid=\"1-2-12-2-2-5-2-2\">\n                                <i class=\"ico\" data-kid=\"1-2-12-2-2-5-2-2-1\" data-lucide=\"check\">\n                                </i>\n                                <span data-kid=\"1-2-12-2-2-5-2-2-2\">\n                                    Case timeline\n                                </span>\n                            </div>\n                            <div class=\"draft-item done\" data-kid=\"1-2-12-2-2-5-2-3\">\n                                <i class=\"ico\" data-kid=\"1-2-12-2-2-5-2-3-1\" data-lucide=\"check\">\n                                </i>\n                                <span data-kid=\"1-2-12-2-2-5-2-3-2\">\n                                    Camera sequence\n                                </span>\n                            </div>\n                            <div class=\"draft-item done\" data-kid=\"1-2-12-2-2-5-2-4\">\n                                <i class=\"ico\" data-kid=\"1-2-12-2-2-5-2-4-1\" data-lucide=\"check\">\n                                </i>\n                                <span data-kid=\"1-2-12-2-2-5-2-4-2\">\n                                    Verified / rejected matches\n                                </span>\n                            </div>\n                            <div class=\"draft-item done\" data-kid=\"1-2-12-2-2-5-2-5\">\n                                <i class=\"ico\" data-kid=\"1-2-12-2-2-5-2-5-1\" data-lucide=\"check\">\n                                </i>\n                                <span data-kid=\"1-2-12-2-2-5-2-5-2\">\n                                    Investigator notes\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </aside>\n            </div>\n        </section>\n        <section class=\"view\" data-kid=\"1-2-13\" id=\"view-settings\">\n            <div class=\"page-head\" data-kid=\"1-2-13-1\">\n                <div data-kid=\"1-2-13-1-1\">\n                    <div class=\"eyebrow\" data-kid=\"1-2-13-1-1-1\">\n                        System / authorized access\n                    </div>\n                    <h1 data-kid=\"1-2-13-1-1-2\">\n                        Settings\n                    </h1>\n                    <p data-kid=\"1-2-13-1-1-3\">\n                        Trace operational settings and audit controls.\n                    </p>\n                </div>\n            </div>\n            <div class=\"panel\" data-kid=\"1-2-13-2\" style=\"padding:22px;max-width:720px\">\n                <div class=\"detail-grid\" data-kid=\"1-2-13-2-1\">\n                    <div data-kid=\"1-2-13-2-1-1\">\n                        <label data-kid=\"1-2-13-2-1-1-1\">\n                            System status\n                        </label>\n                        <b data-kid=\"1-2-13-2-1-1-2\" style=\"color:#9bdcb5\">\n                            Operational\n                        </b>\n                    </div>\n                    <div data-kid=\"1-2-13-2-1-2\">\n                        <label data-kid=\"1-2-13-2-1-2-1\">\n                            Evidence retention\n                        </label>\n                        <b data-kid=\"1-2-13-2-1-2-2\">\n                            90 days · protected\n                        </b>\n                    </div>\n                    <div data-kid=\"1-2-13-2-1-3\">\n                        <label data-kid=\"1-2-13-2-1-3-1\">\n                            Operator session\n                        </label>\n                        <b data-kid=\"1-2-13-2-1-3-2\">\n                            Authorized · audit trail on\n                        </b>\n                    </div>\n                    <div data-kid=\"1-2-13-2-1-4\">\n                        <label data-kid=\"1-2-13-2-1-4-1\">\n                            Camera network\n                        </label>\n                        <b data-kid=\"1-2-13-2-1-4-2\">\n                            132 registered · 128 online\n                        </b>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <div class=\"inline-status\" data-kid=\"1-2-14\" id=\"inline-status\">\n            <i class=\"ico\" data-kid=\"1-2-14-1\" data-lucide=\"info\">\n            </i>\n            <span data-dynamic=\"true\" data-kid=\"1-2-14-2\" data-name=\"toast notification text\" data-reason=\"text injected by system to notify operator of action results\" id=\"inline-status-text\">\n            </span>\n        </div>\n    </main>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    (function(){\n  const state={view:'dashboard',step:1,processing:false,verified:new Set(['cam034']),timeline:new Set(['cam034']),camera:'CAM-034'};\n  const views={dashboard:'view-dashboard',cases:'view-cases',create:'view-create',workspace:'view-workspace',results:'view-results',timeline:'view-timeline',evidence:'view-evidence',live:'view-live',alerts:'view-alerts',report:'view-report',settings:'view-settings'};\n  const $=(s,r=document)=>r.querySelector(s); const $$=(s,r=document)=>Array.from(r.querySelectorAll(s));\n  function icons(){if(window.lucide){window.lucide.createIcons({attrs:{'stroke-width':1.7}})}}\n  function notify(message,tone='info'){const el=$('#inline-status');$('#inline-status-text').textContent=message;el.className='inline-status show '+(tone==='success'?'success':tone==='warning'?'warning':'');clearTimeout(window.__traceToast);window.__traceToast=setTimeout(()=>el.className='inline-status',3200);icons()}\n  function showView(view){if(!views[view])view='dashboard';Object.entries(views).forEach(([key,id])=>{const el=document.getElementById(id);if(el)el.classList.toggle('active',key===view)});$$('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.view===view || (view==='cases'&&b.dataset.view==='cases') || (view==='workspace'&&b.dataset.view==='workspace')));state.view=view;icons();window.scrollTo({top:0,behavior:'smooth'})}\n  function setStep(step){state.step=step;$$('[data-form-step]').forEach(el=>el.classList.toggle('active',Number(el.dataset.formStep)===step));$$('.step').forEach(el=>{const n=Number(el.dataset.step);el.classList.toggle('active',n===step);el.classList.toggle('complete',n<step)});const back=$('[data-action=\"create-back\"]');const next=$('[data-action=\"create-next\"]');if(back)back.disabled=step===1;if(next){next.innerHTML=step===4?'Create case &amp; start CCTV search <i class=\"ico\" data-lucide=\"scan-search\"></i>':'Continue <i class=\"ico\" data-lucide=\"arrow-right\"></i>';next.dataset.action=step===4?'create-case':'create-next'}icons()}\n  function updateVerification(id){state.verified.add(id);state.timeline.add(id);$$('.verification-state').forEach(el=>{el.textContent='Verified by operator';el.style.color='#9bdcb5'});$$('[data-id=\"'+id+'\"]').forEach(btn=>{if(btn.dataset.action==='verify'){btn.textContent='Verified';btn.classList.add('btn-success');btn.disabled=true}});$$('.event-card').forEach(card=>{const cam=card.querySelector('.event-camera');if(cam&&cam.textContent.toLowerCase().includes(id.replace('cam','cam-'))){card.classList.add('verified');const s=card.querySelector('.event-state');if(s)s.textContent='Verified by operator'}});notify('Match marked verified and added to the investigation record.','success')}\n  function addTimeline(id){state.timeline.add(id);notify('Detection added to the movement timeline.','success')}\n  function runSearch(){if(state.processing)return;state.processing=true;const progress=$('#search-progress'),text=$('#search-progress-text'),button=$('#run-search');progress.classList.add('show');button.disabled=true;const messages=['Analyzing CCTV footage...','Searching 128 cameras...','Comparing detected appearances...','Building potential sightings...'];let i=0;text.textContent=messages[i];const timer=setInterval(()=>{i++;if(i<messages.length){text.textContent=messages[i]}else{clearInterval(timer);state.processing=false;button.disabled=false;progress.classList.remove('show');$('#workspace-results').classList.add('show');$('#workspace-result-title').textContent='47 potential sightings found';$('#workspace-result-sub').textContent='Across 12 cameras · requires operator verification';notify('47 potential sightings found across 12 cameras.','success')}},900)}\n  document.addEventListener('click',function(e){const nav=e.target.closest('[data-view]');if(nav){e.preventDefault();showView(nav.dataset.view);return}const step=e.target.closest('[data-step]');if(step){setStep(Number(step.dataset.step));return}const action=e.target.closest('[data-action]');if(!action)return;const a=action.dataset.action;if(a==='open-evidence'){showView('evidence');return}if(a==='run-search'){runSearch();return}if(a==='verify'){updateVerification(action.dataset.id||'cam034');return}if(a==='add-timeline'){addTimeline(action.dataset.id||'cam034');return}if(a==='note'){notify('Investigation note added to the case audit trail.','success');return}if(a==='bookmark'){notify('Frame bookmark added at CAM-034 · 14:32:08.','success');return}if(a==='reject'){notify('Detection marked rejected after review.','warning');return}if(a==='play'){notify('Source footage playback started.');return}if(a==='generate-report'){notify('Report generated for MP-2026-014.','success');return}if(a==='export'){notify('Secure PDF export prepared for download.','success');return}if(a==='share'){notify('Secure share link created for authorized recipients.','success');return}if(a==='create-next'){setStep(Math.min(4,state.step+1));return}if(a==='create-back'){setStep(Math.max(1,state.step-1));return}if(a==='create-case'){notify('Case MP-2026-014 created. CCTV search is ready to run.','success');showView('workspace');return}});\n  $$('.cam-node').forEach(node=>node.addEventListener('click',function(){const camera=node.dataset.camera;$('#preview-camera').textContent=camera+(camera==='CAM-034'?' · Main Gate':camera==='CAM-021'?' · Parking Area':camera==='CAM-041'?' · Market Road':' · South Exit');notify(camera+' selected on the camera network.')}));\n  setStep(1);icons();\n})();\n</script>\n",
      "comments": [],
      "created": "2026-09-11T11:10:26.499464+00:00",
