        </svg>\n        <button class=\"cta\" data-kid=\"1-4-8\" data-name=\"full progress call-to-action button\">\n            See your full progress\n        </button>\n    </main>\n    <nav class=\"tabbar\" data-kid=\"1-5\" data-name=\"bottom navigation bar\">\n        <button class=\"nav\" data-kid=\"1-5-1\" data-name=\"home navigation item\">\n            <span class=\"nav-ico\" data-kid=\"1-5-1-1\" data-name=\"home icon container\">\n                <svg data-kid=\"1-5-1-1-1\" data-name=\"home icon\" fill=\"none\" height=\"25\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\" width=\"25\">\n                    <path d=\"M3.4 10.4 12 3.6l8.6 6.8V20a.9.9 0 0 1-.9.9h-4.4v-6h-6.6v6H4.3a.9.9 0 0 1-.9-.9v-9.6z\">\n                    </path>\n                </svg>\n                <span class=\"badge\" data-kid=\"1-5-1-1-2\" data-name=\"unread activity badge\">\n                    4\n                </span>\n            </span>\n            Home\n        </button>\n        <button class=\"nav\" data-kid=\"1-5-2\" data-name=\"routes navigation item\">\n            <span class=\"nav-ico\" data-kid=\"1-5-2-1\" data-name=\"routes icon container\">\n                <svg data-kid=\"1-5-2-1-1\" data-name=\"map route icon\" fill=\"none\" height=\"25\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\" width=\"25\">\n                    <path d=\"M2.8 6.4 9 3.6l6 2.8 6.2-2.8v14L15 20.4l-6-2.8-6.2 2.8v-14z\">\n                    </path>\n                    <path d=\"M9 3.6v14M15 6.4v14\">\n                    </path>\n                </svg>\n            </span>\n            Routes\n        </button>\n        <button class=\"nav\" data-kid=\"1-5-3\" data-name=\"record navigation item\">\n            <span class=\"nav-ico\" data-kid=\"1-5-3-1\" data-name=\"record icon container\">\n                <svg data-kid=\"1-5-3-1-1\" data-name=\"circle record icon\" fill=\"none\" height=\"27\" stroke=\"currentColor\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\" width=\"27\">\n                    <circle cx=\"12\" cy=\"12\" r=\"9.2\">\n                    </circle>\n                    <circle cx=\"12\" cy=\"12\" fill=\"currentColor\" r=\"5\" stroke=\"none\">\n                    </circle>\n                </svg>\n            </span>\n            Record\n        </button>\n        <button class=\"nav\" data-kid=\"1-5-4\" data-name=\"clubs navigation item\">\n            <span class=\"nav-ico\" data-kid=\"1-5-4-1\" data-name=\"clubs icon container\">\n                <svg data-kid=\"1-5-4-1-1\" data-name=\"network clubs icon\" fill=\"none\" height=\"25\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\" width=\"25\">\n                    <path d=\"M8.4 4.6 12 8.2l-3.6 3.6L4.8 8.2l3.6-3.6z\">\n                    </path>\n                    <path d=\"M15.6 4.6 19.2 8.2l-3.6 3.6L12 8.2l3.6-3.6z\">\n                    </path>\n                    <path d=\"M12 12.2l3.6 3.6-3.6 3.6-3.6-3.6 3.6-3.6z\">\n                    </path>\n                </svg>\n            </span>\n            Clubs\n        </button>\n        <button class=\"nav is-active\" data-kid=\"1-5-5\" data-name=\"profile navigation item\">\n            <span class=\"nav-ico\" data-kid=\"1-5-5-1\" data-name=\"profile icon container\">\n                <svg data-kid=\"1-5-5-1-1\" data-name=\"profile user icon\" fill=\"currentColor\" height=\"25\" viewbox=\"0 0 24 24\" width=\"25\">\n                    <rect height=\"3.2\" rx=\"1.1\" width=\"15.6\" x=\"4.2\" y=\"3.6\">\n                    </rect>\n                    <rect fill=\"none\" height=\"11.8\" rx=\"1.6\" stroke=\"currentColor\" stroke-width=\"1.8\" width=\"12.8\" x=\"5.6\" y=\"8.6\">\n                    </rect>\n                    <rect height=\"4.2\" rx=\"1\" width=\"2.4\" x=\"8.6\" y=\"13.4\">\n                    </rect>\n                    <rect height=\"6.4\" rx=\"1\" width=\"2.4\" x=\"1