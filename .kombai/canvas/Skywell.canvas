div class=\"panel\"><div class=\"panel-header\"><div><div class=\"panel-title\">Operator preferences</div><div class=\"panel-kicker\">Omar Siddiqui · authorized operator</div></div>${icon('user-cog')}</div><div class=\"panel-body\"><div class=\"setting-row\"><div><strong>Evidence verification confirmations</strong><span>Require a confirmation before marking a frame verified</span></div><button class=\"toggle\"><i></i></button></div><div class=\"setting-row\"><div><strong>New high-confidence alerts</strong><span>Show alerts in the review queue</span></div><button class=\"toggle\"><i></i></button></div><div class=\"setting-row\"><div><strong>24-hour timestamps</strong><span>Use tabular operational time format</span></div><button class=\"toggle\"><i></i></button></div></div></div><div class=\"panel\"><div class=\"panel-header\"><div><div class=\"panel-title\">Evidence &amp; privacy</div><div class=\"panel-kicker\">Protected case data</div></div>${icon('shield-check')}</div><div class=\"panel-body\"><div class=\"setting-row\"><div><strong>Evidence retention</strong><span>Protected case evidence and audit history</span></div><strong class=\"mono\">90 days</strong></div><div class=\"setting-row\"><div><strong>Session access</strong><span>Last verified 10 Sep 2026 · 08:02</span></div><strong class=\"text-green\">Authorized</strong></div><div class=\"setting-row\"><div><strong>Operator audit trail</strong><span>Verification, rejection, notes, sharing</span></div><button class=\"btn btn-sm\" data-action=\"toast\" data-message=\"Audit trail export prepared\">Export ${icon('download')}</button></div><div class=\"security-cue\">${icon('lock-keyhole')} Access to source frames is restricted to authorized investigators. TRACE never treats a similarity estimate as identity confirmation.</div></div></div></div>`}\nfunction toast(message){const stack=document.getElementById('toastStack');const el=document.createElement('div');el.className='toast';el.innerHTML=`${icon('check-circle-2')}<span>${message}</span>`;stack.appendChild(el);if(window.lucide)window.lucide.createIcons({attrs:{'stroke-width':1.8}});setTimeout(()=>el.remove(),3600)}\nfunction startSearch(){if(state.search==='loading')return;state.search='loading';state.searchStage='analyzing';render();const stages=[['analyzing',900],['searching',1900],['comparing',3000],['building',4100]];stages.forEach(([stage,ms])=>setTimeout(()=>{state.searchStage=stage;render()},ms));setTimeout(()=>{state.search='complete';delete state.searchStage;render();toast('47 potential sightings found across 12 cameras. Review order only; verification required.')},5200)}\ndocument.addEventListener('click',e=>{const el=e.target.closest('[data-view],[data-case-view],[data-action],[data-step]');if(!el)return;if(el.dataset.view){state.view=el.dataset.view;render();return}if(el.dataset.caseView){state.view=el.dataset.caseView;render();return}if(el.dataset.step){state.step=Number(el.dataset.step);state.view='create';render();return}const action=el.dataset.action;const id=el.dataset.id;if(action==='open-case'){state.view='workspace';render();return}if(action==='new-case'){state.view='create';state.step=1;render();return}if(action==='open-evidence'){state.selected=id||state.selected;state.view='evidence';render();return}if(action==='select-sighting'){state.selected=id||state.selected;if(state.view==='dashboard')toast(`Selected ${sight(state.selected).camera} · ${sight(state.selected).time}`);render();return}if(action==='run-search'){startSearch();return}if(action==='next-step'){state.step=Math.min(4,state.step+1);render();return}if(action==='prev-step'){state.step=Math.max(1,state.step-1);render();return}if(action==='create-case'){state.view='workspace';state.search='idle';render();toast('Case MP-2026-014 created. Search configuration is ready.');return}if(action==='add-timeline'){state.timeline.add(id||state.selected);toast('Frame added to the movement timeline.');render();return}if(action==='verify'){const x=id||state.selected;state.verified.add(x);state.timeline.add(x);toast('Match marked verified and added to the investigation record.');render();return}if(action==='reject'){toast('Frame rejected after review. Audit trail updated.');return}if(action==='bookmark'){state.bookmarked=true;toast('Evidence bookmark added to the audit trail.');return}if(action==='add-note'){state.note='Operator note added 10 Sep 2026 · Source frame reviewed at Main Gate; nearby camera handoff requires follow-up.';toast('Investigation note added to MP-2026-014.');return}if(action==='generate-report'){if(state.report==='generating')return;state.report='generating';render();setTimeout(()=>{state.report='generated';render();toast('Report generated for MP-2026-014.');},1600);return}if(action==='toast'){toast(el.dataset.message||'Audit trail updated.')}});\nrender();\n</script>\n",
