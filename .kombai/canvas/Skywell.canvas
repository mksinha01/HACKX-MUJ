      },
      "html": "<style>\n  :root{\n    --bg:#eee8f8;\n    --panel:#e4dcf2;\n    --surface:#fbf8ff;\n    --surface-2:#f1edf9;\n    --ink:#19161d;\n    --ink-2:#443e50;\n    --ink-3:#736983;\n    --line:#d9cfe9;\n    --line-soft:#e1d7f1;\n    --accent:#0f6f63;\n    --accent-soft:#e5dbf6;\n    --accent-2:#b0533f;\n    --badge-bg:#e6dff3;\n    --badge-ink:#0d5b51;\n    --r-lg:18px;\n    --r-md:12px;\n    --r-sm:9px;\n    --s-1:4px; --s-2:8px; --s-3:12px; --s-4:16px; --s-5:24px; --s-6:32px; --s-7:48px;\n    --shadow-card:0 1px 2px rgba(29,20,44,.05), 0 12px 28px -20px rgba(29,20,44,.35);\n    --ease:cubic-bezier(0.16,1,0.3,1);\n    --font:-apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Roboto, \"Helvetica Neue\", Arial, sans-serif;\n  }\n  *{box-sizing:border-box;}\n  html,body{margin:0;padding:0;}\n  :focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:6px;}\n  body{\n    font-family:var(--font);\n    background:var(--bg);\n    color:var(--ink);\n    -webkit-font-smoothing:antialiased;\n    font-size:15px;\n    line-height:1.45;\n  }\n  img{max-width:100%;display:block;}\n  button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;}\n  .shell{display:flex;min-height:100vh;align-items:stretch;}\n\n  /* ---------- sidebar ---------- */\n  .sidebar{\n    width:264px;flex:0 0 264px;\n    background:var(--bg);\n    border-right:1px solid var(--line);\n    padding:22px 16px 24px;\n    display:flex;flex-direction:column;gap:var(--s-4);\n    min-height:100vh;\n  }\n  .brandrow{display:flex;align-items:center;gap:10px;padding:0 6px;}\n  .wordmark{\n    font-size:25px;font-weight:700;letter-spacing:-.045em;\n    color:var(--ink);margin-right:auto;\n  }\n  .wordmark span{color:var(--accent);}\n  .avatar{\n    width:28px;height:28px;border-radius:50%;overflow:hidden;flex:0 0 28px;\n    background:var(--accent-soft);color:var(--badge-ink);\n    display:flex;align-items:center;justify-content:center;\n    font-size:11px;font-weight:600;letter-spacing:.02em;\n    border:1px solid rgba(15,111,99,.18);\n  }\n  .avatar img{width:100%;height:100%;object-fit:cover;}\n  .iconbtn{\n    width:30px;height:30px;border-radius:8px;display:flex;align-items:center;justify-content:center;\n    color:var(--ink);position:relative;\n    transition:background .25s var(--ease), transform .25s var(--ease);\n  }\n  .iconbtn:hover{background:var(--panel);}\n  .iconbtn:active{transform:scale(.94);}\n  .iconbtn .dot{\n    position:absolute;top:4px;right:5px;width:7px;height:7px;border-radius:50%;\n    background:var(--accent-2);border:1.5px solid var(--bg);\n  }\n\n  .orgrow{\n    display:flex;align-items:center;gap:11px;padding:6px;border-radius:var(--r-md);\n    transition:background .25s var(--ease);\n  }\n  .orgrow:hover{background:var(--panel);}\n  .orgmark{\n    width:44px;height:44px;flex:0 0 44px;border-radius:50%;\n    background:var(--surface);border:1px solid var(--line);\n    display:flex;align-items:center;justify-content:center;color:var(--ink);\n  }\n  .orgtext{min-width:0;flex:1;}\n  .orgtext .small{font-size:12.5px;color:var(--ink-3);line-height:1.3;}\n  .orgtext .big{font-size:15.5px;font-weight:600;letter-spacing:-.01em;line-height:1.35;\n    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}\n\n  .rule{height:1px;background:var(--line);margin:2px 8px;position:relative;}\n  .rule::before,.rule::after{\n    content:\"\";position:absolute;top:-2px;width:5px;height:5px;border-radius:50%;\n    background:var(--line);\n  }\n  .rule::before{left:-4px;}\n  .rule::after{right:-4px;}\n\n  .nav{display:flex;flex-direction:column;gap:22px;overflow:auto;flex:1;padding-right:2px;}\n  .nav::-webkit-scrollbar{width:0;}\n  .navgroup{display:flex;flex-direction:column;gap:2px;}\n  .navlabel{\n    font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;\n    color:var(--ink-3);padding:0 10px 8px;\n  }\n  .navitem{\n    display:flex;align-items:center;gap:12px;\n    padding:9px 10px;border-radius:var(--r-sm);\n    color:var(--ink-2);font-size:15px;font-weight:450;\n    text-decoration:none;\n    transition:background .25s var(--ease), color .25s var(--ease);\n  }\n  .navitem svg{flex:0 0 20px;color:var(--ink-2);}\n  .navitem:hover{background:var(--panel);color:var(--ink);}\n  .navitem.active{background:var(--panel);color:var(--ink);font-weight:600;}\n  .navitem.active svg{color:var(--accent);}\n  .tag{\n    margin-left:2px;font-size:10.5px;font-weight:700;letter-spacing:.06em;\n    background:var(--badge-bg);color:var(--badge-ink);\n    padding:2px 7px;border-radius:5px;text-transform:uppercase;\n  }\n  .navfoot{display:flex;flex-direction:column;gap:12px;}\n\n  /* ---------- main ---------- */\n  .main{flex:1;min-width:0;padding:26px 80px 56px;display:flex;flex-direction:column;gap:26px;}\n  .pagehead{display:flex;align-items:flex-end;justify-content:space-between;gap:var(--s-4);}\n  .pagehead h1{font-size:26px;font-weight:600;letter-spacing:-.025em;margin:0;}\n  .pagehead p{margin:4px 0 0;color:var(--ink-3);font-size:14px;}\n\n  .card{\n    background:var(--surface);border:1px solid var(--line-soft);border-radius:var(--r-lg);\n    padding:22px 24px 22px;box-shadow:var(--shadow-card);\n  }\n  .cardhead{display:flex;align-items:center;gap:20px;padding:6px 0 20px;}\n  .cardmark{\n    width:60px;height:60px;flex:0 0 60px;border-radius:50%;\n    background:var(--surface-2);border:1px solid var(--line);\n    display:flex;align-items:center;justify-content:center;color:var(--ink);\n  }\n  .cardhead h2{margin:0;font-size:21px;font-weight:600;letter-spacing:-.022em;}\n  .cardhead p{margin:3px 0 0;color:var(--ink-3);font-size:14.5px;max-width:62ch;}\n  .headtext{flex:1;min-width:0;}\n  .select{\n    display:inline-flex;align-items:center;gap:12px;\n    font-size:14.5px;color:var(--ink-2);padding:8px 12px;border-radius:var(--r-sm);\n    transition:background .25s var(--ease);\n    white-space:nowrap;\n  }\n  .select:hover{background:var(--surface-2);}\n  .select svg{color:var(--ink-3);}\n\n  .panel{background:var(--panel);border-radius:var(--r-md);padding:14px;}\n  .grid-a{display:grid;grid-template-columns:minmax(0,0.95fr) minmax(0,2.05fr);gap:14px;}\n  .stack{display:flex;flex-direction:column;gap:14px;}\n  .tile{\n    background:var(--surface);border:1px solid var(--line-soft);border-radius:10px;\n    padding:16px 18px;flex:1;display:flex;flex-direction:column;justify-content:center;gap:2px;\n  }\n  .tile{transition:border-color .3s var(--ease), box-shadow .3s var(--ease);}\n  .tile:hover{border-color:rgba(15,111,99,.28);box-shadow:0 10px 24px -18px rgba(29,20,44,.5);}\n  .tile .row{display:flex;align-items:baseline;justify-content:space-between;gap:12px;}\n  .tile .k{font-size:14.5px;color:var(--ink-2);}\n  .tile .v{font-size:20px;font-weight:600;letter-spacing:-.02em;font-variant-numeric:tabular-nums;}\n  .tile .sub{font-size:12.5px;color:var(--ink-3);}\n\n  .pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;}\n  .chartcard{\n    background:var(--surface);border:1px solid var(--line-soft);border-radius:10px;\n    padding:18px 20px 14px;display:flex;flex-direction:column;gap:2px;min-width:0;\n  }\n  .chartcard .t{font-size:14.5px;color:var(--ink-2);display:flex;align-items:center;gap:6px;}\n  .chartcard .n{font-size:30px;font-weight:600;letter-spacing:-.03em;line-height:1.25;font-variant-numeric:tabular-nums;}\n  .chartcard .delta{font-size:12.5px;color:var(--accent);font-weight:500;font-variant-numeric:tabular-nums;}\n  .chartcard .delta.down{color:var(--accent-2);}\n  .spark{height:74px;margin-top:10px;width:100%;}\n  .spark svg{width:100%;height:100%;display:block;}\n  .axis{display:flex;justify-content:space-between;font-size:12px;color:var(--ink-3);\n    padding-top:10px;margin-top:2px;border-top:1px solid var(--line-soft);letter-spacing:.01em;}\n\n  .viewbar{\n    margin-top:16px;display:flex;align-items:center;justify-content:center;gap:10px;\n    background:var(--surface-2);border:1px solid var(--line-soft);border-radius:10px;\n    padding:15px;font-size:15px;font-weight:500;color:var(--ink);width:100%;\n    transition:background .25s var(--ease), transform .25s var(--ease);\n  }\n  .viewbar:hover{background:var(--panel);}\n  .viewbar:active{transform:translateY(1px);}\n  .viewbar svg{color:var(--ink-2);}\n\n  /* section two */\n  .grid-b{display:grid;grid-template-columns:minmax(0,0.95fr) minmax(0,2.05fr);gap:14px;}\n  .breakdown{padding:6px 10px 0;display:flex;flex-direction:column;gap:12px;}\n  .breakdown h3{\n    margin:0;font-size:15.5px;font-weight:600;letter-spacing:-.01em;\n    display:flex;align-items:center;gap:7px;\n  }\n  .breakdown .period{font-size:15.5px;font-weight:600;letter-spacing:-.012em;line-height:1.4;margin:0;}\n  .rows{display:flex;flex-direction:column;gap:10px;margin-top:2px;}\n  .rowcard{\n    background:var(--surface-2);border:1px solid var(--line-soft);border-radius:10px;\n    padding:14px 16px;display:flex;align-items:center;justify-content:space-between;gap:14px;\n  }\n  .rowcard .lab{font-size:14.5px;color:var(--ink-2);}\n  .rowcard .vals{text-align:right;font-size:14.5px;color:var(--ink-2);display:flex;flex-direction:column;gap:3px;}\n  .rowcard .vals b{color:var(--ink);font-weight:600;font-variant-numeric:tabular-nums;}\n\n  .emptyart{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;flex:1;padding:12px 0 4px;}\n  .emptyart p{margin:0;text-align:center;color:var(--ink-2);font-size:14.5px;max-width:30ch;line-height:1.5;}\n  .donutwrap{display:flex;align-items:center;justify-content:center;flex:1;padding:8px 0;}\n  .info{color:var(--ink-3);display:inline-flex;}\n\n  .footnote{\n    display:flex;align-items:center;justify-content:space-between;gap:16px;\n    color:var(--ink-3);font-size:12.5px;padding:0 4px;\n  }\n\n  @media (max-width:1180px){\n    .main{padding:26px 32px 48px;}\n    .grid-a,.grid-b{grid-template-columns:minmax(0,1fr);}\n  }\n  @media (max-width:860px){\n    .shell{flex-direction:column;}\n    .sidebar{width:100%;flex:1 1 auto;height:auto;position:static;border-right:0;border-bottom:1px solid var(--line);}\n    .pair{grid-template-columns:minmax(0,1fr);}\n  }\n</style>\n\n<div class=\"shell\">\n\n  <!-- ================= sidebar ================= -->\n  <aside class=\"sidebar\">\n    <div class=\"brandrow\">\n      <div class=\"wordmark\">marlow<span>.</span></div>\n      <div class=\"avatar\" title=\"Renata Ashford\">\n        <img src=\"https://images.pexels.com/photos/20051635/pexels-photo-20051635.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=200\" alt=\"Renata Ashford, workspace owner — photo by Thanh Xuan Nguyen Ly on Pexels\" width=\"28\" height=\"28\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n      </div>\n      <button class=\"iconbtn\" aria-label=\"Notifications\">\n        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 8a6 6 0 1 0-12 0c0 6-2 7-2 7h16s-2-1-2-7\"/><path d=\"M13.7 20a2 2 0 0 1-3.4 0\"/></svg>\n        <span class=\"dot\"></span>\n      </button>\n      <button class=\"iconbtn\" aria-label=\"Search\">\n        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.2-3.2\"/></svg>\n      </button>\n    </div>\n\n    <div class=\"orgrow\">\n      <div class=\"orgmark\">\n        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"9\" cy=\"8\" r=\"3\"/><path d=\"M3.5 19a5.5 5.5 0 0 1 11 0\"/><circle cx=\"17\" cy=\"9.5\" r=\"2.2\"/><path d=\"M15 19a4.6 4.6 0 0 1 6-4.3\"/></svg>\n      </div>\n      <div class=\"orgtext\">\n        <div class=\"small\">RA Workspace</div>\n        <div class=\"big\">Renata's Group</div>\n      </div>\n      <button class=\"iconbtn\" aria-label=\"Workspace options\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><circle cx=\"12\" cy=\"5\" r=\"1.6\"/><circle cx=\"12\" cy=\"12\" r=\"1.6\"/><circle cx=\"12\" cy=\"19\" r=\"1.6\"/></svg>\n      </button>\n    </div>\n\n    <div class=\"rule\"></div>\n\n    <nav class=\"nav\">\n      <div class=\"navgroup\">\n        <div class=\"navlabel\">Group</div>\n        <a class=\"navitem\" href=\"#\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 10.5 12 4l8 6.5\"/><path d=\"M6 10v9h12v-9\"/><path d=\"M10 19v-5h4v5\"/></svg>\n          Home\n        </a>\n        <a class=\"navitem\" href=\"#\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"8\" cy=\"9\" r=\"2.6\"/><path d=\"M3 18a5 5 0 0 1 10 0\"/><circle cx=\"16.5\" cy=\"10\" r=\"2\"/><path d=\"M14.5 18a4.2 4.2 0 0 1 6.5-3.6\"/></svg>\n          People\n        </a>\n        <a class=\"navitem\" href=\"#\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"8.4\"/><path d=\"M12 8.6v6.8M8.6 12h6.8\"/></svg>\n          Add people\n        </a>\n        <a class=\"navitem\" href=\"#\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"7\" cy=\"8\" r=\"2.4\"/><path d=\"M3.5 16.5a3.8 3.8 0 0 1 7 0\"/><path d=\"M14 8.5h6.5M14 12h6.5M14 15.5h4\"/></svg>\n          Tracker\n        </a>\n        <a class=\"navitem active\" href=\"#\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><path d=\"M5 19V11\"/><path d=\"M12 19V5\"/><path d=\"M19 19v-6\"/></svg>\n          Analytics\n        </a>\n        <a class=\"navitem\" href=\"#\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 3.5h8l4 4v13H6z\"/><path d=\"M14 3.5v4h4\"/><path d=\"M9 13h6M9 16.5h4\"/></svg>\n          Documents\n        </a>\n        <a class=\"navitem\" href=\"#\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3.2 19 6v5.5c0 4.2-2.9 7.4-7 9.3-4.1-1.9-7-5.1-7-9.3V6z\"/><path d=\"m9.2 12 2 2 3.6-4\"/></svg>\n          Compliance <span class=\"tag\">New</span>\n        </a>\n        <a class=\"navitem\" href=\"#\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"5.5\" width=\"18\" height=\"13\" rx=\"2.4\"/><path d=\"M3 10h18\"/><path d=\"M6.5 14.5h3\"/></svg>\n          Payments\n        </a>\n        <a class=\"navitem\" href=\"#\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"8.5\" cy=\"8.5\" r=\"2.6\"/><path d=\"M3.6 17.5a5 5 0 0 1 9.8 0\"/><circle cx=\"17.6\" cy=\"15.4\" r=\"2.4\"/><path d=\"M17.6 11.6v1M17.6 19.2v1M14.3 13.5l.9.5M20 17.3l.9.5M14.3 19.3l.9-.5M20 15.5l.9-.5\"/></svg>\n          Group Settings\n        </a>\n      </div>\n\n      <div class=\"navgroup\">\n        <div class=\"navlabel\">Organization</div>\n        <a class=\"navitem\" href=\"#\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10 4.5h4v2.2a1.8 1.8 0 1 0 3.6 0V9h2.2v4h-2.2a1.8 1.8 0 1 0 0 3.6h2.2v2.9H14v-2.2a1.8 1.8 0 1 0-3.6 0v2.2H4.2v-4h2.2a1.8 1.8 0 1 0 0-3.6H4.2V9h6.2z\"/></svg>\n          App Store\n        </a>\n        <a class=\"navitem\" href=\"#\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"4\" y=\"4\" width=\"6.4\" height=\"6.4\" rx=\"1.6\"/><rect x=\"13.6\" y=\"4\" width=\"6.4\" height=\"6.4\" rx=\"1.6\"/><rect x=\"4\" y=\"13.6\" width=\"6.4\" height=\"6.4\" rx=\"1.6\"/><rect x=\"13.6\" y=\"13.6\" width=\"6.4\" height=\"6.4\" rx=\"1.6\"/></svg>\n          Services\n        </a>\n        <a class=\"navitem\" href=\"#\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5.5 3.6h13v16.8l-2.2-1.4-2.2 1.4-2.1-1.4-2.2 1.4-2.2-1.4-2.1 1.4z\"/><path d=\"M9 8.5h6M9 12h6\"/></svg>\n          Expenses\n        </a>\n        <a class=\"navitem\" href=\"#\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"8.4\"/><path d=\"M14.4 9.2a2.6 2.6 0 0 0-2.4-1.4c-1.4 0-2.4.8-2.4 1.9 0 2.6 5 1.5 5 4.2 0 1.2-1.1 2.1-2.6 2.1a2.8 2.8 0 0 1-2.6-1.5\"/><path d=\"M12 6.2v1.6M12 16v1.8\"/></svg>\n          Global Payroll <span class=\"tag\">New</span>\n        </a>\n        <a class=\"navitem\" href=\"#\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3.1\"/><path d=\"M12 3.4v2.2M12 18.4v2.2M20.6 12h-2.2M5.6 12H3.4M18 6l-1.6 1.6M7.6 16.4 6 18M18 18l-1.6-1.6M7.6 7.6 6 6\"/></svg>\n          Organization Settings\n        </a>\n      </div>\n    </nav>\n\n    <div class=\"navfoot\">\n      <div class=\"rule\"></div>\n      <a class=\"navitem\" href=\"#\">\n        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3.2c3.4 2 5.2 5.4 5.2 9.1l-2.4 2.5H9.2L6.8 12.3c0-3.7 1.8-7.1 5.2-9.1Z\"/><circle cx=\"12\" cy=\"10.4\" r=\"1.7\"/><path d=\"M9.6 16.4c-.9 1.2-1 2.6-.8 4 1.4-.2 2.7-.6 3.6-1.7M14.4 16.4c.9 1.2 1 2.6.8 4-1.3-.2-2.5-.6-3.4-1.6\"/></svg>\n        Start onboarding <span class=\"tag\">New</span>\n      </a>\n    </div>\n  </aside>\n\n  <!-- ================= main ================= -->\n  <main class=\"main\">\n    <div class=\"pagehead\">\n      <div>\n        <h1>Workforce analytics</h1>\n        <p>Updated 14 minutes ago · 312 people across 14 countries</p>\n      </div>\n      <button class=\"select\">\n        All entities\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"/></svg>\n      </button>\n    </div>\n\n    <!-- ---- section 1 ---- -->\n    <section class=\"card\">\n      <div class=\"cardhead\">\n        <div class=\"cardmark\">\n          <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 19.5V13\"/><path d=\"M9.5 19.5V7.5\"/><path d=\"M15 19.5v-8\"/><path d=\"M20.5 19.5V4.5\"/></svg>\n        </div>\n        <div class=\"headtext\">\n          <h2>Headcount and movement</h2>\n          <p>How your team grew, moved and exited over the selected window</p>\n        </div>\n        <button class=\"select\">\n          Last 12 months\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"/></svg>\n        </button>\n      </div>\n\n      <div class=\"panel\">\n        <div class=\"grid-a\">\n          <div class=\"stack\">\n            <div class=\"tile\">\n              <div class=\"row\"><span class=\"k\">Open roles</span><span class=\"v\">7</span></div>\n              <span class=\"sub\">3 at offer stage</span>\n            </div>\n            <div class=\"tile\">\n              <div class=\"row\"><span class=\"k\">Pending approvals</span><span class=\"v\">2</span></div>\n              <span class=\"sub\">Oldest waiting 4 days</span>\n            </div>\n            <div class=\"tile\">\n              <div class=\"row\"><span class=\"k\">Contracts to sign</span><span class=\"v\">5</span></div>\n              <span class=\"sub\">Across 3 entities</span>\n            </div>\n          </div>\n\n          <div class=\"pair\">\n            <div class=\"chartcard\">\n              <div class=\"t\">Total headcount</div>\n              <div class=\"n\">312</div>\n              <div class=\"delta\">+41 since last May</div>\n              <div class=\"spark\">\n                <svg viewBox=\"0 0 320 74\" preserveAspectRatio=\"none\" role=\"img\" aria-label=\"Headcount trending up over twelve months\">\n                  <path d=\"M4 58 L30 55 L57 52 L84 47 L111 46 L138 41 L165 36 L192 34 L219 27 L246 24 L273 17 L300 12\"\n                        fill=\"none\" stroke=\"var(--accent)\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" vector-effect=\"non-scaling-stroke\"/>\n                  <circle cx=\"300\" cy=\"12\" r=\"3.6\" fill=\"var(--accent)\"/>\n                </svg>\n              </div>\n              <div class=\"axis\"><span>May</span><span>Jul</span><span>Sep</span><span>Nov</span><span>Jan</span><span>Apr</span></div>\n            </div>\n\n            <div class=\"chartcard\">\n              <div class=\"t\">Voluntary attrition</div>\n              <div class=\"n\">6.4%</div>\n              <div class=\"delta down\">+1.2 pts since last May</div>\n              <div class=\"spark\">\n                <svg viewBox=\"0 0 320 74\" preserveAspectRatio=\"none\" role=\"img\" aria-label=\"Attrition rate over twelve months\">\n                  <path d=\"M4 46 L30 49 L57 43 L84 45 L111 38 L138 41 L165 33 L192 36 L219 28 L246 31 L273 24 L300 20\"\n                        fill=\"none\" stroke=\"var(--accent-2)\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" vector-effect=\"non-scaling-stroke\"/>\n                  <circle cx=\"300\" cy=\"20\" r=\"3.6\" fill=\"var(--accent-2)\"/>\n                </svg>\n              </div>\n              <div class=\"axis\"><span>May</span><span>Jul</span><span>Sep</span><span>Nov</span><span>Jan</span><span>Apr</span></div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <button class=\"viewbar\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"4\" y=\"4\" width=\"6.4\" height=\"6.4\" rx=\"1.5\"/><rect x=\"13.6\" y=\"4\" width=\"6.4\" height=\"6.4\" rx=\"1.5\"/><rect x=\"4\" y=\"13.6\" width=\"6.4\" height=\"6.4\" rx=\"1.5\"/><rect x=\"13.6\" y=\"13.6\" width=\"6.4\" height=\"6.4\" rx=\"1.5\"/></svg>\n        View dashboard\n      </button>\n    </section>\n\n    <!-- ---- section 2 ---- -->\n    <section class=\"card\">\n      <div class=\"cardhead\">\n        <div class=\"cardmark\">\n          <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"8.6\" cy=\"9\" r=\"2.6\"/><path d=\"M3.4 18.4a5.3 5.3 0 0 1 10.4 0\"/><circle cx=\"16.8\" cy=\"10.2\" r=\"2.1\"/><path d=\"M14.6 18.4a4.4 4.4 0 0 1 6.2-4.1\"/></svg>\n        </div>\n        <div class=\"headtext\">\n          <h2>Representation and pay equity</h2>\n          <p>Collected signals on how your organisation is composed and compensated</p>\n        </div>\n        <button class=\"select\">\n          Last 12 months\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"/></svg>\n        </button>\n      </div>\n\n      <div class=\"panel\">\n        <div class=\"grid-b\">\n          <div class=\"breakdown\">\n            <h3>\n              Representation by headcount\n              <span class=\"info\" title=\"Self-reported fields only\">\n                <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"8.6\"/><path d=\"M12 11v5.4\"/><path d=\"M12 7.9h.01\"/></svg>\n              </span>\n            </h3>\n            <p class=\"period\">May 1st 2024 – April 30th 2025 · All countries</p>\n            <div class=\"rows\">\n              <div class=\"rowcard\">\n                <span class=\"lab\">Age</span>\n                <span class=\"vals\">\n                  <span>Undisclosed · <b>61.4%</b></span>\n                  <span>Under 30 · <b>38.6%</b></span>\n                </span>\n              </div>\n              <div class=\"rowcard\">\n                <span class=\"lab\">Gender</span>\n                <span class=\"vals\"><span>Not specified · <b>82.7%</b></span></span>\n              </div>\n              <div class=\"rowcard\">\n                <span class=\"lab\">Ethnicity</span>\n                <span class=\"vals\"><span>Not specified · <b>74.1%</b></span></span>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"pair\">\n            <div class=\"chartcard\">\n              <div class=\"t\">\n                Median pay by gender\n                <span class=\"info\" title=\"Requires at least 5 self-reported records per group\">\n                  <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"8.6\"/><path d=\"M12 11v5.4\"/><path d=\"M12 7.9h.01\"/></svg>\n                </span>\n              </div>\n              <div class=\"emptyart\">\n                <svg width=\"196\" height=\"150\" viewBox=\"0 0 196 150\" role=\"img\" aria-label=\"Illustration of a moth tracing a dotted path around a soft shape\">\n                  <path d=\"M64 42c26-16 62-12 74 10 12 22 4 52-18 62-22 10-58 8-70-12-12-20-12-44 14-60Z\" fill=\"var(--accent-soft)\"/>\n                  <path d=\"M62 42c16 16 27 33 30 50 3 17-3 30-15 39\" fill=\"none\" stroke=\"var(--ink-3)\" stroke-width=\"1.2\" stroke-dasharray=\"2.5 6\" stroke-linecap=\"round\" opacity=\".75\"/>\n                  <ellipse cx=\"107\" cy=\"88\" rx=\"31\" ry=\"18\" fill=\"none\" stroke=\"var(--ink-3)\" stroke-width=\"1.2\" stroke-dasharray=\"2.5 6\" stroke-linecap=\"round\" opacity=\".75\"/>\n                  <g transform=\"translate(58 34) rotate(-16)\">\n                    <path d=\"M-1 2C-5-8-14-12-18-8s-1 13 8 15c4 1 7 0 9-2Z\" fill=\"var(--accent-2)\" opacity=\".85\"/>\n                    <path d=\"M1 2C5-9 14-13 18-9s1 13-8 15c-4 1-7 0-9-2Z\" fill=\"var(--accent-2)\" opacity=\".55\"/>\n                    <path d=\"M-3.5 8.5c1-1.5 6-1.5 7 0 1 1.6-.4 4.2-3.5 4.2S-4.5 10.1-3.5 8.5Z\" fill=\"var(--accent-2)\" opacity=\".7\"/>\n                    <ellipse cx=\"0\" cy=\"4.6\" rx=\"1.9\" ry=\"5.4\" fill=\"var(--ink)\"/>\n                    <path d=\"M-1 -.6C-2.4-3.2-4.4-4.6-6.6-5M1 -.6C2.4-3.2 4.4-4.6 6.6-5\" fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"1\" stroke-linecap=\"round\"/>\n                  </g>\n                </svg>\n                <p>Not enough self-reported records to publish a pay split</p>\n              </div>\n            </div>\n\n            <div class=\"chartcard\">\n              <div class=\"t\">\n                Headcount by ethnicity\n                <span class=\"info\" title=\"Groups with fewer than 3 people are merged\">\n                  <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"8.6\"/><path d=\"M12 11v5.4\"/><path d=\"M12 7.9h.01\"/></svg>\n                </span>\n              </div>\n              <div class=\"n\">7</div>\n              <div class=\"donutwrap\">\n                <svg width=\"168\" height=\"168\" viewBox=\"0 0 168 168\" role=\"img\" aria-label=\"Donut chart of reported ethnicity groups\">\n                  <circle cx=\"84\" cy=\"84\" r=\"58\" fill=\"none\" stroke=\"var(--surface-2)\" stroke-width=\"27\"/>\n                  <circle cx=\"84\" cy=\"84\" r=\"58\" fill=\"none\" stroke=\"var(--accent)\" stroke-width=\"27\"\n                          stroke-dasharray=\"204 160\" stroke-dashoffset=\"0\" transform=\"rotate(-90 84 84)\" stroke-linecap=\"butt\"/>\n                  <circle cx=\"84\" cy=\"84\" r=\"58\" fill=\"none\" stroke=\"var(--accent-2)\" stroke-width=\"27\"\n                          stroke-dasharray=\"86 278\" stroke-dashoffset=\"-208\" transform=\"rotate(-90 84 84)\" stroke-linecap=\"butt\"/>\n                </svg>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <button class=\"viewbar\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"4\" y=\"4\" width=\"6.4\" height=\"6.4\" rx=\"1.5\"/><rect x=\"13.6\" y=\"4\" width=\"6.4\" height=\"6.4\" rx=\"1.5\"/><rect x=\"4\" y=\"13.6\" width=\"6.4\" height=\"6.4\" rx=\"1.5\"/><rect x=\"13.6\" y=\"13.6\" width=\"6.4\" height=\"6.4\" rx=\"1.5\"/></svg>\n        View dashboard\n      </button>\n    </section>\n\n    <div class=\"footnote\">\n      <span>Figures refresh every 6 hours. Self-reported fields stay anonymous below 5 records.</span>\n      <span>Data residency: EU · GDPR aligned</span>\n    </div>\n  </main>\n</div>\n",
