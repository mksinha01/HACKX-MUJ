# ========================================
# Production Environment Configuration
# ========================================
# Copy this file to '.env' before running:
# docker compose -f docker-compose.prod.yml up -d
# ========================================

# ── Database Credentials ──
POSTGRES_USER=fmp_prod_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=fmp_prod_db

# ── Backend Security Keys ──
# Generate a strong key for production (e.g. openssl rand -hex 32)
ADMIN_ENROLLMENT_KEY=your_secure_admin_enrollment_key
RTSP_SECRET_KEY=your_secure_rtsp_secret_key_32_bytes_long

# ── Web App / Frontend Configuration (Optional) ──
# For the frontend build, VITE_API_BASE_URL is passed via Docker args,
# but if you need to configure Firebase in production, you can inject them.
# In the current Dockerfile, environment variables during build need to be
# passed explicitly in docker-compose.prod.yml `args` section if needed.
